{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "~/*": ["./src/*"],
      "$config": ["./site.config.ts"],
      "$i18n/*": ["./src/i18n/*"],
      "$components/*": ["./src/components/*"],
      "$layouts/*": ["./src/layouts/*"],
      "$styles/*": ["./src/styles/*"],
      "$lib/*": ["./src/lib/*"]
    },
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  },
  "include": ["src/**/*", "site.config.ts"],
  "exclude": ["node_modules", "dist"]
}
