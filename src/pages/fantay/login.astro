---
/**
 * 管理后台登录页
 * /fantay/login
 */
// 字体自托管（替代 loli.net 镜像；LXGW WenKai 在 Google Fonts 镜像上本就不存在）
import "lxgw-wenkai-webfont/lxgwwenkai-light.css";
import "lxgw-wenkai-webfont/lxgwwenkai-regular.css";
import "lxgw-wenkai-webfont/lxgwwenkai-bold.css";
import "@fontsource/noto-serif-sc/300.css";
import "@fontsource/noto-serif-sc/400.css";
import "@fontsource/noto-serif-sc/500.css";
export const prerender = false;
---

<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Sonnet Admin</title>
  <style is:global>
    /* ===== 禅意配色 - 明亮暖纸风格，与主站浅色模式一致 ===== */
    :root {
      --bg: #FAF7F0;
      --bg-elevated: #FFFFFF;
      --bg-subtle: #F4F1E8;
      --fg: #2C2C2A;
      --fg-muted: #5A5A58;
      --fg-subtle: #8C8A82;
      --gold: #A98C42;
      --gold-light: #C4A962;
      --bamboo: #7B9E87;
      --border: #E3DECF;
      --border-subtle: #EEEAE0;
      --danger: #A04040;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: "LXGW WenKai", "Noto Serif SC", "Kaiti SC", "STKaiti", "楷体", serif;
      background: var(--bg);
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--fg);
      overflow: hidden;
      position: relative;
    }

    /* ===== 背景氛围 - 呼吸光晕 ===== */
    .glow {
      position: fixed;
      border-radius: 50%;
      filter: blur(90px);
      pointer-events: none;
      opacity: 0;
      animation: glow-breathe 8s ease-in-out infinite;
    }

    .glow-gold {
      width: 420px;
      height: 280px;
      top: 18%;
      left: 14%;
      background: radial-gradient(ellipse at center, rgba(196, 169, 98, 0.22), transparent 70%);
    }

    .glow-bamboo {
      width: 380px;
      height: 260px;
      bottom: 12%;
      right: 10%;
      background: radial-gradient(ellipse at center, rgba(123, 158, 135, 0.2), transparent 70%);
      animation-delay: 3s;
    }

    @keyframes glow-breathe {
      0%, 100% { opacity: 0.5; transform: scale(1); }
      50% { opacity: 1; transform: scale(1.12); }
    }

    /* 漂浮墨点 */
    .ink-dot {
      position: fixed;
      border-radius: 50%;
      background: var(--gold);
      opacity: 0;
      pointer-events: none;
      animation: dot-drift var(--duration) ease-in-out infinite;
      animation-delay: var(--delay);
    }

    @keyframes dot-drift {
      0%, 100% { opacity: 0; transform: translate(0, 0); }
      30% { opacity: 0.15; }
      50% { opacity: 0.22; transform: translate(-14px, -22px); }
      70% { opacity: 0.1; }
    }

    /* ===== 登录卡片 ===== */
    .login-container {
      position: relative;
      z-index: 1;
      background: rgba(255, 255, 255, 0.88);
      backdrop-filter: blur(16px);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 3rem 2.75rem 2.5rem;
      width: 100%;
      max-width: 400px;
      margin: 1rem;
      box-shadow: 0 24px 56px -20px rgba(44, 44, 42, 0.22);
      animation: card-emerge 0.9s cubic-bezier(0.23, 1, 0.32, 1) both;
    }

    @keyframes card-emerge {
      from { opacity: 0; transform: translateY(18px) scale(0.985); }
      to { opacity: 1; transform: translateY(0) scale(1); }
    }

    /* 顶部金线装饰 */
    .login-container::before {
      content: '';
      position: absolute;
      top: 0;
      left: 50%;
      transform: translateX(-50%);
      width: 56%;
      height: 1px;
      background: linear-gradient(90deg, transparent, rgba(196, 169, 98, 0.55), transparent);
    }

    .logo {
      text-align: center;
      margin-bottom: 2.25rem;
    }

    .logo h1 {
      font-size: 1.75rem;
      font-weight: 300;
      letter-spacing: 0.45em;
      text-indent: 0.45em;
      color: var(--fg);
    }

    .logo-ornament {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.75rem;
      margin-top: 0.875rem;
    }

    .logo-ornament .line {
      width: 36px;
      height: 1px;
      background: linear-gradient(90deg, transparent, rgba(196, 169, 98, 0.5));
    }

    .logo-ornament .line.right {
      background: linear-gradient(90deg, rgba(196, 169, 98, 0.5), transparent);
    }

    .logo-ornament .dot {
      width: 4px;
      height: 4px;
      border-radius: 50%;
      background: var(--gold);
      opacity: 0.7;
    }

    .logo p {
      font-size: 0.8125rem;
      letter-spacing: 0.3em;
      text-indent: 0.3em;
      color: var(--fg-subtle);
      margin-top: 0.875rem;
    }

    .form-group {
      margin-bottom: 1.375rem;
    }

    .form-group label {
      display: block;
      font-size: 0.75rem;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--fg-subtle);
      margin-bottom: 0.5rem;
    }

    .form-group input {
      width: 100%;
      padding: 0.875rem 1rem;
      background: var(--bg-elevated);
      border: 1px solid var(--border);
      border-radius: 8px;
      color: var(--fg);
      font-size: 0.9375rem;
      font-family: inherit;
      transition: border-color 0.3s ease, box-shadow 0.3s ease;
    }

    .form-group input:focus {
      outline: none;
      border-color: var(--gold);
      box-shadow: 0 0 0 3px rgba(196, 169, 98, 0.12);
    }

    .form-group input::placeholder {
      color: var(--fg-subtle);
      opacity: 0.7;
    }

    .submit-btn {
      width: 100%;
      padding: 0.9375rem;
      margin-top: 0.375rem;
      background: linear-gradient(135deg, var(--gold) 0%, var(--gold-light) 100%);
      border: none;
      border-radius: 8px;
      color: #2C2418;
      font-size: 0.9375rem;
      font-weight: 500;
      font-family: inherit;
      letter-spacing: 0.2em;
      text-indent: 0.2em;
      cursor: pointer;
      transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.3s ease, opacity 0.3s ease;
      box-shadow: 0 2px 10px rgba(196, 169, 98, 0.25);
    }

    .submit-btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 20px rgba(196, 169, 98, 0.3);
    }

    .submit-btn:active {
      transform: translateY(0);
    }

    .submit-btn:disabled {
      opacity: 0.55;
      cursor: not-allowed;
      transform: none;
      box-shadow: none;
    }

    .error-message {
      background: rgba(160, 64, 64, 0.08);
      border: 1px solid rgba(160, 64, 64, 0.25);
      border-left: 2px solid var(--danger);
      color: var(--danger);
      padding: 0.75rem 1rem;
      border-radius: 8px;
      margin-bottom: 1.5rem;
      font-size: 0.875rem;
      line-height: 1.5;
      display: none;
    }

    .error-message.show {
      display: block;
      animation: error-shake 0.4s ease;
    }

    @keyframes error-shake {
      0%, 100% { transform: translateX(0); }
      25% { transform: translateX(-5px); }
      75% { transform: translateX(5px); }
    }

    .setup-notice {
      text-align: center;
      margin-top: 1.5rem;
      font-size: 0.75rem;
      letter-spacing: 0.05em;
      color: var(--fg-subtle);
    }

    .back-link {
      display: block;
      text-align: center;
      margin-top: 1.75rem;
      font-size: 0.75rem;
      letter-spacing: 0.1em;
      color: var(--fg-subtle);
      text-decoration: none;
      transition: color 0.3s ease;
    }

    .back-link:hover {
      color: var(--gold);
    }

    @media (prefers-reduced-motion: reduce) {
      .glow, .ink-dot, .login-container { animation: none; }
      .glow { opacity: 0.6; }
    }
  </style>
</head>
<body>
  <!-- 背景氛围 -->
  <div class="glow glow-gold" aria-hidden="true"></div>
  <div class="glow glow-bamboo" aria-hidden="true"></div>
  <div class="ink-dot" style="top: 24%; left: 70%; width: 3px; height: 3px; --duration: 14s; --delay: 0s;" aria-hidden="true"></div>
  <div class="ink-dot" style="top: 65%; left: 22%; width: 2px; height: 2px; --duration: 18s; --delay: 4s;" aria-hidden="true"></div>
  <div class="ink-dot" style="top: 40%; left: 85%; width: 2.5px; height: 2.5px; --duration: 16s; --delay: 8s;" aria-hidden="true"></div>

  <div class="login-container">
    <div class="logo">
      <h1>SONNET</h1>
      <div class="logo-ornament" aria-hidden="true">
        <span class="line"></span>
        <span class="dot"></span>
        <span class="line right"></span>
      </div>
      <p>十四行 · 管理后台</p>
    </div>

    <div id="error" class="error-message"></div>

    <form id="loginForm">
      <div class="form-group">
        <label for="username">Username</label>
        <input type="text" id="username" name="username" placeholder="Enter username" autocomplete="username" required />
      </div>

      <div class="form-group">
        <label for="password">Password</label>
        <input type="password" id="password" name="password" placeholder="Enter password" autocomplete="current-password" required />
      </div>

      <button type="submit" class="submit-btn" id="submitBtn">
        Sign In
      </button>
    </form>

    <p class="setup-notice" id="setupNotice" style="display: none;">
      First time? This will create your admin account.
    </p>

    <a href="/" class="back-link">← 返回博客</a>
  </div>

  <script>
    const form = document.getElementById('loginForm');
    const errorEl = document.getElementById('error');
    const submitBtn = document.getElementById('submitBtn');
    const setupNotice = document.getElementById('setupNotice');

    // 检查是否已有管理员
    fetch('/api/fantay/check-setup')
      .then(r => r.json())
      .then(data => {
        if (!data.hasAdmin) {
          setupNotice.style.display = 'block';
          submitBtn.textContent = 'Create Account & Sign In';
        }
      })
      .catch(() => {});

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const username = document.getElementById('username').value;
      const password = document.getElementById('password').value;

      submitBtn.disabled = true;
      submitBtn.textContent = 'Signing in...';
      errorEl.classList.remove('show');

      try {
        const res = await fetch('/api/fantay/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ username, password }),
        });

        const data = await res.json();

        if (data.success) {
          // 存储 token 并跳转
          localStorage.setItem('auth_token', data.token);
          window.location.href = '/fantay';
        } else {
          errorEl.textContent = data.error || 'Login failed';
          errorEl.classList.add('show');
        }
      } catch (err) {
        errorEl.textContent = 'Network error. Please try again.';
        errorEl.classList.add('show');
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = setupNotice.style.display === 'block'
          ? 'Create Account & Sign In'
          : 'Sign In';
      }
    });
  </script>
</body>
</html>
