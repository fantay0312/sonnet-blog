---
/**
 * 管理后台主页
 * /fantay
 */
// 字体自托管（替代 loli.net 镜像；LXGW WenKai 在 Google Fonts 镜像上本就不存在）
import "lxgw-wenkai-webfont/lxgwwenkai-light.css";
import "lxgw-wenkai-webfont/lxgwwenkai-regular.css";
import "lxgw-wenkai-webfont/lxgwwenkai-bold.css";
import "@fontsource/noto-serif-sc/300.css";
import "@fontsource/noto-serif-sc/400.css";
import "@fontsource/noto-serif-sc/500.css";
export const prerender = false;
---

<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Sonnet Admin Dashboard</title>
  <script is:inline src="/vendor/iconify.min.js"></script>
  <style is:global>
    /* ===== 禅意配色 - 明亮暖纸风格，与主站浅色模式一致 ===== */
    :root {
      --bg: #FAF7F0;
      --bg-elevated: #FFFFFF;
      --bg-subtle: #F4F1E8;
      --fg: #2C2C2A;
      --fg-muted: #5A5A58;
      --fg-subtle: #8C8A82;
      --gold: #A98C42;
      --gold-light: #C4A962;
      --bamboo: #7B9E87;
      --border: #E3DECF;
      --border-subtle: #EEEAE0;
      --danger: #A04040;
      --danger-deep: #8A3232;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: "LXGW WenKai", "Noto Serif SC", "Kaiti SC", "STKaiti", "楷体", serif;
      background: var(--bg);
      min-height: 100vh;
      color: var(--fg);
    }

    /* 顶部金线 */
    body::before {
      content: '';
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      height: 2px;
      background: linear-gradient(90deg, transparent, rgba(169, 140, 66, 0.45), transparent);
      z-index: 10;
      pointer-events: none;
    }

    /* 背景氛围光晕 */
    .bg-glow {
      position: fixed;
      border-radius: 50%;
      filter: blur(100px);
      pointer-events: none;
      z-index: 0;
    }

    .bg-glow.gold {
      width: 480px;
      height: 300px;
      top: -80px;
      right: -100px;
      background: radial-gradient(ellipse at center, rgba(196, 169, 98, 0.07), transparent 70%);
    }

    .bg-glow.bamboo {
      width: 420px;
      height: 280px;
      bottom: -60px;
      left: -120px;
      background: radial-gradient(ellipse at center, rgba(90, 122, 99, 0.06), transparent 70%);
    }

    .container {
      position: relative;
      z-index: 1;
      max-width: 960px;
      margin: 0 auto;
      padding: 2.5rem 2rem 4rem;
    }

    /* ===== 头部 ===== */
    header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 2rem;
      padding-bottom: 1.5rem;
      border-bottom: 1px solid var(--border);
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 0.875rem;
    }

    /* 金印 */
    .seal {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 38px;
      height: 38px;
      border: 1px solid rgba(196, 169, 98, 0.6);
      border-radius: 8px;
      color: var(--gold);
      font-size: 1.25rem;
      background: rgba(196, 169, 98, 0.06);
      box-shadow: inset 0 0 12px rgba(196, 169, 98, 0.08);
      user-select: none;
    }

    .logo {
      font-size: 1.375rem;
      font-weight: 400;
      letter-spacing: 0.18em;
      color: var(--fg);
      line-height: 1.2;
    }

    .logo-sub {
      font-size: 0.6875rem;
      letter-spacing: 0.25em;
      color: var(--fg-subtle);
      margin-top: 0.125rem;
    }

    .header-actions {
      display: flex;
      align-items: center;
      gap: 0.625rem;
    }

    .ghost-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.375rem;
      padding: 0.5rem 1rem;
      background: transparent;
      border: 1px solid var(--border);
      border-radius: 6px;
      color: var(--fg-subtle);
      cursor: pointer;
      font-family: inherit;
      font-size: 0.8125rem;
      text-decoration: none;
      transition: all 0.3s ease;
    }

    .ghost-btn:hover {
      border-color: var(--gold);
      color: var(--gold);
    }

    .ghost-btn.danger:hover {
      border-color: var(--danger-deep);
      color: var(--danger);
    }

    /* ===== 统计概览 ===== */
    .stats {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1rem;
      margin-bottom: 2rem;
    }

    .stat-card {
      display: flex;
      align-items: center;
      gap: 1rem;
      padding: 1.125rem 1.375rem;
      background: var(--bg-elevated);
      border: 1px solid var(--border-subtle);
      border-radius: 10px;
      transition: border-color 0.3s ease, transform 0.3s ease;
    }

    .stat-card:hover {
      border-color: var(--border);
      transform: translateY(-2px);
      box-shadow: 0 6px 16px rgba(44, 44, 42, 0.06);
    }

    .stat-icon {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 40px;
      height: 40px;
      border-radius: 10px;
      background: rgba(196, 169, 98, 0.08);
      color: var(--gold);
      font-size: 1.25rem;
      flex-shrink: 0;
    }

    .stat-value {
      font-size: 1.5rem;
      line-height: 1.2;
      color: var(--fg);
      font-variant-numeric: tabular-nums;
    }

    .stat-label {
      font-size: 0.75rem;
      letter-spacing: 0.1em;
      color: var(--fg-subtle);
      margin-top: 0.125rem;
    }

    /* ===== 导航标签 ===== */
    .tabs {
      display: flex;
      gap: 1.75rem;
      margin-bottom: 2rem;
      border-bottom: 1px solid var(--border-subtle);
    }

    .tab {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.75rem 0.125rem;
      background: transparent;
      border: none;
      border-bottom: 2px solid transparent;
      color: var(--fg-subtle);
      cursor: pointer;
      font-family: inherit;
      font-size: 0.9375rem;
      letter-spacing: 0.08em;
      margin-bottom: -1px;
      transition: all 0.3s ease;
      white-space: nowrap;
    }

    .tab .tab-icon {
      font-size: 1rem;
      opacity: 0.7;
      transition: opacity 0.3s ease;
    }

    .tab:hover {
      color: var(--fg-muted);
    }

    .tab.active {
      color: var(--fg);
      border-bottom-color: var(--gold);
    }

    .tab.active .tab-icon {
      color: var(--gold);
      opacity: 1;
    }

    /* ===== 面板 ===== */
    .panel {
      display: none;
      background: var(--bg-elevated);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 2rem;
      animation: panel-in 0.35s cubic-bezier(0.23, 1, 0.32, 1);
    }

    @keyframes panel-in {
      from { opacity: 0; transform: translateY(8px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .panel.active {
      display: block;
    }

    .panel {
      box-shadow: 0 2px 12px rgba(44, 44, 42, 0.04);
    }

    .panel h2 {
      display: flex;
      align-items: center;
      gap: 0.625rem;
      font-size: 1.125rem;
      font-weight: 400;
      margin-bottom: 1.5rem;
      color: var(--fg);
      letter-spacing: 0.1em;
    }

    .panel h2::after {
      content: '';
      flex: 1;
      height: 1px;
      background: linear-gradient(90deg, var(--border-subtle), transparent);
      margin-left: 0.5rem;
    }

    /* ===== API Keys ===== */
    .key-list {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }

    .key-item {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 1rem;
      padding: 1rem 1.25rem;
      background: var(--bg-subtle);
      border: 1px solid var(--border-subtle);
      border-radius: 8px;
      transition: border-color 0.2s ease;
    }

    .key-item:hover {
      border-color: var(--border);
    }

    .key-info {
      flex: 1;
      min-width: 0;
    }

    .key-name {
      color: var(--fg);
      margin-bottom: 0.25rem;
    }

    .key-prefix {
      font-family: "JetBrains Mono", ui-monospace, monospace;
      font-size: 0.8125rem;
      color: var(--gold);
    }

    .key-meta {
      font-size: 0.75rem;
      color: var(--fg-subtle);
      margin-top: 0.375rem;
    }

    .delete-btn {
      padding: 0.375rem 0.75rem;
      background: transparent;
      border: 1px solid var(--border);
      border-radius: 6px;
      color: var(--fg-subtle);
      cursor: pointer;
      font-family: inherit;
      font-size: 0.75rem;
      transition: all 0.2s ease;
      flex-shrink: 0;
    }

    .delete-btn:hover {
      border-color: var(--danger-deep);
      color: var(--danger);
      background: rgba(160, 64, 64, 0.08);
    }

    .add-key-form {
      display: flex;
      gap: 0.75rem;
      margin-bottom: 1.5rem;
    }

    .add-key-form input {
      flex: 1;
      padding: 0.75rem 1rem;
      background: var(--bg-elevated);
      border: 1px solid var(--border);
      border-radius: 8px;
      color: var(--fg);
      font-family: inherit;
      font-size: 0.875rem;
      transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }

    .add-key-form input::placeholder {
      color: var(--fg-subtle);
    }

    .add-key-form input:focus {
      outline: none;
      border-color: var(--gold);
      box-shadow: 0 0 0 3px rgba(196, 169, 98, 0.1);
    }

    .add-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.75rem 1.5rem;
      background: linear-gradient(135deg, var(--gold) 0%, var(--gold-light) 100%);
      border: none;
      border-radius: 8px;
      color: #2C2418;
      cursor: pointer;
      font-family: inherit;
      font-size: 0.875rem;
      font-weight: 500;
      transition: transform 0.3s ease, box-shadow 0.3s ease;
      box-shadow: 0 2px 8px rgba(196, 169, 98, 0.25);
    }

    .add-btn:hover {
      transform: translateY(-1px);
      box-shadow: 0 4px 14px rgba(196, 169, 98, 0.35);
    }

    /* ===== Modal ===== */
    .modal-overlay {
      position: fixed;
      inset: 0;
      background: rgba(44, 44, 42, 0.32);
      backdrop-filter: blur(4px);
      display: none;
      align-items: center;
      justify-content: center;
      z-index: 100;
    }

    .modal-overlay.show {
      display: flex;
    }

    .modal {
      background: var(--bg-elevated);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 2rem;
      max-width: 480px;
      width: 90%;
      animation: panel-in 0.3s cubic-bezier(0.23, 1, 0.32, 1);
    }

    .modal h3 {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 1rem;
      font-weight: 400;
      margin-bottom: 1.25rem;
      color: var(--fg);
      letter-spacing: 0.05em;
    }

    .modal h3 .iconify {
      color: var(--gold);
    }

    .new-key-display {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      background: var(--bg-subtle);
      border: 1px solid var(--gold);
      border-radius: 8px;
      padding: 1rem;
      margin-bottom: 1rem;
    }

    .new-key-display code {
      flex: 1;
      font-family: "JetBrains Mono", ui-monospace, monospace;
      font-size: 0.8125rem;
      word-break: break-all;
      color: var(--gold);
      line-height: 1.5;
    }

    .copy-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.375rem;
      padding: 0.5rem 0.75rem;
      background: rgba(196, 169, 98, 0.1);
      border: 1px solid rgba(196, 169, 98, 0.4);
      border-radius: 6px;
      color: var(--gold);
      cursor: pointer;
      font-family: inherit;
      font-size: 0.75rem;
      white-space: nowrap;
      transition: all 0.2s ease;
      flex-shrink: 0;
    }

    .copy-btn:hover {
      background: rgba(196, 169, 98, 0.2);
    }

    .modal-warning {
      font-size: 0.8125rem;
      color: var(--gold);
      margin-bottom: 1.25rem;
      padding: 0.875rem 1rem;
      background: rgba(196, 169, 98, 0.08);
      border-radius: 8px;
      border-left: 2px solid var(--gold);
      line-height: 1.5;
    }

    .modal-close {
      width: 100%;
      padding: 0.75rem;
      background: var(--bg-subtle);
      border: 1px solid var(--border);
      border-radius: 8px;
      color: var(--fg);
      cursor: pointer;
      font-family: inherit;
      font-size: 0.875rem;
      transition: border-color 0.2s ease;
    }

    .modal-close:hover {
      border-color: var(--gold);
    }

    /* 确认弹窗 */
    .confirm-modal {
      max-width: 380px;
    }

    .confirm-modal .confirm-icon {
      color: var(--danger) !important;
    }

    .confirm-message {
      font-size: 0.9rem;
      color: var(--fg-muted);
      line-height: 1.6;
      margin-bottom: 1.5rem;
    }

    .modal-actions {
      display: flex;
      justify-content: flex-end;
      gap: 0.75rem;
    }

    .btn-danger {
      padding: 0.625rem 1.25rem;
      background: var(--danger);
      border: none;
      border-radius: 6px;
      color: #FFF7F0;
      cursor: pointer;
      font-family: inherit;
      font-size: 0.875rem;
      font-weight: 500;
      transition: all 0.2s ease;
      box-shadow: 0 2px 8px rgba(160, 64, 64, 0.25);
    }

    .btn-danger:hover {
      background: var(--danger-deep);
      transform: translateY(-1px);
      box-shadow: 0 4px 12px rgba(160, 64, 64, 0.3);
    }

    /* 列表项渐入 */
    .key-item, .skill-row, .project-card {
      animation: item-in 0.4s cubic-bezier(0.23, 1, 0.32, 1) both;
    }

    .key-item:nth-child(2), .skill-row:nth-child(2), .project-card:nth-child(2) { animation-delay: 0.05s; }
    .key-item:nth-child(3), .skill-row:nth-child(3), .project-card:nth-child(3) { animation-delay: 0.1s; }
    .key-item:nth-child(4), .skill-row:nth-child(4), .project-card:nth-child(4) { animation-delay: 0.15s; }
    .key-item:nth-child(n+5), .skill-row:nth-child(n+5), .project-card:nth-child(n+5) { animation-delay: 0.2s; }

    @keyframes item-in {
      from { opacity: 0; transform: translateY(8px); }
      to { opacity: 1; transform: translateY(0); }
    }

    /* ===== Skills ===== */
    .skill-rows {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    .skill-row {
      background: var(--bg-subtle);
      border: 1px solid var(--border-subtle);
      border-radius: 10px;
      padding: 1.5rem;
      position: relative;
      transition: all 0.3s ease;
    }

    .skill-row:hover {
      border-color: var(--border);
      box-shadow: 0 6px 20px rgba(44, 44, 42, 0.08);
    }

    .skill-row-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1rem;
      padding-bottom: 0.75rem;
      border-bottom: 1px solid var(--border-subtle);
    }

    .skill-row-title {
      font-size: 0.8125rem;
      color: var(--fg-subtle);
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .skill-row-title::before {
      content: '';
      width: 8px;
      height: 8px;
      background: var(--gold);
      border-radius: 50%;
      opacity: 0.6;
    }

    .delete-row-btn {
      padding: 0.25rem 0.5rem;
      background: transparent;
      border: 1px solid transparent;
      border-radius: 4px;
      color: var(--fg-subtle);
      cursor: pointer;
      font-family: inherit;
      font-size: 0.75rem;
      opacity: 0;
      transition: all 0.2s ease;
    }

    .skill-row:hover .delete-row-btn {
      opacity: 1;
    }

    .delete-row-btn:hover {
      border-color: var(--danger-deep);
      color: var(--danger);
      background: rgba(160, 64, 64, 0.1);
    }

    .skills-grid {
      display: flex;
      flex-wrap: wrap;
      gap: 0.625rem;
    }

    .skill-tag {
      display: flex;
      align-items: center;
      gap: 0.625rem;
      padding: 0.5rem 1rem;
      background: var(--bg-elevated);
      border: 1px solid var(--border);
      border-radius: 999px;
      font-size: 0.8125rem;
      color: var(--fg-muted);
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      position: relative;
      overflow: hidden;
    }

    .skill-tag::before {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(135deg, rgba(196, 169, 98, 0.1) 0%, transparent 50%);
      opacity: 0;
      transition: opacity 0.3s ease;
    }

    .skill-tag:hover {
      border-color: var(--gold);
      transform: translateY(-2px);
      box-shadow: 0 4px 12px rgba(196, 169, 98, 0.15);
    }

    .skill-tag:hover::before {
      opacity: 1;
    }

    .skill-tag .skill-icon {
      font-size: 1rem;
      color: var(--gold);
      position: relative;
      z-index: 1;
    }

    .skill-tag .skill-name {
      position: relative;
      z-index: 1;
    }

    .skill-tag .delete-skill {
      cursor: pointer;
      opacity: 0;
      width: 16px;
      height: 16px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 50%;
      background: transparent;
      transition: all 0.2s ease;
      position: relative;
      z-index: 1;
      margin-left: 0.25rem;
    }

    .skill-tag:hover .delete-skill {
      opacity: 0.5;
    }

    .skill-tag .delete-skill:hover {
      opacity: 1;
      color: var(--danger);
      background: rgba(160, 64, 64, 0.2);
    }

    .add-skill-inline {
      display: flex;
      gap: 0.625rem;
      margin-top: 1.25rem;
      padding-top: 1rem;
      border-top: 1px dashed var(--border-subtle);
    }

    .add-skill-inline input {
      flex: 1;
      padding: 0.625rem 1rem;
      background: var(--bg-elevated);
      border: 1px solid var(--border);
      border-radius: 6px;
      color: var(--fg);
      font-family: inherit;
      font-size: 0.8125rem;
      transition: all 0.2s ease;
      min-width: 0;
    }

    .add-skill-inline input::placeholder {
      color: var(--fg-subtle);
    }

    .add-skill-inline input:focus {
      outline: none;
      border-color: var(--gold);
      box-shadow: 0 0 0 3px rgba(196, 169, 98, 0.1);
    }

    .add-skill-btn {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      padding: 0.625rem 1.25rem;
      background: linear-gradient(135deg, var(--gold) 0%, var(--gold-light) 100%);
      border: none;
      border-radius: 6px;
      color: #2C2418;
      cursor: pointer;
      font-family: inherit;
      font-size: 0.8125rem;
      font-weight: 500;
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      box-shadow: 0 2px 8px rgba(196, 169, 98, 0.3);
    }

    .add-skill-btn:hover {
      transform: translateY(-1px);
      box-shadow: 0 4px 12px rgba(196, 169, 98, 0.4);
    }

    .add-skill-btn:active {
      transform: translateY(0);
    }

    .add-skill-btn .btn-icon {
      font-size: 0.875rem;
    }

    .add-row-btn {
      margin-top: 1.25rem;
      padding: 1rem 1.5rem;
      background: transparent;
      border: 2px dashed var(--border);
      border-radius: 10px;
      color: var(--fg-subtle);
      cursor: pointer;
      font-family: inherit;
      font-size: 0.875rem;
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.75rem;
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .add-row-btn:hover {
      border-color: var(--gold);
      color: var(--gold);
      background: rgba(196, 169, 98, 0.05);
      transform: translateY(-2px);
    }

    .add-row-btn .btn-icon {
      font-size: 1.25rem;
      transition: transform 0.3s ease;
    }

    .add-row-btn:hover .btn-icon {
      transform: rotate(90deg);
    }

    /* ===== Projects ===== */
    .project-list {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    .project-card {
      background: var(--bg-subtle);
      border: 1px solid var(--border-subtle);
      border-radius: 10px;
      padding: 1.5rem;
      transition: all 0.3s ease;
    }

    .project-card:hover {
      border-color: var(--border);
      box-shadow: 0 6px 20px rgba(44, 44, 42, 0.08);
    }

    .project-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 1rem;
    }

    .project-info {
      flex: 1;
      min-width: 0;
    }

    .project-name {
      font-size: 1.125rem;
      color: var(--fg);
      margin-bottom: 0.5rem;
      display: flex;
      align-items: center;
      gap: 0.75rem;
      flex-wrap: wrap;
    }

    .project-name .project-icon {
      color: var(--gold);
      font-size: 1.25rem;
    }

    .draft-badge {
      font-size: 0.625rem;
      padding: 0.125rem 0.5rem;
      background: var(--border);
      border-radius: 999px;
      color: var(--fg-subtle);
      letter-spacing: 0.05em;
    }

    .project-description {
      font-size: 0.875rem;
      color: var(--fg-muted);
      line-height: 1.5;
    }

    .project-links {
      display: flex;
      gap: 0.5rem;
      margin-top: 1rem;
      flex-wrap: wrap;
    }

    .project-link {
      display: flex;
      align-items: center;
      gap: 0.375rem;
      padding: 0.375rem 0.75rem;
      background: var(--bg-elevated);
      border: 1px solid var(--border);
      border-radius: 6px;
      color: var(--fg-subtle);
      font-size: 0.75rem;
      text-decoration: none;
      transition: all 0.2s ease;
    }

    .project-link:hover {
      border-color: var(--gold);
      color: var(--gold);
    }

    .project-stats {
      display: flex;
      gap: 1rem;
      margin-top: 1rem;
      padding-top: 1rem;
      border-top: 1px solid var(--border-subtle);
    }

    .project-stat {
      display: flex;
      align-items: center;
      gap: 0.375rem;
      font-size: 0.75rem;
      color: var(--fg-subtle);
    }

    .project-stat .stat-ico {
      color: var(--gold);
    }

    .project-actions {
      display: flex;
      gap: 0.5rem;
      flex-shrink: 0;
    }

    .project-action-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.375rem;
      padding: 0.375rem 0.75rem;
      background: transparent;
      border: 1px solid var(--border);
      border-radius: 6px;
      color: var(--fg-subtle);
      cursor: pointer;
      font-family: inherit;
      font-size: 0.75rem;
      transition: all 0.2s ease;
    }

    .project-action-btn:hover {
      border-color: var(--gold);
      color: var(--gold);
    }

    .project-action-btn.danger:hover {
      border-color: var(--danger-deep);
      color: var(--danger);
    }

    /* Add Project Form */
    .add-project-form {
      background: var(--bg-subtle);
      border: 2px dashed var(--border);
      border-radius: 10px;
      padding: 1.5rem;
      margin-bottom: 1.5rem;
    }

    .form-title {
      font-size: 0.875rem;
      letter-spacing: 0.1em;
      color: var(--fg-muted);
      margin-bottom: 1.25rem;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .form-title .iconify {
      color: var(--gold);
    }

    .form-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1rem;
    }

    .form-group {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }

    .form-group.full-width {
      grid-column: 1 / -1;
    }

    .form-label {
      font-size: 0.75rem;
      color: var(--fg-subtle);
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .form-input {
      padding: 0.75rem 1rem;
      background: var(--bg-elevated);
      border: 1px solid var(--border);
      border-radius: 6px;
      color: var(--fg);
      font-family: inherit;
      font-size: 0.875rem;
      transition: all 0.2s ease;
    }

    .form-input::placeholder {
      color: var(--fg-subtle);
    }

    .form-input:focus {
      outline: none;
      border-color: var(--gold);
      box-shadow: 0 0 0 3px rgba(196, 169, 98, 0.1);
    }

    .form-textarea {
      min-height: 80px;
      resize: vertical;
    }

    .form-actions {
      display: flex;
      justify-content: flex-end;
      gap: 0.75rem;
      margin-top: 1.25rem;
      padding-top: 1rem;
      border-top: 1px solid var(--border-subtle);
    }

    .btn-secondary {
      padding: 0.625rem 1.25rem;
      background: transparent;
      border: 1px solid var(--border);
      border-radius: 6px;
      color: var(--fg-muted);
      cursor: pointer;
      font-family: inherit;
      font-size: 0.875rem;
      transition: all 0.2s ease;
    }

    .btn-secondary:hover {
      border-color: var(--fg-subtle);
      color: var(--fg);
    }

    .btn-primary {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.625rem 1.5rem;
      background: linear-gradient(135deg, var(--gold) 0%, var(--gold-light) 100%);
      border: none;
      border-radius: 6px;
      color: #2C2418;
      cursor: pointer;
      font-family: inherit;
      font-size: 0.875rem;
      font-weight: 500;
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      box-shadow: 0 2px 8px rgba(196, 169, 98, 0.3);
    }

    .btn-primary:hover {
      transform: translateY(-1px);
      box-shadow: 0 4px 12px rgba(196, 169, 98, 0.4);
    }

    .toggle-form-btn {
      margin-bottom: 1.5rem;
      padding: 0.875rem 1.5rem;
      background: transparent;
      border: 2px dashed var(--border);
      border-radius: 10px;
      color: var(--fg-subtle);
      cursor: pointer;
      font-family: inherit;
      font-size: 0.875rem;
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.75rem;
      transition: all 0.3s ease;
    }

    .toggle-form-btn:hover {
      border-color: var(--gold);
      color: var(--gold);
      background: rgba(196, 169, 98, 0.05);
    }

    .toggle-form-btn .btn-icon {
      font-size: 1.25rem;
      transition: transform 0.3s ease;
    }

    .toggle-form-btn:hover .btn-icon {
      transform: rotate(90deg);
    }

    /* ===== 空状态 & 骨架屏 ===== */
    .empty-state {
      text-align: center;
      padding: 3rem 2rem;
      color: var(--fg-subtle);
    }

    .empty-state .empty-icon {
      font-size: 2.25rem;
      color: #CFC6AD;
      display: block;
      margin: 0 auto 1rem;
    }

    .skeleton-list {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }

    .skeleton {
      height: 72px;
      border-radius: 8px;
      background: linear-gradient(
        100deg,
        var(--bg-subtle) 40%,
        var(--border-subtle) 50%,
        var(--bg-subtle) 60%
      );
      background-size: 200% 100%;
      animation: skeleton-shimmer 1.4s ease-in-out infinite;
    }

    @keyframes skeleton-shimmer {
      from { background-position: 120% 0; }
      to { background-position: -80% 0; }
    }

    /* ===== Toast ===== */
    .toast-container {
      position: fixed;
      bottom: 1.5rem;
      right: 1.5rem;
      display: flex;
      flex-direction: column;
      gap: 0.625rem;
      z-index: 200;
    }

    .toast {
      display: flex;
      align-items: center;
      gap: 0.625rem;
      padding: 0.875rem 1.125rem;
      background: var(--bg-elevated);
      border: 1px solid var(--border);
      border-left: 2px solid var(--gold);
      border-radius: 8px;
      color: var(--fg);
      font-size: 0.8125rem;
      box-shadow: 0 8px 24px rgba(44, 44, 42, 0.14);
      animation: toast-in 0.35s cubic-bezier(0.23, 1, 0.32, 1);
      max-width: 320px;
    }

    .toast.error {
      border-left-color: var(--danger-deep);
    }

    .toast .iconify {
      color: var(--gold);
      font-size: 1rem;
      flex-shrink: 0;
    }

    .toast.error .iconify {
      color: var(--danger);
    }

    .toast.removing {
      animation: toast-out 0.3s ease forwards;
    }

    @keyframes toast-in {
      from { opacity: 0; transform: translateX(24px); }
      to { opacity: 1; transform: translateX(0); }
    }

    @keyframes toast-out {
      from { opacity: 1; transform: translateX(0); }
      to { opacity: 0; transform: translateX(24px); }
    }

    /* ===== 滚动条 ===== */
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }

    ::-webkit-scrollbar-track {
      background: transparent;
    }

    ::-webkit-scrollbar-thumb {
      background: var(--border);
      border-radius: 3px;
    }

    /* ===== 响应式 ===== */
    @media (max-width: 720px) {
      .container {
        padding: 1.5rem 1rem 3rem;
      }

      .stats {
        grid-template-columns: 1fr;
        gap: 0.625rem;
      }

      .stat-card {
        padding: 0.875rem 1.125rem;
      }

      .tabs {
        gap: 1.25rem;
        overflow-x: auto;
        scrollbar-width: none;
      }

      .tabs::-webkit-scrollbar {
        display: none;
      }

      .panel {
        padding: 1.25rem;
      }

      .add-key-form {
        flex-direction: column;
      }

      .add-skill-inline {
        flex-direction: column;
      }

      .form-grid {
        grid-template-columns: 1fr;
      }

      .project-header {
        flex-direction: column;
      }

      .logo-sub {
        display: none;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .skeleton, .panel, .toast, .modal {
        animation: none;
      }
    }
  </style>
</head>
<body>
  <div class="bg-glow gold" aria-hidden="true"></div>
  <div class="bg-glow bamboo" aria-hidden="true"></div>

  <div class="container">
    <header>
      <div class="brand">
        <div class="seal" aria-hidden="true">凡</div>
        <div>
          <div class="logo">SONNET ADMIN</div>
          <div class="logo-sub">十四行 · 管理后台</div>
        </div>
      </div>
      <div class="header-actions">
        <a href="/" class="ghost-btn" target="_blank" rel="noopener">
          <span class="iconify" data-icon="lucide:external-link"></span>
          <span>查看博客</span>
        </a>
        <button class="ghost-btn danger" onclick="logout()">
          <span class="iconify" data-icon="lucide:log-out"></span>
          <span>退出登录</span>
        </button>
      </div>
    </header>

    <!-- 统计概览 -->
    <div class="stats">
      <div class="stat-card">
        <div class="stat-icon"><span class="iconify" data-icon="lucide:key-round"></span></div>
        <div>
          <div class="stat-value" id="statKeys">–</div>
          <div class="stat-label">密钥 · Keys</div>
        </div>
      </div>
      <div class="stat-card">
        <div class="stat-icon"><span class="iconify" data-icon="lucide:sparkles"></span></div>
        <div>
          <div class="stat-value" id="statSkills">–</div>
          <div class="stat-label">技能 · Skills</div>
        </div>
      </div>
      <div class="stat-card">
        <div class="stat-icon"><span class="iconify" data-icon="lucide:folder-git-2"></span></div>
        <div>
          <div class="stat-value" id="statProjects">–</div>
          <div class="stat-label">项目 · Projects</div>
        </div>
      </div>
    </div>

    <nav class="tabs">
      <button class="tab active" data-panel="api-keys">
        <span class="iconify tab-icon" data-icon="lucide:key-round"></span>
        <span>密钥</span>
      </button>
      <button class="tab" data-panel="skills">
        <span class="iconify tab-icon" data-icon="lucide:sparkles"></span>
        <span>技能</span>
      </button>
      <button class="tab" data-panel="projects">
        <span class="iconify tab-icon" data-icon="lucide:folder-git-2"></span>
        <span>项目</span>
      </button>
      <button class="tab" data-panel="photos">
        <span class="iconify tab-icon" data-icon="lucide:image"></span>
        <span>相册</span>
      </button>
    </nav>

    <!-- API Keys Panel -->
    <div id="api-keys-panel" class="panel active">
      <h2>密钥管理</h2>
      <form class="add-key-form" id="addKeyForm">
        <input type="text" id="keyName" placeholder="密钥名称（如：Obsidian 插件）" required />
        <button type="submit" class="add-btn">
          <span class="iconify" data-icon="lucide:plus"></span>
          <span>生成密钥</span>
        </button>
      </form>
      <div id="keyList" class="key-list">
        <div class="skeleton-list"><div class="skeleton"></div><div class="skeleton"></div></div>
      </div>
    </div>

    <!-- Skills Panel -->
    <div id="skills-panel" class="panel">
      <h2>技能管理</h2>
      <div id="skillRows" class="skill-rows">
        <div class="skeleton-list"><div class="skeleton"></div><div class="skeleton"></div></div>
      </div>
      <button class="add-row-btn" onclick="addSkillRow()">
        <span class="iconify btn-icon" data-icon="lucide:plus"></span>
        <span>新增一行</span>
      </button>
    </div>

    <!-- Projects Panel -->
    <div id="projects-panel" class="panel">
      <h2>项目管理</h2>

      <button id="toggleProjectForm" class="toggle-form-btn" onclick="toggleProjectForm()">
        <span class="iconify btn-icon" data-icon="lucide:plus"></span>
        <span>新增项目</span>
      </button>

      <div id="addProjectForm" class="add-project-form" style="display: none;">
        <div class="form-title" id="projectFormTitle">
          <span class="iconify" data-icon="lucide:folder-plus"></span>
          <span>新增项目</span>
        </div>
        <div class="form-grid">
          <div class="form-group">
            <label class="form-label">项目名称</label>
            <input type="text" id="projectName" class="form-input" placeholder="我的项目" />
          </div>
          <div class="form-group">
            <label class="form-label">图标类名</label>
            <input type="text" id="projectIcon" class="form-input" placeholder="icon-[lucide--code]" />
          </div>
          <div class="form-group full-width">
            <label class="form-label">项目描述</label>
            <textarea id="projectDescription" class="form-input form-textarea" placeholder="一句话介绍这个项目…"></textarea>
          </div>
          <div class="form-group">
            <label class="form-label">GitHub 地址</label>
            <input type="text" id="projectGithub" class="form-input" placeholder="https://github.com/username/repo" />
          </div>
          <div class="form-group">
            <label class="form-label">网站地址</label>
            <input type="text" id="projectWebsite" class="form-input" placeholder="https://example.com" />
          </div>
          <div class="form-group">
            <label class="form-label">Star 数</label>
            <input type="number" id="projectStars" class="form-input" placeholder="0" value="0" />
          </div>
          <div class="form-group">
            <label class="form-label">Fork 数</label>
            <input type="number" id="projectForks" class="form-input" placeholder="0" value="0" />
          </div>
        </div>
        <div class="form-actions">
          <button type="button" class="btn-secondary" onclick="toggleProjectForm()">取消</button>
          <button type="button" class="btn-primary" onclick="saveProject()">
            <span class="iconify" data-icon="lucide:check"></span>
            <span id="projectSaveLabel">保存项目</span>
          </button>
        </div>
      </div>

      <div id="projectList" class="project-list">
        <div class="skeleton-list"><div class="skeleton"></div><div class="skeleton"></div></div>
      </div>
    </div>

    <!-- Photos Panel -->
    <div id="photos-panel" class="panel">
      <h2>相册管理</h2>
      <div class="empty-state">
        <span class="iconify empty-icon" data-icon="lucide:image"></span>
        <p>相册管理即将上线</p>
        <p style="margin-top: 0.5rem; font-size: 0.75rem;">Upload and organize your photo albums</p>
      </div>
    </div>
  </div>

  <!-- New Key Modal -->
  <div id="newKeyModal" class="modal-overlay">
    <div class="modal">
      <h3>
        <span class="iconify" data-icon="lucide:key-round"></span>
        <span>新密钥已生成</span>
      </h3>
      <p class="modal-warning">
        <strong>重要：</strong>请立即复制保存，此密钥只显示这一次！
      </p>
      <div class="new-key-display">
        <code id="newKeyDisplay"></code>
        <button class="copy-btn" onclick="copyNewKey()">
          <span class="iconify" data-icon="lucide:copy"></span>
          <span id="copyLabel">复制</span>
        </button>
      </div>
      <button class="modal-close" onclick="closeModal()">我已复制密钥</button>
    </div>
  </div>

  <!-- Confirm Modal -->
  <div id="confirmModal" class="modal-overlay">
    <div class="modal confirm-modal">
      <h3>
        <span class="iconify confirm-icon" data-icon="lucide:alert-triangle"></span>
        <span>确认操作</span>
      </h3>
      <p class="confirm-message" id="confirmMessage"></p>
      <div class="modal-actions">
        <button type="button" class="btn-secondary" id="confirmCancel">取消</button>
        <button type="button" class="btn-danger" id="confirmOk">确认删除</button>
      </div>
    </div>
  </div>

  <!-- Toasts -->
  <div class="toast-container" id="toastContainer"></div>

  <script>
    // 检查认证
    const token = localStorage.getItem('auth_token');
    if (!token) {
      window.location.href = '/fantay/login';
    }

    // ========== Toast ==========
    function toast(message, type = 'success') {
      const container = document.getElementById('toastContainer');
      const el = document.createElement('div');
      el.className = `toast ${type === 'error' ? 'error' : ''}`;
      const icon = type === 'error' ? 'lucide:alert-circle' : 'lucide:check-circle-2';
      el.innerHTML = `<span class="iconify" data-icon="${icon}"></span><span></span>`;
      el.querySelector('span:last-child').textContent = message;
      container.appendChild(el);
      setTimeout(() => {
        el.classList.add('removing');
        setTimeout(() => el.remove(), 320);
      }, 3000);
    }

    // API 请求辅助函数：401 自动跳转登录，网络错误提示
    async function api(url, options = {}) {
      let res;
      try {
        res = await fetch(url, {
          ...options,
          headers: {
            'Content-Type': 'application/json',
            'Authorization': `Bearer ${token}`,
            ...options.headers,
          },
        });
      } catch {
        toast('网络错误，请重试', 'error');
        return { success: false, error: 'Network error' };
      }

      if (res.status === 401) {
        localStorage.removeItem('auth_token');
        window.location.href = '/fantay/login';
        return { success: false, error: 'Unauthorized' };
      }

      try {
        return await res.json();
      } catch {
        return { success: false, error: 'Invalid server response' };
      }
    }

    // HTML 转义，防止内容破坏模板
    function esc(str) {
      return String(str ?? '')
        .replaceAll('&', '&amp;')
        .replaceAll('<', '&lt;')
        .replaceAll('>', '&gt;')
        .replaceAll('"', '&quot;')
        .replaceAll("'", '&#39;');
    }

    function toIconify(icon, fallback = 'lucide:folder') {
      if (!icon) return fallback;
      return icon.replace('icon-[', '').replace(']', '').replace('--', ':');
    }

    // 标签切换
    document.querySelectorAll('.tab').forEach(tab => {
      tab.addEventListener('click', () => {
        document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
        document.querySelectorAll('.panel').forEach(p => p.classList.remove('active'));
        tab.classList.add('active');
        document.getElementById(`${tab.dataset.panel}-panel`).classList.add('active');
      });
    });

    // 登出
    function logout() {
      localStorage.removeItem('auth_token');
      window.location.href = '/fantay/login';
    }

    // ========== 确认弹窗（替代原生 confirm） ==========
    function zenConfirm(message) {
      return new Promise((resolve) => {
        const overlay = document.getElementById('confirmModal');
        const okBtn = document.getElementById('confirmOk');
        const cancelBtn = document.getElementById('confirmCancel');
        document.getElementById('confirmMessage').textContent = message;
        overlay.classList.add('show');

        function done(result) {
          overlay.classList.remove('show');
          okBtn.removeEventListener('click', onOk);
          cancelBtn.removeEventListener('click', onCancel);
          overlay.removeEventListener('click', onOverlay);
          document.removeEventListener('keydown', onKey);
          resolve(result);
        }
        const onOk = () => done(true);
        const onCancel = () => done(false);
        const onOverlay = (e) => { if (e.target === overlay) done(false); };
        const onKey = (e) => { if (e.key === 'Escape') done(false); };

        okBtn.addEventListener('click', onOk);
        cancelBtn.addEventListener('click', onCancel);
        overlay.addEventListener('click', onOverlay);
        document.addEventListener('keydown', onKey);
      });
    }

    // Esc 关闭密钥弹窗
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        document.getElementById('newKeyModal').classList.remove('show');
      }
    });

    // ========== API Keys ==========
    async function loadApiKeys() {
      const data = await api('/api/fantay/api-keys');
      const container = document.getElementById('keyList');
      const keys = data.success ? (data.keys || []) : [];

      document.getElementById('statKeys').textContent = keys.length;

      if (keys.length === 0) {
        container.innerHTML = '<div class="empty-state"><span class="iconify empty-icon" data-icon="lucide:key-round"></span><p>还没有密钥，在上方创建一个。</p></div>';
        return;
      }

      container.innerHTML = keys.map(key => `
        <div class="key-item">
          <div class="key-info">
            <div class="key-name">${esc(key.name)}</div>
            <div class="key-prefix">${esc(key.keyPrefix)}</div>
            <div class="key-meta">
              创建于 ${new Date(key.createdAt).toLocaleDateString('zh-CN')}
              ${key.lastUsedAt ? ` · 最近使用 ${new Date(key.lastUsedAt).toLocaleDateString('zh-CN')}` : ''}
              · 权限 ${esc((key.permissions || []).join(', '))}
            </div>
          </div>
          <button class="delete-btn" onclick="deleteKey('${key.id}')">删除</button>
        </div>
      `).join('');
    }

    document.getElementById('addKeyForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const name = document.getElementById('keyName').value;
      const data = await api('/api/fantay/api-keys', {
        method: 'POST',
        body: JSON.stringify({ name }),
      });

      if (data.success) {
        document.getElementById('newKeyDisplay').textContent = data.key;
        document.getElementById('copyLabel').textContent = '复制';
        document.getElementById('newKeyModal').classList.add('show');
        document.getElementById('keyName').value = '';
        loadApiKeys();
      } else {
        toast(data.error || '生成密钥失败', 'error');
      }
    });

    async function deleteKey(id) {
      if (!(await zenConfirm('确定删除这个密钥？使用它的应用将立即失效。'))) return;
      const data = await api(`/api/fantay/api-keys?id=${id}`, { method: 'DELETE' });
      if (data.success) toast('密钥已删除');
      loadApiKeys();
    }

    function closeModal() {
      document.getElementById('newKeyModal').classList.remove('show');
    }

    async function copyNewKey() {
      const key = document.getElementById('newKeyDisplay').textContent;
      try {
        await navigator.clipboard.writeText(key);
        document.getElementById('copyLabel').textContent = '已复制';
        toast('密钥已复制到剪贴板');
      } catch {
        toast('复制失败，请手动选择复制', 'error');
      }
    }

    // ========== Skills ==========
    let skillsData = [];

    async function loadSkills() {
      const data = await api('/api/fantay/skills');
      const container = document.getElementById('skillRows');

      skillsData = (data.success ? data.skills : null) || [];

      const totalSkills = skillsData.reduce((sum, row) => sum + (row.skills?.length || 0), 0);
      document.getElementById('statSkills').textContent = totalSkills;

      if (skillsData.length === 0) {
        container.innerHTML = '<div class="empty-state"><span class="iconify empty-icon" data-icon="lucide:sparkles"></span><p>还没有技能行，点击下方新增。</p></div>';
        return;
      }

      container.innerHTML = skillsData.map((row, i) => `
        <div class="skill-row" data-row-id="${row.id}">
          <div class="skill-row-header">
            <span class="skill-row-title">第 ${i + 1} 行 · 滚动方向 ${row.direction === 'left' ? '向左' : '向右'}</span>
            <button class="delete-row-btn" onclick="deleteSkillRow('${row.id}')">
              <span class="iconify" data-icon="lucide:trash-2"></span> 删除行
            </button>
          </div>
          <div class="skills-grid">
            ${row.skills.map(skill => `
              <div class="skill-tag">
                <span class="iconify skill-icon" data-icon="${esc(toIconify(skill.icon, 'lucide:code'))}"></span>
                <span class="skill-name">${esc(skill.name)}</span>
                <span class="delete-skill" onclick="deleteSkill('${row.id}', '${skill.id}')">
                  <span class="iconify" data-icon="lucide:x"></span>
                </span>
              </div>
            `).join('')}
          </div>
          <div class="add-skill-inline">
            <input type="text" placeholder="技能名称" id="name-${row.id}" />
            <input type="text" placeholder="图标（如 lucide:code）" id="icon-${row.id}" />
            <button class="add-skill-btn" onclick="addSkill('${row.id}')">
              <span class="iconify btn-icon" data-icon="lucide:plus"></span>
              <span>添加</span>
            </button>
          </div>
        </div>
      `).join('');
    }

    async function addSkillRow() {
      const direction = skillsData.length % 2 === 0 ? 'left' : 'right';
      const data = await api('/api/fantay/skills', {
        method: 'POST',
        body: JSON.stringify({ action: 'addRow', direction }),
      });
      if (data.success) toast('已新增一行');
      loadSkills();
    }

    async function addSkill(rowId) {
      const nameInput = document.getElementById(`name-${rowId}`);
      const iconInput = document.getElementById(`icon-${rowId}`);
      const name = nameInput.value.trim();
      let icon = iconInput.value.trim();

      if (!name || !icon) {
        toast('请填写技能名称和图标', 'error');
        return;
      }

      // 转换 iconify 格式为 icon-[] 格式
      if (icon.includes(':')) {
        icon = `icon-[${icon.replace(':', '--')}]`;
      }

      const data = await api('/api/fantay/skills', {
        method: 'POST',
        body: JSON.stringify({ action: 'addSkill', rowId, skill: { name, icon } }),
      });

      if (data.success) {
        toast(`技能「${name}」已添加`);
        nameInput.value = '';
        iconInput.value = '';
      } else {
        toast(data.error || '添加失败', 'error');
      }
      loadSkills();
    }

    async function deleteSkill(rowId, skillId) {
      const data = await api(`/api/fantay/skills?rowId=${rowId}&skillId=${skillId}`, { method: 'DELETE' });
      if (data.success) toast('技能已移除');
      loadSkills();
    }

    async function deleteSkillRow(rowId) {
      if (!(await zenConfirm('删除整行及其所有技能？此操作不可恢复。'))) return;
      const data = await api(`/api/fantay/skills?rowId=${rowId}`, { method: 'DELETE' });
      if (data.success) toast('该行已删除');
      loadSkills();
    }

    // ========== Projects ==========
    let projectsData = [];
    let editingProjectId = null;

    async function loadProjects() {
      const data = await api('/api/fantay/projects');
      const container = document.getElementById('projectList');

      projectsData = (data.success ? data.projects : null) || [];

      document.getElementById('statProjects').textContent = projectsData.length;

      if (projectsData.length === 0) {
        container.innerHTML = '<div class="empty-state"><span class="iconify empty-icon" data-icon="lucide:folder-git-2"></span><p>还没有项目，点击上方新增。</p></div>';
        return;
      }

      container.innerHTML = projectsData.map(project => `
        <div class="project-card" data-project-id="${project.id}">
          <div class="project-header">
            <div class="project-info">
              <div class="project-name">
                <span class="iconify project-icon" data-icon="${esc(toIconify(project.icon))}"></span>
                <span>${esc(project.name)}</span>
                ${project.draft ? '<span class="draft-badge">草稿</span>' : ''}
              </div>
              <p class="project-description">${esc(project.description) || '暂无描述'}</p>
              <div class="project-links">
                ${project.githubUrl ? `
                  <a href="${esc(project.githubUrl)}" target="_blank" rel="noopener" class="project-link">
                    <span class="iconify" data-icon="lucide:github"></span>
                    <span>GitHub</span>
                  </a>
                ` : ''}
                ${project.website ? `
                  <a href="${esc(project.website)}" target="_blank" rel="noopener" class="project-link">
                    <span class="iconify" data-icon="lucide:external-link"></span>
                    <span>Website</span>
                  </a>
                ` : ''}
              </div>
              <div class="project-stats">
                <span class="project-stat">
                  <span class="iconify stat-ico" data-icon="lucide:star"></span>
                  <span>${project.star || 0}</span>
                </span>
                <span class="project-stat">
                  <span class="iconify stat-ico" data-icon="lucide:git-fork"></span>
                  <span>${project.fork || 0}</span>
                </span>
              </div>
            </div>
            <div class="project-actions">
              <button class="project-action-btn" onclick="editProject('${project.id}')">
                <span class="iconify" data-icon="lucide:edit-2"></span> 编辑
              </button>
              <button class="project-action-btn danger" onclick="deleteProject('${project.id}')">
                <span class="iconify" data-icon="lucide:trash-2"></span>
              </button>
            </div>
          </div>
        </div>
      `).join('');
    }

    function setProjectFormMode(editing) {
      document.querySelector('#projectFormTitle span:last-child').textContent =
        editing ? '编辑项目' : '新增项目';
      document.getElementById('projectSaveLabel').textContent =
        editing ? '更新项目' : '保存项目';
    }

    function toggleProjectForm() {
      const form = document.getElementById('addProjectForm');
      const btn = document.getElementById('toggleProjectForm');
      if (form.style.display === 'none') {
        form.style.display = 'block';
        btn.style.display = 'none';
        setProjectFormMode(false);
      } else {
        form.style.display = 'none';
        btn.style.display = 'flex';
        editingProjectId = null;
        clearProjectForm();
      }
    }

    function clearProjectForm() {
      document.getElementById('projectName').value = '';
      document.getElementById('projectIcon').value = '';
      document.getElementById('projectDescription').value = '';
      document.getElementById('projectGithub').value = '';
      document.getElementById('projectWebsite').value = '';
      document.getElementById('projectStars').value = '0';
      document.getElementById('projectForks').value = '0';
    }

    async function saveProject() {
      const name = document.getElementById('projectName').value.trim();
      const icon = document.getElementById('projectIcon').value.trim();
      const description = document.getElementById('projectDescription').value.trim();
      const githubUrl = document.getElementById('projectGithub').value.trim();
      const website = document.getElementById('projectWebsite').value.trim();
      const star = parseInt(document.getElementById('projectStars').value) || 0;
      const fork = parseInt(document.getElementById('projectForks').value) || 0;

      if (!name) {
        toast('请填写项目名称', 'error');
        return;
      }

      const payload = {
        name,
        icon: icon || 'icon-[lucide--folder]',
        description,
        githubUrl,
        website,
        star,
        fork,
        draft: false,
      };

      // 编辑模式走 PUT 更新，新建走 POST；不再先删后存
      const data = editingProjectId
        ? await api('/api/fantay/projects', {
            method: 'PUT',
            body: JSON.stringify({ id: editingProjectId, ...payload }),
          })
        : await api('/api/fantay/projects', {
            method: 'POST',
            body: JSON.stringify(payload),
          });

      if (data.success) {
        toast(editingProjectId ? '项目已更新' : '项目已创建');
        editingProjectId = null;
        toggleProjectForm();
        loadProjects();
      } else {
        toast(data.error || '保存失败', 'error');
      }
    }

    async function deleteProject(id) {
      if (!(await zenConfirm('确定删除这个项目？此操作不可恢复。'))) return;
      const data = await api(`/api/fantay/projects?id=${id}`, { method: 'DELETE' });
      if (data.success) toast('项目已删除');
      loadProjects();
    }

    function editProject(id) {
      const project = projectsData.find(p => p.id === id);
      if (!project) return;

      editingProjectId = id;

      document.getElementById('projectName').value = project.name || '';
      document.getElementById('projectIcon').value = project.icon || '';
      document.getElementById('projectDescription').value = project.description || '';
      document.getElementById('projectGithub').value = project.githubUrl || '';
      document.getElementById('projectWebsite').value = project.website || '';
      document.getElementById('projectStars').value = project.star || 0;
      document.getElementById('projectForks').value = project.fork || 0;

      // 显示编辑表单
      document.getElementById('addProjectForm').style.display = 'block';
      document.getElementById('toggleProjectForm').style.display = 'none';
      setProjectFormMode(true);
      document.getElementById('projectName').focus();
    }

    // 将函数挂载到 window 以便 onclick 调用
    window.logout = logout;
    window.closeModal = closeModal;
    window.copyNewKey = copyNewKey;
    window.deleteKey = deleteKey;
    window.addSkillRow = addSkillRow;
    window.addSkill = addSkill;
    window.deleteSkill = deleteSkill;
    window.deleteSkillRow = deleteSkillRow;
    window.toggleProjectForm = toggleProjectForm;
    window.saveProject = saveProject;
    window.deleteProject = deleteProject;
    window.editProject = editProject;

    // 初始化加载
    loadApiKeys();
    loadSkills();
    loadProjects();
  </script>
</body>
</html>
