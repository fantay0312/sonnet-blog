---
/**
 * 管理后台主页
 * /fantay
 */
export const prerender = false;
---

<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Sonnet Admin Dashboard</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@iconify/iconify@latest/dist/iconify.min.css" />
  <script src="https://code.iconify.design/3/3.1.0/iconify.min.js"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=LXGW+WenKai:wght@300;400;700&family=Noto+Serif+SC:wght@300;400;500&display=swap" rel="stylesheet">
  <style>
    /* ===== 禅意配色 - 与主站深色模式一致 ===== */
    :root {
      --bg: #0E0E0C;
      --bg-elevated: #1A1A18;
      --bg-subtle: #141412;
      --fg: #E8E4DC;
      --fg-muted: #A0A09E;
      --fg-subtle: #6A6A68;
      --gold: #C4A962;
      --gold-light: #D4B972;
      --border: #2A2A28;
      --border-subtle: #1E1E1C;
      --danger: #A04040;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: "LXGW WenKai", "Noto Serif SC", serif;
      background: var(--bg);
      min-height: 100vh;
      color: var(--fg);
    }

    .container {
      max-width: 900px;
      margin: 0 auto;
      padding: 3rem 2rem;
    }

    /* ===== 头部 ===== */
    header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 3rem;
      padding-bottom: 1.5rem;
      border-bottom: 1px solid var(--border);
    }

    .logo {
      font-family: "LXGW WenKai", serif;
      font-size: 1.5rem;
      font-weight: 400;
      letter-spacing: 0.15em;
      color: var(--fg);
    }

    .logout-btn {
      padding: 0.5rem 1rem;
      background: transparent;
      border: 1px solid var(--border);
      border-radius: 4px;
      color: var(--fg-subtle);
      cursor: pointer;
      font-family: inherit;
      font-size: 0.875rem;
      transition: all 0.3s ease;
    }

    .logout-btn:hover {
      border-color: var(--danger);
      color: var(--danger);
    }

    /* ===== 导航标签 ===== */
    .tabs {
      display: flex;
      gap: 2rem;
      margin-bottom: 2rem;
      border-bottom: 1px solid var(--border-subtle);
    }

    .tab {
      padding: 0.75rem 0;
      background: transparent;
      border: none;
      border-bottom: 2px solid transparent;
      color: var(--fg-subtle);
      cursor: pointer;
      font-family: inherit;
      font-size: 0.9375rem;
      letter-spacing: 0.08em;
      margin-bottom: -1px;
      transition: all 0.3s ease;
    }

    .tab:hover {
      color: var(--fg-muted);
    }

    .tab.active {
      color: var(--fg);
      border-bottom-color: var(--gold);
    }

    /* ===== 面板 ===== */
    .panel {
      display: none;
      background: var(--bg-elevated);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 2rem;
    }

    .panel.active {
      display: block;
    }

    .panel h2 {
      font-family: "LXGW WenKai", serif;
      font-size: 1.125rem;
      font-weight: 400;
      margin-bottom: 1.5rem;
      color: var(--fg);
      letter-spacing: 0.1em;
    }

    /* ===== API Keys ===== */
    .key-list {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }

    .key-item {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 1rem 1.25rem;
      background: var(--bg-subtle);
      border: 1px solid var(--border-subtle);
      border-radius: 6px;
      transition: border-color 0.2s ease;
    }

    .key-item:hover {
      border-color: var(--border);
    }

    .key-info {
      flex: 1;
    }

    .key-name {
      color: var(--fg);
      margin-bottom: 0.25rem;
    }

    .key-prefix {
      font-family: "JetBrains Mono", monospace;
      font-size: 0.8125rem;
      color: var(--gold);
    }

    .key-meta {
      font-size: 0.75rem;
      color: var(--fg-subtle);
      margin-top: 0.375rem;
    }

    .delete-btn {
      padding: 0.375rem 0.75rem;
      background: transparent;
      border: 1px solid var(--border);
      border-radius: 4px;
      color: var(--fg-subtle);
      cursor: pointer;
      font-family: inherit;
      font-size: 0.75rem;
      transition: all 0.2s ease;
    }

    .delete-btn:hover {
      border-color: var(--danger);
      color: var(--danger);
    }

    .add-key-form {
      display: flex;
      gap: 0.75rem;
      margin-bottom: 1.5rem;
    }

    .add-key-form input {
      flex: 1;
      padding: 0.75rem 1rem;
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: 6px;
      color: var(--fg);
      font-family: inherit;
      font-size: 0.875rem;
      transition: border-color 0.2s ease;
    }

    .add-key-form input::placeholder {
      color: var(--fg-subtle);
    }

    .add-key-form input:focus {
      outline: none;
      border-color: var(--gold);
    }

    .add-btn {
      padding: 0.75rem 1.5rem;
      background: var(--gold);
      border: none;
      border-radius: 6px;
      color: var(--bg);
      cursor: pointer;
      font-family: inherit;
      font-size: 0.875rem;
      font-weight: 400;
      transition: opacity 0.2s ease;
    }

    .add-btn:hover {
      opacity: 0.9;
    }

    /* ===== Modal ===== */
    .modal-overlay {
      position: fixed;
      inset: 0;
      background: rgba(14, 14, 12, 0.9);
      backdrop-filter: blur(4px);
      display: none;
      align-items: center;
      justify-content: center;
      z-index: 100;
    }

    .modal-overlay.show {
      display: flex;
    }

    .modal {
      background: var(--bg-elevated);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 2rem;
      max-width: 450px;
      width: 90%;
    }

    .modal h3 {
      font-family: "LXGW WenKai", serif;
      font-size: 1rem;
      font-weight: 400;
      margin-bottom: 1.25rem;
      color: var(--fg);
    }

    .new-key-display {
      background: var(--bg);
      border: 1px solid var(--gold);
      border-radius: 6px;
      padding: 1rem;
      font-family: "JetBrains Mono", monospace;
      font-size: 0.8125rem;
      word-break: break-all;
      margin-bottom: 1rem;
      color: var(--gold);
      line-height: 1.5;
    }

    .modal-warning {
      font-size: 0.8125rem;
      color: var(--gold-light);
      margin-bottom: 1.25rem;
      padding: 0.875rem 1rem;
      background: rgba(196, 169, 98, 0.1);
      border-radius: 6px;
      border-left: 2px solid var(--gold);
      line-height: 1.5;
    }

    .modal-close {
      width: 100%;
      padding: 0.75rem;
      background: var(--bg-subtle);
      border: 1px solid var(--border);
      border-radius: 6px;
      color: var(--fg);
      cursor: pointer;
      font-family: inherit;
      font-size: 0.875rem;
      transition: border-color 0.2s ease;
    }

    .modal-close:hover {
      border-color: var(--gold);
    }

    /* ===== Skills ===== */
    .skill-rows {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    .skill-row {
      background: var(--bg-subtle);
      border: 1px solid var(--border-subtle);
      border-radius: 8px;
      padding: 1.5rem;
      position: relative;
      transition: all 0.3s ease;
    }

    .skill-row:hover {
      border-color: var(--border);
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
    }

    .skill-row-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1rem;
      padding-bottom: 0.75rem;
      border-bottom: 1px solid var(--border-subtle);
    }

    .skill-row-title {
      font-size: 0.8125rem;
      color: var(--fg-subtle);
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .skill-row-title::before {
      content: '';
      width: 8px;
      height: 8px;
      background: var(--gold);
      border-radius: 50%;
      opacity: 0.6;
    }

    .delete-row-btn {
      padding: 0.25rem 0.5rem;
      background: transparent;
      border: 1px solid transparent;
      border-radius: 4px;
      color: var(--fg-subtle);
      cursor: pointer;
      font-size: 0.75rem;
      opacity: 0;
      transition: all 0.2s ease;
    }

    .skill-row:hover .delete-row-btn {
      opacity: 1;
    }

    .delete-row-btn:hover {
      border-color: var(--danger);
      color: var(--danger);
      background: rgba(160, 64, 64, 0.1);
    }

    .skills-grid {
      display: flex;
      flex-wrap: wrap;
      gap: 0.625rem;
    }

    .skill-tag {
      display: flex;
      align-items: center;
      gap: 0.625rem;
      padding: 0.5rem 1rem;
      background: linear-gradient(135deg, var(--bg) 0%, rgba(26, 26, 24, 0.8) 100%);
      border: 1px solid var(--border);
      border-radius: 999px;
      font-size: 0.8125rem;
      color: var(--fg-muted);
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      position: relative;
      overflow: hidden;
    }

    .skill-tag::before {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(135deg, rgba(196, 169, 98, 0.1) 0%, transparent 50%);
      opacity: 0;
      transition: opacity 0.3s ease;
    }

    .skill-tag:hover {
      border-color: var(--gold);
      transform: translateY(-2px);
      box-shadow: 0 4px 12px rgba(196, 169, 98, 0.15);
    }

    .skill-tag:hover::before {
      opacity: 1;
    }

    .skill-tag .skill-icon {
      font-size: 1rem;
      color: var(--gold);
      position: relative;
      z-index: 1;
    }

    .skill-tag .skill-name {
      position: relative;
      z-index: 1;
    }

    .skill-tag .delete-skill {
      cursor: pointer;
      opacity: 0;
      width: 16px;
      height: 16px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 50%;
      background: transparent;
      transition: all 0.2s ease;
      position: relative;
      z-index: 1;
      margin-left: 0.25rem;
    }

    .skill-tag:hover .delete-skill {
      opacity: 0.5;
    }

    .skill-tag .delete-skill:hover {
      opacity: 1;
      color: var(--danger);
      background: rgba(160, 64, 64, 0.2);
    }

    .add-skill-inline {
      display: flex;
      gap: 0.625rem;
      margin-top: 1.25rem;
      padding-top: 1rem;
      border-top: 1px dashed var(--border-subtle);
    }

    .add-skill-inline input {
      flex: 1;
      padding: 0.625rem 1rem;
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: 6px;
      color: var(--fg);
      font-family: inherit;
      font-size: 0.8125rem;
      transition: all 0.2s ease;
    }

    .add-skill-inline input::placeholder {
      color: var(--fg-subtle);
    }

    .add-skill-inline input:focus {
      outline: none;
      border-color: var(--gold);
      box-shadow: 0 0 0 3px rgba(196, 169, 98, 0.1);
    }

    .add-skill-btn {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      padding: 0.625rem 1.25rem;
      background: linear-gradient(135deg, var(--gold) 0%, var(--gold-light) 100%);
      border: none;
      border-radius: 6px;
      color: var(--bg);
      cursor: pointer;
      font-family: inherit;
      font-size: 0.8125rem;
      font-weight: 500;
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      box-shadow: 0 2px 8px rgba(196, 169, 98, 0.3);
    }

    .add-skill-btn:hover {
      transform: translateY(-1px);
      box-shadow: 0 4px 12px rgba(196, 169, 98, 0.4);
    }

    .add-skill-btn:active {
      transform: translateY(0);
    }

    .add-skill-btn .btn-icon {
      font-size: 0.875rem;
    }

    .add-row-btn {
      margin-top: 1.25rem;
      padding: 1rem 1.5rem;
      background: transparent;
      border: 2px dashed var(--border);
      border-radius: 8px;
      color: var(--fg-subtle);
      cursor: pointer;
      font-family: inherit;
      font-size: 0.875rem;
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.75rem;
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .add-row-btn:hover {
      border-color: var(--gold);
      color: var(--gold);
      background: rgba(196, 169, 98, 0.05);
      transform: translateY(-2px);
    }

    .add-row-btn .btn-icon {
      font-size: 1.25rem;
      transition: transform 0.3s ease;
    }

    .add-row-btn:hover .btn-icon {
      transform: rotate(90deg);
    }

    /* ===== Projects ===== */
    .project-list {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    .project-card {
      background: var(--bg-subtle);
      border: 1px solid var(--border-subtle);
      border-radius: 8px;
      padding: 1.5rem;
      transition: all 0.3s ease;
    }

    .project-card:hover {
      border-color: var(--border);
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
    }

    .project-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 1rem;
    }

    .project-info {
      flex: 1;
    }

    .project-name {
      font-size: 1.125rem;
      color: var(--fg);
      margin-bottom: 0.5rem;
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }

    .project-name .project-icon {
      color: var(--gold);
      font-size: 1.25rem;
    }

    .project-description {
      font-size: 0.875rem;
      color: var(--fg-muted);
      line-height: 1.5;
    }

    .project-links {
      display: flex;
      gap: 0.5rem;
      margin-top: 1rem;
    }

    .project-link {
      display: flex;
      align-items: center;
      gap: 0.375rem;
      padding: 0.375rem 0.75rem;
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: 4px;
      color: var(--fg-subtle);
      font-size: 0.75rem;
      text-decoration: none;
      transition: all 0.2s ease;
    }

    .project-link:hover {
      border-color: var(--gold);
      color: var(--gold);
    }

    .project-stats {
      display: flex;
      gap: 1rem;
      margin-top: 1rem;
      padding-top: 1rem;
      border-top: 1px solid var(--border-subtle);
    }

    .project-stat {
      display: flex;
      align-items: center;
      gap: 0.375rem;
      font-size: 0.75rem;
      color: var(--fg-subtle);
    }

    .project-stat .stat-icon {
      color: var(--gold);
    }

    .project-actions {
      display: flex;
      gap: 0.5rem;
    }

    .project-action-btn {
      padding: 0.375rem 0.75rem;
      background: transparent;
      border: 1px solid var(--border);
      border-radius: 4px;
      color: var(--fg-subtle);
      cursor: pointer;
      font-size: 0.75rem;
      transition: all 0.2s ease;
    }

    .project-action-btn:hover {
      border-color: var(--gold);
      color: var(--gold);
    }

    .project-action-btn.danger:hover {
      border-color: var(--danger);
      color: var(--danger);
    }

    /* Add Project Form */
    .add-project-form {
      background: var(--bg-subtle);
      border: 2px dashed var(--border);
      border-radius: 8px;
      padding: 1.5rem;
      margin-bottom: 1.5rem;
    }

    .form-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1rem;
    }

    .form-group {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }

    .form-group.full-width {
      grid-column: 1 / -1;
    }

    .form-label {
      font-size: 0.75rem;
      color: var(--fg-subtle);
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .form-input {
      padding: 0.75rem 1rem;
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: 6px;
      color: var(--fg);
      font-family: inherit;
      font-size: 0.875rem;
      transition: all 0.2s ease;
    }

    .form-input::placeholder {
      color: var(--fg-subtle);
    }

    .form-input:focus {
      outline: none;
      border-color: var(--gold);
      box-shadow: 0 0 0 3px rgba(196, 169, 98, 0.1);
    }

    .form-textarea {
      min-height: 80px;
      resize: vertical;
    }

    .form-actions {
      display: flex;
      justify-content: flex-end;
      gap: 0.75rem;
      margin-top: 1.25rem;
      padding-top: 1rem;
      border-top: 1px solid var(--border-subtle);
    }

    .btn-secondary {
      padding: 0.625rem 1.25rem;
      background: transparent;
      border: 1px solid var(--border);
      border-radius: 6px;
      color: var(--fg-muted);
      cursor: pointer;
      font-family: inherit;
      font-size: 0.875rem;
      transition: all 0.2s ease;
    }

    .btn-secondary:hover {
      border-color: var(--fg-subtle);
      color: var(--fg);
    }

    .btn-primary {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.625rem 1.5rem;
      background: linear-gradient(135deg, var(--gold) 0%, var(--gold-light) 100%);
      border: none;
      border-radius: 6px;
      color: var(--bg);
      cursor: pointer;
      font-family: inherit;
      font-size: 0.875rem;
      font-weight: 500;
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      box-shadow: 0 2px 8px rgba(196, 169, 98, 0.3);
    }

    .btn-primary:hover {
      transform: translateY(-1px);
      box-shadow: 0 4px 12px rgba(196, 169, 98, 0.4);
    }

    .toggle-form-btn {
      margin-bottom: 1.5rem;
      padding: 0.875rem 1.5rem;
      background: transparent;
      border: 2px dashed var(--border);
      border-radius: 8px;
      color: var(--fg-subtle);
      cursor: pointer;
      font-family: inherit;
      font-size: 0.875rem;
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.75rem;
      transition: all 0.3s ease;
    }

    .toggle-form-btn:hover {
      border-color: var(--gold);
      color: var(--gold);
      background: rgba(196, 169, 98, 0.05);
    }

    .toggle-form-btn .btn-icon {
      font-size: 1.25rem;
      transition: transform 0.3s ease;
    }

    .toggle-form-btn:hover .btn-icon {
      transform: rotate(90deg);
    }

    /* ===== 空状态 & 加载 ===== */
    .empty-state {
      text-align: center;
      padding: 3rem 2rem;
      color: var(--fg-subtle);
    }

    .loading {
      text-align: center;
      padding: 2rem;
      color: var(--fg-subtle);
    }

    /* ===== 滚动条 ===== */
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }

    ::-webkit-scrollbar-track {
      background: transparent;
    }

    ::-webkit-scrollbar-thumb {
      background: var(--border);
      border-radius: 3px;
    }

    /* ===== 响应式 ===== */
    @media (max-width: 640px) {
      .container {
        padding: 1.5rem 1rem;
      }

      .tabs {
        gap: 1.25rem;
        overflow-x: auto;
      }

      .add-key-form {
        flex-direction: column;
      }
    }
  </style>
</head>
<body>
  <div class="container">
    <header>
      <div class="logo">SONNET ADMIN</div>
      <button class="logout-btn" onclick="logout()">Logout</button>
    </header>

    <nav class="tabs">
      <button class="tab active" data-panel="api-keys">API Keys</button>
      <button class="tab" data-panel="skills">Skills</button>
      <button class="tab" data-panel="projects">Projects</button>
      <button class="tab" data-panel="photos">Photos</button>
    </nav>

    <!-- API Keys Panel -->
    <div id="api-keys-panel" class="panel active">
      <h2>API Keys Management</h2>
      <form class="add-key-form" id="addKeyForm">
        <input type="text" id="keyName" placeholder="Key name (e.g., Obsidian Plugin)" required />
        <button type="submit" class="add-btn">Generate Key</button>
      </form>
      <div id="keyList" class="key-list">
        <div class="loading">Loading...</div>
      </div>
    </div>

    <!-- Skills Panel -->
    <div id="skills-panel" class="panel">
      <h2>Skills Management</h2>
      <div id="skillRows" class="skill-rows">
        <div class="loading">Loading...</div>
      </div>
      <button class="add-row-btn" onclick="addSkillRow()">
        <span class="iconify btn-icon" data-icon="lucide:plus"></span>
        <span>Add New Row</span>
      </button>
    </div>

    <!-- Projects Panel -->
    <div id="projects-panel" class="panel">
      <h2>Projects Management</h2>

      <button id="toggleProjectForm" class="toggle-form-btn" onclick="toggleProjectForm()">
        <span class="iconify btn-icon" data-icon="lucide:plus"></span>
        <span>Add New Project</span>
      </button>

      <div id="addProjectForm" class="add-project-form" style="display: none;">
        <div class="form-grid">
          <div class="form-group">
            <label class="form-label">Project Name</label>
            <input type="text" id="projectName" class="form-input" placeholder="My Awesome Project" />
          </div>
          <div class="form-group">
            <label class="form-label">Icon Class</label>
            <input type="text" id="projectIcon" class="form-input" placeholder="icon-[lucide--code]" />
          </div>
          <div class="form-group full-width">
            <label class="form-label">Description</label>
            <textarea id="projectDescription" class="form-input form-textarea" placeholder="A brief description of the project..."></textarea>
          </div>
          <div class="form-group">
            <label class="form-label">GitHub URL</label>
            <input type="text" id="projectGithub" class="form-input" placeholder="https://github.com/username/repo" />
          </div>
          <div class="form-group">
            <label class="form-label">Website URL</label>
            <input type="text" id="projectWebsite" class="form-input" placeholder="https://example.com" />
          </div>
          <div class="form-group">
            <label class="form-label">Stars</label>
            <input type="number" id="projectStars" class="form-input" placeholder="0" value="0" />
          </div>
          <div class="form-group">
            <label class="form-label">Forks</label>
            <input type="number" id="projectForks" class="form-input" placeholder="0" value="0" />
          </div>
        </div>
        <div class="form-actions">
          <button type="button" class="btn-secondary" onclick="toggleProjectForm()">Cancel</button>
          <button type="button" class="btn-primary" onclick="addProject()">
            <span class="iconify" data-icon="lucide:check"></span>
            <span>Save Project</span>
          </button>
        </div>
      </div>

      <div id="projectList" class="project-list">
        <div class="loading">Loading...</div>
      </div>
    </div>

    <!-- Photos Panel -->
    <div id="photos-panel" class="panel">
      <h2>Photos Management</h2>
      <div class="empty-state">
        <p>Photos management coming soon...</p>
        <p style="margin-top: 0.5rem; font-size: 0.75rem;">Upload and organize your photo albums</p>
      </div>
    </div>
  </div>

  <!-- New Key Modal -->
  <div id="newKeyModal" class="modal-overlay">
    <div class="modal">
      <h3>New API Key Created</h3>
      <p class="modal-warning">
        <strong>Important:</strong> Copy this key now. You won't be able to see it again!
      </p>
      <div id="newKeyDisplay" class="new-key-display"></div>
      <button class="modal-close" onclick="closeModal()">I've copied the key</button>
    </div>
  </div>

  <script>
    // 检查认证
    const token = localStorage.getItem('auth_token');
    if (!token) {
      window.location.href = '/fantay/login';
    }

    // API 请求辅助函数
    async function api(url, options = {}) {
      const res = await fetch(url, {
        ...options,
        headers: {
          'Content-Type': 'application/json',
          'Authorization': `Bearer ${token}`,
          ...options.headers,
        },
      });
      return res.json();
    }

    // 标签切换
    document.querySelectorAll('.tab').forEach(tab => {
      tab.addEventListener('click', () => {
        document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
        document.querySelectorAll('.panel').forEach(p => p.classList.remove('active'));
        tab.classList.add('active');
        document.getElementById(`${tab.dataset.panel}-panel`).classList.add('active');
      });
    });

    // 登出
    function logout() {
      localStorage.removeItem('auth_token');
      window.location.href = '/fantay/login';
    }

    // ========== API Keys ==========
    async function loadApiKeys() {
      const data = await api('/api/fantay/api-keys');
      const container = document.getElementById('keyList');

      if (!data.success || data.keys.length === 0) {
        container.innerHTML = '<div class="empty-state">No API keys yet. Create one above.</div>';
        return;
      }

      container.innerHTML = data.keys.map(key => `
        <div class="key-item">
          <div class="key-info">
            <div class="key-name">${key.name}</div>
            <div class="key-prefix">${key.keyPrefix}</div>
            <div class="key-meta">
              Created: ${new Date(key.createdAt).toLocaleDateString()}
              ${key.lastUsedAt ? ` · Last used: ${new Date(key.lastUsedAt).toLocaleDateString()}` : ''}
              · Permissions: ${key.permissions.join(', ')}
            </div>
          </div>
          <button class="delete-btn" onclick="deleteKey('${key.id}')">Delete</button>
        </div>
      `).join('');
    }

    document.getElementById('addKeyForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const name = document.getElementById('keyName').value;
      const data = await api('/api/fantay/api-keys', {
        method: 'POST',
        body: JSON.stringify({ name }),
      });

      if (data.success) {
        document.getElementById('newKeyDisplay').textContent = data.key;
        document.getElementById('newKeyModal').classList.add('show');
        document.getElementById('keyName').value = '';
        loadApiKeys();
      } else {
        alert(data.error || 'Failed to create key');
      }
    });

    async function deleteKey(id) {
      if (!confirm('Are you sure you want to delete this API key?')) return;
      await api(`/api/fantay/api-keys?id=${id}`, { method: 'DELETE' });
      loadApiKeys();
    }

    function closeModal() {
      document.getElementById('newKeyModal').classList.remove('show');
    }

    // ========== Skills ==========
    let skillsData = [];

    async function loadSkills() {
      const data = await api('/api/fantay/skills');
      const container = document.getElementById('skillRows');

      skillsData = data.skills || [];

      if (skillsData.length === 0) {
        container.innerHTML = '<div class="empty-state">No skill rows yet. Add one below.</div>';
        return;
      }

      container.innerHTML = skillsData.map((row, i) => `
        <div class="skill-row" data-row-id="${row.id}">
          <div class="skill-row-header">
            <span class="skill-row-title">Row ${i + 1} · Direction: ${row.direction}</span>
            <button class="delete-row-btn" onclick="deleteSkillRow('${row.id}')">
              <span class="iconify" data-icon="lucide:trash-2"></span> Delete Row
            </button>
          </div>
          <div class="skills-grid">
            ${row.skills.map(skill => `
              <div class="skill-tag">
                <span class="iconify skill-icon" data-icon="${skill.icon.replace('icon-[', '').replace(']', '').replace('--', ':')}"></span>
                <span class="skill-name">${skill.name}</span>
                <span class="delete-skill" onclick="deleteSkill('${row.id}', '${skill.id}')">
                  <span class="iconify" data-icon="lucide:x"></span>
                </span>
              </div>
            `).join('')}
          </div>
          <div class="add-skill-inline">
            <input type="text" placeholder="Skill name" id="name-${row.id}" />
            <input type="text" placeholder="Icon (e.g., lucide:code)" id="icon-${row.id}" />
            <button class="add-skill-btn" onclick="addSkill('${row.id}')">
              <span class="iconify btn-icon" data-icon="lucide:plus"></span>
              <span>Add</span>
            </button>
          </div>
        </div>
      `).join('');
    }

    async function addSkillRow() {
      const direction = skillsData.length % 2 === 0 ? 'left' : 'right';
      await api('/api/fantay/skills', {
        method: 'POST',
        body: JSON.stringify({ action: 'addRow', direction }),
      });
      loadSkills();
    }

    async function addSkill(rowId) {
      const nameInput = document.getElementById(`name-${rowId}`);
      const iconInput = document.getElementById(`icon-${rowId}`);
      const name = nameInput.value.trim();
      let icon = iconInput.value.trim();

      if (!name || !icon) {
        alert('Please enter both name and icon');
        return;
      }

      // 转换 iconify 格式为 icon-[] 格式
      if (icon.includes(':')) {
        icon = `icon-[${icon.replace(':', '--')}]`;
      }

      await api('/api/fantay/skills', {
        method: 'POST',
        body: JSON.stringify({ action: 'addSkill', rowId, skill: { name, icon } }),
      });

      nameInput.value = '';
      iconInput.value = '';
      loadSkills();
    }

    async function deleteSkill(rowId, skillId) {
      await api(`/api/fantay/skills?rowId=${rowId}&skillId=${skillId}`, { method: 'DELETE' });
      loadSkills();
    }

    async function deleteSkillRow(rowId) {
      if (!confirm('Delete this entire row and all its skills?')) return;
      await api(`/api/fantay/skills?rowId=${rowId}`, { method: 'DELETE' });
      loadSkills();
    }

    // ========== Projects ==========
    let projectsData = [];

    async function loadProjects() {
      const data = await api('/api/fantay/projects');
      const container = document.getElementById('projectList');

      projectsData = data.projects || [];

      if (projectsData.length === 0) {
        container.innerHTML = '<div class="empty-state">No projects yet. Add your first project above.</div>';
        return;
      }

      container.innerHTML = projectsData.map(project => `
        <div class="project-card" data-project-id="${project.id}">
          <div class="project-header">
            <div class="project-info">
              <div class="project-name">
                <span class="iconify project-icon" data-icon="${project.icon ? project.icon.replace('icon-[', '').replace(']', '').replace('--', ':') : 'lucide:folder'}"></span>
                <span>${project.name}</span>
                ${project.draft ? '<span style="font-size: 0.625rem; padding: 0.125rem 0.5rem; background: var(--border); border-radius: 999px; color: var(--fg-subtle);">Draft</span>' : ''}
              </div>
              <p class="project-description">${project.description || 'No description'}</p>
              <div class="project-links">
                ${project.githubUrl ? `
                  <a href="${project.githubUrl}" target="_blank" class="project-link">
                    <span class="iconify" data-icon="lucide:github"></span>
                    <span>GitHub</span>
                  </a>
                ` : ''}
                ${project.website ? `
                  <a href="${project.website}" target="_blank" class="project-link">
                    <span class="iconify" data-icon="lucide:external-link"></span>
                    <span>Website</span>
                  </a>
                ` : ''}
              </div>
              <div class="project-stats">
                <span class="project-stat">
                  <span class="iconify stat-icon" data-icon="lucide:star"></span>
                  <span>${project.star || 0}</span>
                </span>
                <span class="project-stat">
                  <span class="iconify stat-icon" data-icon="lucide:git-fork"></span>
                  <span>${project.fork || 0}</span>
                </span>
              </div>
            </div>
            <div class="project-actions">
              <button class="project-action-btn" onclick="editProject('${project.id}')">
                <span class="iconify" data-icon="lucide:edit-2"></span> Edit
              </button>
              <button class="project-action-btn danger" onclick="deleteProject('${project.id}')">
                <span class="iconify" data-icon="lucide:trash-2"></span>
              </button>
            </div>
          </div>
        </div>
      `).join('');
    }

    function toggleProjectForm() {
      const form = document.getElementById('addProjectForm');
      const btn = document.getElementById('toggleProjectForm');
      if (form.style.display === 'none') {
        form.style.display = 'block';
        btn.style.display = 'none';
      } else {
        form.style.display = 'none';
        btn.style.display = 'flex';
        clearProjectForm();
      }
    }

    function clearProjectForm() {
      document.getElementById('projectName').value = '';
      document.getElementById('projectIcon').value = '';
      document.getElementById('projectDescription').value = '';
      document.getElementById('projectGithub').value = '';
      document.getElementById('projectWebsite').value = '';
      document.getElementById('projectStars').value = '0';
      document.getElementById('projectForks').value = '0';
    }

    async function addProject() {
      const name = document.getElementById('projectName').value.trim();
      const icon = document.getElementById('projectIcon').value.trim();
      const description = document.getElementById('projectDescription').value.trim();
      const githubUrl = document.getElementById('projectGithub').value.trim();
      const website = document.getElementById('projectWebsite').value.trim();
      const star = parseInt(document.getElementById('projectStars').value) || 0;
      const fork = parseInt(document.getElementById('projectForks').value) || 0;

      if (!name) {
        alert('Project name is required');
        return;
      }

      const data = await api('/api/fantay/projects', {
        method: 'POST',
        body: JSON.stringify({
          name,
          icon: icon || 'icon-[lucide--folder]',
          description,
          githubUrl,
          website,
          star,
          fork,
          draft: false,
        }),
      });

      if (data.success) {
        toggleProjectForm();
        loadProjects();
      } else {
        alert(data.error || 'Failed to create project');
      }
    }

    async function deleteProject(id) {
      if (!confirm('Are you sure you want to delete this project?')) return;
      await api(`/api/fantay/projects?id=${id}`, { method: 'DELETE' });
      loadProjects();
    }

    async function editProject(id) {
      // 简单实现：找到项目，填充表单
      const project = projectsData.find(p => p.id === id);
      if (!project) return;

      document.getElementById('projectName').value = project.name || '';
      document.getElementById('projectIcon').value = project.icon || '';
      document.getElementById('projectDescription').value = project.description || '';
      document.getElementById('projectGithub').value = project.githubUrl || '';
      document.getElementById('projectWebsite').value = project.website || '';
      document.getElementById('projectStars').value = project.star || 0;
      document.getElementById('projectForks').value = project.fork || 0;

      // 显示表单
      document.getElementById('addProjectForm').style.display = 'block';
      document.getElementById('toggleProjectForm').style.display = 'none';

      // 先删除旧的，再添加新的
      await api(`/api/fantay/projects?id=${id}`, { method: 'DELETE' });
    }

    // 将函数挂载到 window 以便 onclick 调用
    window.logout = logout;
    window.closeModal = closeModal;
    window.deleteKey = deleteKey;
    window.addSkillRow = addSkillRow;
    window.addSkill = addSkill;
    window.deleteSkill = deleteSkill;
    window.deleteSkillRow = deleteSkillRow;
    window.toggleProjectForm = toggleProjectForm;
    window.addProject = addProject;
    window.deleteProject = deleteProject;
    window.editProject = editProject;

    // 初始化加载
    loadApiKeys();
    loadSkills();
    loadProjects();
  </script>
</body>
</html>
