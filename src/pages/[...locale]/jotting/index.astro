---
import Base from "$layouts/Base.astro";
import config from "$config";
import i18nit from "$i18n/index";
import { getCollection } from "astro:content";

export function getStaticPaths() {
  const locales = config.i18n.locales;
  const defaultLocale = config.i18n.defaultLocale;

  return locales.map((locale) => ({
    params: { locale: locale === defaultLocale ? undefined : locale },
    props: { locale },
  }));
}

const { locale } = Astro.props;
const t = i18nit(locale);

const basePath = locale === config.i18n.defaultLocale ? "" : `/${locale}`;

// Get all jottings for this locale
const jottings = await getCollection("jotting", (entry) => {
  const entryLocale = entry.id.split("/")[0];
  return entryLocale === locale && !entry.data.draft;
});

// Sort by timestamp descending
const sortedJottings = jottings.sort((a, b) => {
  if (a.data.top !== b.data.top) return b.data.top - a.data.top;
  return b.data.timestamp.getTime() - a.data.timestamp.getTime();
});

function formatDate(date: Date): string {
  return date.toLocaleDateString(locale === "zh-cn" ? "zh-CN" : "en-US", {
    year: "numeric",
    month: "short",
    day: "numeric",
  });
}

function getJottingPath(jotting: any): string {
  const id = jotting.id.split("/").slice(1).join("/").replace(/\.mdx?$/, "");
  return `${basePath}/jotting/${id}`;
}
---

<Base title={t("navigation.jotting")}>
  <div class="max-w-4xl mx-auto px-4 py-12">
    <header class="mb-12">
      <h1 class="category-name text-4xl mb-4">{t("navigation.jotting")}</h1>
      <p class="text-muted-foreground">
        {locale === "zh-cn" ? "零碎想法与日常记录" : "Random thoughts and daily records"}
      </p>
    </header>

    <div class="ink-list">
      {sortedJottings.map((jotting, index) => (
        <a
          href={getJottingPath(jotting)}
          class="ink-item"
          style={`--delay: ${Math.min(index, 8) * 0.06}s`}
        >
          <span class="ink-marker ink-marker-gold" aria-hidden="true"></span>

          <div class="ink-main">
            <h2 class="ink-title">{jotting.data.title}</h2>

            {jotting.data.description && (
              <p class="ink-desc">{jotting.data.description}</p>
            )}

            {jotting.data.tags && jotting.data.tags.length > 0 && (
              <div class="ink-tags">
                {jotting.data.tags.slice(0, 3).map((tag) => (
                  <span>#{tag}</span>
                ))}
              </div>
            )}
          </div>

          <time class="ink-meta">{formatDate(jotting.data.timestamp)}</time>
        </a>
      ))}
    </div>

    {sortedJottings.length === 0 && (
      <p class="text-center text-muted-foreground py-12">
        {t("home.heatmap.empty")}
      </p>
    )}
  </div>
</Base>
