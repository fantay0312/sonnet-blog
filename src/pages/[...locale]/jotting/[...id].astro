---
import Base from "$layouts/Base.astro";
import config from "$config";
import i18nit from "$i18n/index";
import { getCollection, render } from "astro:content";
import ProseEnhance from "$components/posts/ProseEnhance.astro";

export async function getStaticPaths() {
  const locales = config.i18n.locales;
  const defaultLocale = config.i18n.defaultLocale;
  const jottings = await getCollection("jotting");

  const paths = [];

  for (const jotting of jottings) {
    const [jottingLocale, ...idParts] = jotting.id.split("/");
    const id = idParts.join("/").replace(/\.mdx?$/, "");

    if (locales.includes(jottingLocale)) {
      const locale = jottingLocale === defaultLocale ? undefined : jottingLocale;
      paths.push({
        params: { locale, id },
        props: { jotting, locale: jottingLocale },
      });
    }
  }

  return paths;
}

const { jotting, locale } = Astro.props;
const t = i18nit(locale);

const basePath = locale === config.i18n.defaultLocale ? "" : `/${locale}`;

const { Content } = await render(jotting);

function formatDate(date: Date): string {
  return date.toLocaleDateString(locale === "zh-cn" ? "zh-CN" : "en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
}
---

<Base title={jotting.data.title} description={jotting.data.description}>
  <ProseEnhance />

  <article class="max-w-[46rem] mx-auto px-4 py-12">
    <!-- Header -->
    <header class="mb-8">
      <div class="flex items-center gap-4 mb-4 text-sm text-muted-foreground">
        <a href={`${basePath}/jotting`} class="hover:text-foreground transition-colors">
          {t("navigation.jotting")}
        </a>
        <span>/</span>
        <time>{formatDate(jotting.data.timestamp)}</time>
      </div>

      <h1 class="text-2xl md:text-3xl font-bold mb-4">{jotting.data.title}</h1>

      {jotting.data.tags && jotting.data.tags.length > 0 && (
        <div class="flex flex-wrap gap-2">
          {jotting.data.tags.map((tag) => (
            <span class="text-sm px-3 py-1 bg-muted rounded-full text-muted-foreground">
              #{tag}
            </span>
          ))}
        </div>
      )}
    </header>

    <!-- Content -->
    <div class="prose prose-article">
      <Content />
    </div>

    <!-- Footer -->
    <footer class="mt-14">
      <!-- 文末留白：一线一菱，如卷轴收笔 -->
      <div class="end-mark" aria-hidden="true">
        <span class="end-line"></span>
        <span class="end-diamond"></span>
        <span class="end-line"></span>
      </div>

      <div class="mt-8 flex flex-wrap items-center justify-between gap-4">
        <a href={`${basePath}/jotting`} class="back-link">
          <span class="back-arrow icon-[lucide--arrow-left] w-3.5 h-3.5" />
          {locale === "zh-cn" ? `返回${t("navigation.jotting")}` : "Back to Jottings"}
        </a>

        <time class="text-sm text-muted-foreground opacity-75">
          {formatDate(jotting.data.timestamp)}
        </time>
      </div>
    </footer>
  </article>
</Base>

<style>
  /* 文末收笔装饰 */
  .end-mark {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
  }

  .end-line {
    width: 4.5rem;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--zen-border));
  }

  .end-line:last-child {
    background: linear-gradient(90deg, var(--zen-border), transparent);
  }

  .end-diamond {
    width: 7px;
    height: 7px;
    transform: rotate(45deg);
    border-radius: 1px;
    background: color-mix(in srgb, var(--zen-gold) 75%, transparent);
  }

  /* 返回链接：墨色药丸按钮 */
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 1.1rem;
    border: 1px solid color-mix(in srgb, var(--zen-border) 85%, transparent);
    border-radius: 9999px;
    font-family: "LXGW WenKai", "霞鹜文楷", "Kaiti SC", "STKaiti", "楷体", var(--font-serif);
    font-size: 0.875rem;
    letter-spacing: 0.08em;
    color: var(--zen-muted-foreground);
    background: color-mix(in srgb, var(--zen-block) 55%, transparent);
    transition:
      color var(--dur-fast) ease,
      border-color var(--dur-fast) ease,
      background-color var(--dur-fast) ease,
      transform var(--dur-fast) var(--ease-out-quad);
  }

  .back-link:hover,
  .back-link:focus-visible {
    color: var(--color-accent);
    border-color: color-mix(in srgb, var(--color-accent) 45%, transparent);
    background: color-mix(in srgb, var(--color-accent) 8%, transparent);
  }

  /* 按压内收：被感知而非被看见 */
  .back-link:active {
    transform: scale(0.97);
  }

  /* 箭头在内层子元素上位移，父级留在光标下，不会抖 */
  .back-arrow {
    transition: transform var(--dur-base) var(--ease-out-expo);
  }

  .back-link:hover .back-arrow,
  .back-link:focus-visible .back-arrow {
    transform: translateX(-3px);
  }

  @media (prefers-reduced-motion: reduce) {
    .back-link,
    .back-arrow {
      transition-property: color, border-color, background-color;
    }
    .back-link:active,
    .back-link:hover .back-arrow,
    .back-link:focus-visible .back-arrow {
      transform: none;
    }
  }
</style>
