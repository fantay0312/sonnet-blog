---
import Base from "$layouts/Base.astro";
import config from "$config";
import i18nit from "$i18n/index";
import { getCollection, render } from "astro:content";
import LatestContent from "$components/home/LatestContent.astro";
import BlogContributions from "$components/home/BlogContributions.astro";
import SkillsShowcase from "$components/home/SkillsShowcase.astro";
import PoeticQuotes from "$components/home/PoeticQuotes.astro";

export function getStaticPaths() {
  const locales = config.i18n.locales;
  const defaultLocale = config.i18n.defaultLocale;

  return locales.map((locale) => ({
    params: { locale: locale === defaultLocale ? undefined : locale },
    props: { locale },
  }));
}

const { locale } = Astro.props;
const t = i18nit(locale);

// Get preface content
const prefaceEntries = await getCollection("preface", (entry) => {
  const entryLocale = entry.id.split("/")[0];
  return entryLocale === locale;
});

const latestPreface = prefaceEntries.sort(
  (a, b) => b.data.timestamp.getTime() - a.data.timestamp.getTime()
)[0];

let PrefaceContent: any = null;
if (latestPreface) {
  const rendered = await render(latestPreface);
  PrefaceContent = rendered.Content;
}

// Get latest content
const notes = await getCollection("note", (entry) => {
  const entryLocale = entry.id.split("/")[0];
  return entryLocale === locale && !entry.data.draft;
});

const jottings = await getCollection("jotting", (entry) => {
  const entryLocale = entry.id.split("/")[0];
  return entryLocale === locale && !entry.data.draft;
});

const allContent = [...notes, ...jottings].sort(
  (a, b) => b.data.timestamp.getTime() - a.data.timestamp.getTime()
);

const latestItems = allContent.slice(0, 5);
---

<Base>
  <div class="max-w-4xl mx-auto px-4 py-6">
    <!-- Title with ethereal effects -->
    <section class="title-section text-center mb-2 relative">
      <!-- 标题光晕背景 -->
      <div class="title-glow" aria-hidden="true"></div>
      <div class="title-glow-secondary" aria-hidden="true"></div>
      
      <!-- 主标题 -->
      <h1 class="main-title font-calligraphy text-4xl md:text-6xl text-foreground relative">
        <span class="title-text">{config.title}</span>
      </h1>
      
      <!-- 副标题装饰线 -->
      <div class="title-decoration" aria-hidden="true">
        <span class="deco-line left"></span>
        <span class="deco-dot"></span>
        <span class="deco-line right"></span>
      </div>
    </section>

    <style>
      .title-section {
        padding: 0.5rem 0;
        overflow: visible;
      }

      /* ===== 首屏编排（只在硬刷新时演出一次；站内导航由页面级过渡负责）=====
         标题先落定（0s，位移最大），装饰线随后从墨点向两侧写开（0.25s），
         诗句在 PoeticQuotes 里接着浮现（0.35s+）。重要度越低，出场越晚、位移越小。 */

      /* 主光晕 - 呼吸效果：与墨点共用同一 6s 呼吸节律，读作一次吐纳 */
      .title-glow {
        position: absolute;
        top: 50%;
        left: 50%;
        width: 300px;
        height: 150px;
        background: radial-gradient(
          ellipse at center,
          var(--zen-accent) 0%,
          transparent 70%
        );
        transform: translate(-50%, -50%);
        filter: blur(60px);
        opacity: 0.25;
        animation: glow-breathe 6s var(--ease-in-out) infinite;
        pointer-events: none;
      }

      .title-glow-secondary {
        position: absolute;
        top: 50%;
        left: 50%;
        width: 200px;
        height: 100px;
        background: radial-gradient(
          ellipse at center,
          var(--zen-gold) 0%,
          transparent 70%
        );
        transform: translate(-50%, -50%);
        filter: blur(40px);
        opacity: 0.15;
        animation: glow-breathe 6s var(--ease-in-out) -3s infinite;
        pointer-events: none;
      }

      @keyframes glow-breathe {
        0%, 100% {
          opacity: 0.15;
          transform: translate(-50%, -50%) scale(1);
        }
        50% {
          opacity: 0.28;
          transform: translate(-50%, -50%) scale(1.12);
        }
      }

      /* 主标题：一次性浮现落定；不再常驻上下漂浮——持续移动的文字难读，也让整页显得躁 */
      .main-title {
        position: relative;
        z-index: 1;
        animation: title-settle var(--dur-reveal) var(--ease-out) both;
      }

      @keyframes title-settle {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
      }

      /* 墨色微光：以墨为主，竹青只是掠过纸面的一抹光，慢到几乎察觉不到 */
      .title-text {
        display: inline-block;
        background: linear-gradient(
          135deg,
          var(--color-foreground) 0%,
          var(--color-foreground) 35%,
          var(--zen-accent) 50%,
          var(--color-foreground) 65%,
          var(--color-foreground) 100%
        );
        background-size: 200% 200%;
        -webkit-background-clip: text;
        background-clip: text;
        -webkit-text-fill-color: transparent;
        animation: shimmer 12s var(--ease-in-out) infinite;
        text-shadow: none;
      }

      @keyframes shimmer {
        0%, 100% {
          background-position: 0% 50%;
        }
        50% {
          background-position: 100% 50%;
        }
      }

      /* 装饰线 */
      .title-decoration {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 1rem;
        margin-top: 1rem;
        opacity: 0.6;
      }

      /* 两侧横线从中央墨点向外写开：固定宽度，只动 scaleX（不再动 width 触发布局） */
      .deco-line {
        display: block;
        width: 60px;
        height: 1px;
        background: linear-gradient(
          90deg,
          transparent,
          var(--zen-accent),
          transparent
        );
        transform: scaleX(0);
        animation: line-extend 0.9s var(--ease-out) 0.25s both;
      }

      .deco-line.left {
        transform-origin: right center;
      }

      .deco-line.right {
        transform-origin: left center;
      }

      @keyframes line-extend {
        from { transform: scaleX(0); opacity: 0; }
        to { transform: scaleX(1); opacity: 1; }
      }

      /* 中央墨点：先随标题落定，之后与光晕同频呼吸（不再 3s 一跳的节拍器） */
      .deco-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--zen-accent);
        animation:
          dot-settle var(--dur-reveal) var(--ease-out) 0.15s both,
          dot-breathe 6s var(--ease-in-out) 0.8s infinite;
      }

      @keyframes dot-settle {
        from { opacity: 0; transform: scale(0.6); }
        to { opacity: 0.55; transform: scale(1); }
      }

      @keyframes dot-breathe {
        0%, 100% { opacity: 0.55; transform: scale(1); }
        50% { opacity: 0.85; transform: scale(1.15); }
      }

      /* 深色模式 */
      :global(.dark) .title-glow {
        opacity: 0.20;
      }

      :global(.dark) .title-glow-secondary {
        opacity: 0.12;
      }

      /* 站内导航后：首屏入场不重演 */
      :global(html.vt-nav) .main-title,
      :global(html.vt-nav) .deco-line {
        animation: none;
        transform: none;
        opacity: 1;
      }

      :global(html.vt-nav) .deco-dot {
        animation: dot-breathe 6s var(--ease-in-out) infinite;
        opacity: 0.55;
      }

      @media (prefers-reduced-motion: reduce) {
        .title-glow,
        .title-glow-secondary,
        .main-title,
        .title-text,
        .deco-line,
        .deco-dot {
          animation: none;
        }
        .main-title {
          opacity: 1;
          transform: none;
        }
        .title-glow {
          opacity: 0.2;
        }
        .deco-line {
          transform: none;
          opacity: 1;
        }
        .deco-dot {
          opacity: 0.55;
        }
      }
    </style>

    <!-- Poetic Quotes - 诗意诗词展示 -->
    <section class="mb-8">
      <PoeticQuotes />
    </section>

    <!-- Preface Content - 仙气序言：无边框，文字浮于纸面 -->
    {PrefaceContent && (
      <section class="mb-12">
        <h2 class="category-name text-2xl mb-6">{t("home.prologue")}</h2>
        <div class="preface-realm relative px-1 md:px-8">
          <!-- 水墨晕染 -->
          <div class="preface-wash" aria-hidden="true"></div>
          <!-- 漂浮墨点 -->
          {Array.from({ length: 4 }).map(() => (
            <span
              class="preface-dot"
              aria-hidden="true"
              style={`--x: ${8 + Math.random() * 84}%; --y: ${10 + Math.random() * 80}%; --size: ${2 + Math.random() * 2.5}px; --duration: ${14 + Math.random() * 10}s; --delay: ${Math.random() * 7}s;`}
            ></span>
          ))}

          <div class="preface-prose prose max-w-none relative z-10">
            <PrefaceContent />
          </div>
        </div>
      </section>
    )}

    <style>
      /* 水墨晕染背景 */
      .preface-wash {
        position: absolute;
        inset: -12% -4%;
        pointer-events: none;
        background:
          radial-gradient(ellipse 65% 55% at 22% 28%, color-mix(in srgb, var(--zen-accent) 6%, transparent), transparent 62%),
          radial-gradient(ellipse 55% 45% at 82% 72%, color-mix(in srgb, var(--zen-gold) 5%, transparent), transparent 62%);
      }

      /* 漂浮墨点 */
      .preface-dot {
        position: absolute;
        left: var(--x);
        top: var(--y);
        width: var(--size);
        height: var(--size);
        border-radius: 50%;
        background: var(--zen-gold);
        opacity: 0;
        pointer-events: none;
        animation: preface-dot-drift var(--duration) ease-in-out var(--delay) infinite;
      }

      @keyframes preface-dot-drift {
        0%, 100% { opacity: 0; transform: translate(0, 0); }
        30% { opacity: 0.18; }
        50% { opacity: 0.26; transform: translate(-12px, -20px); }
        70% { opacity: 0.12; }
      }

      /* 序言正文：楷体书写，逐段浮现。
         开篇句走得最远、最先到；后面几段位移递减，末段几乎只是淡入 */
      .preface-prose :global(p) {
        font-family: "LXGW WenKai", "霞鹜文楷", "Kaiti SC", "STKaiti", "楷体", var(--font-serif);
        font-size: 1.0625rem;
        line-height: 2.2;
        letter-spacing: 0.045em;
        color: color-mix(in srgb, var(--zen-foreground) 88%, transparent);
        margin: 0 0 1.05em;
        text-wrap: pretty;
        opacity: 0;
        --rise: 6px;
        animation: preface-rise var(--dur-reveal) var(--ease-out) forwards;
      }

      /* 开篇句：稍大、墨色更重 */
      .preface-prose :global(p:first-child) {
        font-size: 1.3125rem;
        letter-spacing: 0.08em;
        color: var(--zen-foreground);
      }

      .preface-prose :global(p:nth-child(1)) { --rise: 12px; animation-delay: 0.45s; }
      .preface-prose :global(p:nth-child(2)) { --rise: 10px; animation-delay: 0.55s; }
      .preface-prose :global(p:nth-child(3)) { --rise: 8px;  animation-delay: 0.65s; }
      .preface-prose :global(p:nth-child(4)) { --rise: 6px;  animation-delay: 0.75s; }
      .preface-prose :global(p:nth-child(5)) { --rise: 4px;  animation-delay: 0.85s; }
      .preface-prose :global(p:nth-child(n+6)) { --rise: 2px; animation-delay: 0.95s; }

      @keyframes preface-rise {
        from { opacity: 0; transform: translateY(var(--rise, 6px)); }
        to { opacity: 1; transform: translateY(0); }
      }

      /* 站内导航后不重演入场 */
      :global(html.vt-nav) .preface-prose :global(p) {
        animation: none;
        opacity: 1;
      }

      @media (prefers-reduced-motion: reduce) {
        .preface-prose :global(p) {
          animation: none;
          opacity: 1;
        }
        .preface-dot {
          animation: none;
        }
      }
    </style>

    <!-- Skills Showcase -->
    {config.skills.enabled && (
      <section class="mb-10">
        <h2 class="category-name text-2xl mb-4">{t("home.skills")}</h2>
        <SkillsShowcase skills={config.skills.data} />
      </section>
    )}

    <!-- 博客动态热力图 -->
    <section class="mb-10">
      <h2 class="category-name text-2xl mb-4">{t("home.spotlight")}</h2>
      <BlogContributions locale={locale} />
    </section>

    <!-- Latest Content -->
    <section class="mb-6">
      <h2 class="category-name text-2xl mb-4">{t("home.latest")}</h2>
      <LatestContent items={latestItems} locale={locale} />
    </section>
  </div>
</Base>
