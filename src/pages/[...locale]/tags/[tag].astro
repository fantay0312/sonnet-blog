---
/**
 * 单个标签页面 - 显示该标签下的所有文章
 */
import Base from "$layouts/Base.astro";
import config from "$config";
import i18nit from "$i18n/index";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const locales = config.i18n.locales;
  const defaultLocale = config.i18n.defaultLocale;

  const paths = [];

  for (const locale of locales) {
    // 获取该语言的所有文章
    const notes = await getCollection("note", (entry) => {
      const entryLocale = entry.id.split("/")[0];
      return entryLocale === locale && !entry.data.draft;
    });

    const jottings = await getCollection("jotting", (entry) => {
      const entryLocale = entry.id.split("/")[0];
      return entryLocale === locale && !entry.data.draft;
    });

    // 收集所有标签
    const tags = new Set<string>();
    for (const post of [...notes, ...jottings]) {
      for (const tag of post.data.tags || []) {
        tags.add(tag);
      }
    }

    // 为每个标签创建路径
    for (const tag of tags) {
      paths.push({
        params: {
          locale: locale === defaultLocale ? undefined : locale,
          tag,
        },
        props: { locale, tag },
      });
    }
  }

  return paths;
}

const { locale, tag } = Astro.props;
const t = i18nit(locale);
const basePath = locale === config.i18n.defaultLocale ? "" : `/${locale}`;

// 获取该标签下的所有文章
const notes = await getCollection("note", (entry) => {
  const entryLocale = entry.id.split("/")[0];
  return entryLocale === locale && !entry.data.draft && entry.data.tags?.includes(tag);
});

const jottings = await getCollection("jotting", (entry) => {
  const entryLocale = entry.id.split("/")[0];
  return entryLocale === locale && !entry.data.draft && entry.data.tags?.includes(tag);
});

// 合并并按时间排序
const allPosts = [...notes, ...jottings].sort(
  (a, b) => b.data.timestamp.getTime() - a.data.timestamp.getTime()
);

function formatDate(date: Date): string {
  return date.toLocaleDateString(locale === "zh-cn" ? "zh-CN" : "en-US", {
    year: "numeric",
    month: "short",
    day: "numeric",
  });
}

function getPostPath(post: any): string {
  const collection = post.collection;
  const id = post.id.split("/").slice(1).join("/").replace(/\.mdx?$/, "");
  return `${basePath}/${collection}/${id}`;
}
---

<Base title={`#${tag}`}>
  <div class="max-w-4xl mx-auto px-4 py-12">
    <header class="mb-10">
      <a
        href={`${basePath}/tags`}
        class="zen-tag-btn inline-flex items-center gap-2 text-sm text-muted-foreground hover:text-accent mb-5 transition-colors duration-300"
      >
        <span class="icon-[lucide--arrow-left] w-4 h-4" />
        {locale === "zh-cn" ? "所有标签" : "All Tags"}
      </a>

      <h1 class="category-name text-4xl mb-3 flex items-baseline gap-2">
        <span class="text-accent opacity-70">#</span>
        <span>{tag}</span>
      </h1>
      <p class="text-sm text-muted-foreground">
        {locale === "zh-cn"
          ? `共 ${allPosts.length} 篇文章`
          : `${allPosts.length} posts`}
      </p>
    </header>

    {allPosts.length > 0 ? (
      <div class="ink-list">
        {allPosts.map((post, index) => (
          <a
            href={getPostPath(post)}
            class="ink-item"
            style={`--delay: ${Math.min(index, 8) * 0.06}s`}
          >
            <span
              class:list={[
                "ink-marker",
                post.collection === "jotting" && "ink-marker-gold",
              ]}
              aria-hidden="true"
            ></span>

            <div class="ink-main">
              <h3 class="ink-title">{post.data.title}</h3>
              {post.data.description && (
                <p class="ink-desc">{post.data.description}</p>
              )}
            </div>

            <div class="ink-meta flex items-baseline gap-3">
              <time>{formatDate(post.data.timestamp)}</time>
              <span class={post.collection === "note" ? "cat-note" : "cat-jotting"}>
                「{post.collection === "note" ? t("navigation.note") : t("navigation.jotting")}」
              </span>
            </div>
          </a>
        ))}
      </div>
    ) : (
      <p class="text-center text-muted-foreground py-12">
        {locale === "zh-cn" ? "该标签下暂无文章" : "No posts with this tag"}
      </p>
    )}
  </div>
</Base>

<style>
  .cat-note {
    color: var(--zen-accent);
    opacity: 0.85;
  }

  .cat-jotting {
    color: var(--zen-gold);
    opacity: 0.85;
  }
</style>
