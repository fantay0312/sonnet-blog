---
/**
 * 标签列表页面
 */
import Base from "$layouts/Base.astro";
import config from "$config";
import i18nit from "$i18n/index";
import { getCollection } from "astro:content";

export function getStaticPaths() {
  const locales = config.i18n.locales;
  const defaultLocale = config.i18n.defaultLocale;

  return locales.map((locale) => ({
    params: { locale: locale === defaultLocale ? undefined : locale },
    props: { locale },
  }));
}

const { locale } = Astro.props;
const t = i18nit(locale);
const basePath = locale === config.i18n.defaultLocale ? "" : `/${locale}`;

// 获取所有文章
const notes = await getCollection("note", (entry) => {
  const entryLocale = entry.id.split("/")[0];
  return entryLocale === locale && !entry.data.draft;
});

const jottings = await getCollection("jotting", (entry) => {
  const entryLocale = entry.id.split("/")[0];
  return entryLocale === locale && !entry.data.draft;
});

// 统计标签
const tagMap = new Map<string, number>();

for (const post of [...notes, ...jottings]) {
  const tags = post.data.tags || [];
  for (const tag of tags) {
    tagMap.set(tag, (tagMap.get(tag) || 0) + 1);
  }
}

// 按数量排序
const sortedTags = Array.from(tagMap.entries()).sort((a, b) => b[1] - a[1]);
const maxCount = Math.max(...sortedTags.map(([, count]) => count), 1);
---

<Base title={locale === "zh-cn" ? "标签" : "Tags"}>
  <div class="max-w-4xl mx-auto px-4 py-12">
    <header class="mb-10">
      <h1 class="category-name text-4xl mb-3">
        {locale === "zh-cn" ? "标签" : "Tags"}
      </h1>
      <p class="text-sm text-muted-foreground">
        {locale === "zh-cn"
          ? `共 ${sortedTags.length} 个标签`
          : `${sortedTags.length} tags in total`}
      </p>
    </header>

    {sortedTags.length > 0 ? (
      <div class="tags-cloud flex flex-wrap items-baseline gap-x-8 gap-y-5">
        {sortedTags.map(([tag, count], index) => {
          // 根据数量计算大小与墨色深浅
          const ratio = count / maxCount;
          const fontSize = 1 + ratio * 0.5; // 1rem - 1.5rem
          const opacity = 0.55 + ratio * 0.4;

          return (
            <a
              href={`${basePath}/tags/${tag}`}
              class="tag-item"
              style={`font-size: ${fontSize}rem; --ink: ${opacity}; --delay: ${Math.min(index, 12) * 0.05}s`}
            >
              <span class="tag-hash" aria-hidden="true">#</span><span class="tag-name">{tag}</span><sup class="tag-count">{count}</sup>
            </a>
          );
        })}
      </div>
    ) : (
      <p class="text-center text-muted-foreground py-12">
        {locale === "zh-cn" ? "暂无标签" : "No tags yet"}
      </p>
    )}
  </div>
</Base>

<style>
  /* 水墨标签云：无边框，墨色随热度深浅 */
  .tag-item {
    font-family: "LXGW WenKai", "霞鹜文楷", "Kaiti SC", "STKaiti", "楷体", var(--font-serif);
    letter-spacing: 0.04em;
    line-height: 1.6;
    color: color-mix(in srgb, var(--zen-foreground) calc(var(--ink, 0.8) * 100%), transparent);
    background-image: linear-gradient(90deg, var(--zen-accent), var(--zen-gold));
    background-size: 0% 1px;
    background-repeat: no-repeat;
    background-position: 0 100%;
    padding-bottom: 2px;
    opacity: 0;
    animation: tag-rise var(--dur-reveal) var(--ease-out) forwards;
    animation-delay: var(--delay, 0s);
    transition:
      background-size var(--dur-slow) var(--ease-out-expo),
      color var(--dur-base) ease;
  }

  @keyframes tag-rise {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* 站内导航后不重演入场 */
  :global(html.vt-nav) .tag-item {
    animation: none;
    opacity: 1;
  }

  .tag-item:hover,
  .tag-item:focus-visible {
    color: var(--zen-foreground);
    background-size: 100% 1px;
  }

  .tag-hash {
    color: var(--color-accent);
    opacity: 0.6;
    margin-right: 0.1em;
  }

  .tag-count {
    font-size: 0.66em;
    color: var(--zen-gold);
    opacity: 0.8;
    margin-left: 0.3em;
    font-variant-numeric: tabular-nums;
  }

  @media (prefers-reduced-motion: reduce) {
    .tag-item {
      animation: none;
      opacity: 1;
    }
  }
</style>
