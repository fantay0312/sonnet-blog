---
import Base from "$layouts/Base.astro";
import config from "$config";
import i18nit from "$i18n/index";
import { getCollection } from "astro:content";

export function getStaticPaths() {
  const locales = config.i18n.locales;
  const defaultLocale = config.i18n.defaultLocale;

  return locales.map((locale) => ({
    params: { locale: locale === defaultLocale ? undefined : locale },
    props: { locale },
  }));
}

const { locale } = Astro.props;
const t = i18nit(locale);

const basePath = locale === config.i18n.defaultLocale ? "" : `/${locale}`;

// Get all notes for this locale
const notes = await getCollection("note", (entry) => {
  const entryLocale = entry.id.split("/")[0];
  return entryLocale === locale && !entry.data.draft;
});

// Sort by timestamp descending, then by top priority
const sortedNotes = notes.sort((a, b) => {
  if (a.data.top !== b.data.top) return b.data.top - a.data.top;
  return b.data.timestamp.getTime() - a.data.timestamp.getTime();
});

function formatDate(date: Date): string {
  return date.toLocaleDateString(locale === "zh-cn" ? "zh-CN" : "en-US", {
    year: "numeric",
    month: "short",
    day: "numeric",
  });
}

function getNotePath(note: any): string {
  const id = note.id.split("/").slice(1).join("/").replace(/\.mdx?$/, "");
  return `${basePath}/note/${id}`;
}
---

<Base title={t("navigation.note")}>
  <div class="max-w-4xl mx-auto px-4 py-12">
    <header class="mb-12">
      <h1 class="category-name text-4xl mb-4">{t("navigation.note")}</h1>
      <p class="text-muted-foreground">
        {locale === "zh-cn" ? "深度文章与技术笔记" : "In-depth articles and technical notes"}
      </p>
    </header>

    <div class="space-y-6">
      {sortedNotes.map((note) => (
        <article class="group">
          <a
            href={getNotePath(note)}
            class="block p-6 bg-block rounded-lg border border-border hover:border-accent transition-colors"
          >
            <div class="flex items-start justify-between gap-4 mb-3">
              <h2 class="text-xl font-medium text-foreground group-hover:text-accent transition-colors">
                {note.data.top > 0 && (
                  <span class="inline-block mr-2 text-accent">
                    <span class="icon-[lucide--pin] w-4 h-4" />
                  </span>
                )}
                {note.data.title}
              </h2>
              <time class="text-sm text-muted-foreground shrink-0">
                {formatDate(note.data.timestamp)}
              </time>
            </div>

            {note.data.description && (
              <p class="text-muted-foreground mb-4 line-clamp-2">
                {note.data.description}
              </p>
            )}

            <div class="flex items-center gap-4">
              {note.data.series && (
                <span class="text-xs px-2 py-1 bg-muted rounded-full text-muted-foreground">
                  {note.data.series}
                </span>
              )}
              {note.data.tags && note.data.tags.length > 0 && (
                <div class="flex gap-2">
                  {note.data.tags.slice(0, 3).map((tag) => (
                    <span class="text-xs text-muted-foreground">#{tag}</span>
                  ))}
                </div>
              )}
            </div>
          </a>
        </article>
      ))}

      {sortedNotes.length === 0 && (
        <p class="text-center text-muted-foreground py-12">
          {t("home.heatmap.empty")}
        </p>
      )}
    </div>
  </div>
</Base>
