---
import Base from "$layouts/Base.astro";
import config from "$config";
import i18nit from "$i18n/index";
import { getCollection } from "astro:content";
import TagFilter from "$components/posts/TagFilter";

export function getStaticPaths() {
  const locales = config.i18n.locales;
  const defaultLocale = config.i18n.defaultLocale;

  return locales.map((locale) => ({
    params: { locale: locale === defaultLocale ? undefined : locale },
    props: { locale },
  }));
}

const { locale } = Astro.props;
const t = i18nit(locale);

const basePath = locale === config.i18n.defaultLocale ? "" : `/${locale}`;

// Get all notes for this locale
const notes = await getCollection("note", (entry) => {
  const entryLocale = entry.id.split("/")[0];
  return entryLocale === locale && !entry.data.draft;
});

// Sort by timestamp descending, then by top priority
const sortedNotes = notes.sort((a, b) => {
  if (a.data.top !== b.data.top) return (b.data.top || 0) - (a.data.top || 0);
  return b.data.timestamp.getTime() - a.data.timestamp.getTime();
});

// 转换为 TagFilter 组件需要的格式
const postsData = sortedNotes.map((note) => {
  const id = note.id.split("/").slice(1).join("/").replace(/\.mdx?$/, "");
  return {
    id: note.id,
    title: note.data.title,
    description: note.data.description,
    timestamp: note.data.timestamp.toISOString(),
    tags: note.data.tags || [],
    series: note.data.series,
    top: note.data.top || 0,
    path: `${basePath}/note/${id}`,
  };
});
---

<Base title={t("navigation.note")}>
  <div class="max-w-4xl mx-auto px-4 py-12 xl:mr-64">
    <header class="mb-12">
      <h1 class="category-name text-4xl mb-4">{t("navigation.note")}</h1>
      <p class="text-muted-foreground">
        {locale === "zh-cn" ? "深度文章与技术笔记" : "In-depth articles and technical notes"}
      </p>
    </header>

    <TagFilter
      client:load
      posts={postsData}
      locale={locale}
      allTagsLabel={locale === "zh-cn" ? "全部文章" : "All Posts"}
      noResultsLabel={locale === "zh-cn" ? "暂无相关文章" : "No posts found"}
    />
  </div>
</Base>

<style>
  /* 悬浮标签面板定位 */
  .floating-tags {
    right: max(calc((100vw - 56rem) / 2 - 240px), 20px);
  }

  /* 滚动条样式 */
  .floating-tags::-webkit-scrollbar {
    width: 4px;
  }

  .floating-tags::-webkit-scrollbar-thumb {
    background: var(--zen-stone);
    border-radius: 2px;
  }

  .floating-tags::-webkit-scrollbar-track {
    background: transparent;
  }
</style>
