---
/**
 * 归档页面 - 按年月分组展示所有文章
 */
import Base from "$layouts/Base.astro";
import config from "$config";
import i18nit from "$i18n/index";
import { getCollection } from "astro:content";

export function getStaticPaths() {
  const locales = config.i18n.locales;
  const defaultLocale = config.i18n.defaultLocale;

  return locales.map((locale) => ({
    params: { locale: locale === defaultLocale ? undefined : locale },
    props: { locale },
  }));
}

const { locale } = Astro.props;
const t = i18nit(locale);
const basePath = locale === config.i18n.defaultLocale ? "" : `/${locale}`;

// 获取所有文章
const notes = await getCollection("note", (entry) => {
  const entryLocale = entry.id.split("/")[0];
  return entryLocale === locale && !entry.data.draft;
});

const jottings = await getCollection("jotting", (entry) => {
  const entryLocale = entry.id.split("/")[0];
  return entryLocale === locale && !entry.data.draft;
});

// 合并并按时间排序
const allPosts = [...notes, ...jottings].sort(
  (a, b) => b.data.timestamp.getTime() - a.data.timestamp.getTime()
);

// 按年月分组
interface PostGroup {
  year: number;
  months: Map<number, any[]>;
}

const archiveMap = new Map<number, Map<number, any[]>>();

for (const post of allPosts) {
  const date = post.data.timestamp;
  const year = date.getFullYear();
  const month = date.getMonth() + 1;

  if (!archiveMap.has(year)) {
    archiveMap.set(year, new Map());
  }
  const yearMap = archiveMap.get(year)!;

  if (!yearMap.has(month)) {
    yearMap.set(month, []);
  }
  yearMap.get(month)!.push(post);
}

// 转换为排序后的数组
const archive = Array.from(archiveMap.entries())
  .sort((a, b) => b[0] - a[0])
  .map(([year, months]) => ({
    year,
    months: Array.from(months.entries()).sort((a, b) => b[0] - a[0]),
  }));

function getMonthName(month: number): string {
  if (locale === "zh-cn") {
    return `${month} 月`;
  }
  const months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
  return months[month - 1];
}

function formatDay(date: Date): string {
  return date.getDate().toString().padStart(2, "0");
}

function getPostPath(post: any): string {
  const collection = post.collection;
  const id = post.id.split("/").slice(1).join("/").replace(/\.mdx?$/, "");
  return `${basePath}/${collection}/${id}`;
}
---

<Base title={locale === "zh-cn" ? "归档" : "Archive"}>
  <div class="max-w-4xl mx-auto px-4 py-12">
    <header class="mb-10">
      <h1 class="text-3xl font-bold mb-2">
        {locale === "zh-cn" ? "归档" : "Archive"}
      </h1>
      <p class="text-muted-foreground">
        {locale === "zh-cn"
          ? `共 ${allPosts.length} 篇文章`
          : `${allPosts.length} posts in total`}
      </p>
    </header>

    {archive.length > 0 ? (
      <div class="archive-timeline">
        {archive.map(({ year, months }) => (
          <div class="year-group mb-10">
            <h2 class="year-title text-2xl font-bold text-foreground mb-6 flex items-center gap-3">
              <span class="text-accent">{year}</span>
              <span class="flex-1 h-px bg-border"></span>
            </h2>

            {months.map(([month, posts]) => (
              <div class="month-group mb-6 ml-4">
                <h3 class="month-title text-lg font-medium text-muted-foreground mb-3">
                  {getMonthName(month)}
                </h3>

                <ul class="post-list space-y-2 ml-4 border-l-2 border-border pl-4">
                  {posts.map((post) => (
                    <li class="post-item relative">
                      <span class="absolute -left-[21px] top-2 w-2 h-2 rounded-full bg-border"></span>
                      <a
                        href={getPostPath(post)}
                        class="flex items-start gap-3 py-1 group"
                      >
                        <span class="text-xs text-muted-foreground font-mono shrink-0 mt-0.5">
                          {formatDay(post.data.timestamp)}
                        </span>
                        <span class="text-foreground group-hover:text-accent transition-colors">
                          {post.data.title}
                        </span>
                        <span class="text-xs px-1.5 py-0.5 bg-muted rounded text-muted-foreground shrink-0">
                          {post.collection === "note" ? t("navigation.note") : t("navigation.jotting")}
                        </span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        ))}
      </div>
    ) : (
      <p class="text-center text-muted-foreground py-12">
        {locale === "zh-cn" ? "暂无文章" : "No posts yet"}
      </p>
    )}
  </div>
</Base>

<style>
  .post-item:hover span:first-child {
    background: var(--color-accent);
  }

  .post-item span:first-child {
    transition: background 0.2s ease;
  }
</style>
