---
/**
 * PoeticQuotes - 诗意诗词展示组件
 * 极简侘寂风格，留白呼吸
 */

interface Props {
  quotes?: Array<{
    text: string;
    author?: string;
  }>;
}

const defaultQuotes = [
  { text: "北海虽赊，扶摇可接；东隅已逝，桑榆非晚。", author: "滕王阁序" },
  { text: "取次花丛懒回顾，半缘修道半缘君。", author: "离思" }
];

const { quotes = defaultQuotes } = Astro.props;
---

<div class="poetic-realm relative py-12 md:py-16">
  <!-- 诗词展示 - 极简布局 -->
  <div class="relative z-10 max-w-4xl mx-auto px-6">
    <div class="poems-flow flex flex-col md:flex-row items-center justify-center gap-8 md:gap-16">
      {quotes.map((quote, index) => (
        <div
          class="poem-item group"
          style={`--delay: ${index * 0.15}s`}
        >
          <!-- 诗句 -->
          <div class="poem-text font-calligraphy text-xl md:text-2xl text-foreground/85 leading-loose tracking-wide text-center">
            {quote.text.split(/[；。]/).filter(Boolean).map((line, i, arr) => (
              <span class="block">
                {line.trim()}{i < arr.length - 1 ? '。' : '。'}
              </span>
            ))}
          </div>

          <!-- 出处 - 右下角小字 -->
          {quote.author && (
            <div class="mt-4 text-right">
              <span class="text-sm text-muted-foreground/50 font-serif tracking-widest">
                ——《{quote.author}》
              </span>
            </div>
          )}

          <!-- 悬浮时的淡雅光晕 -->
          <div class="absolute -inset-4 bg-accent/3 rounded-2xl blur-2xl opacity-0 group-hover:opacity-100 transition-opacity duration-1000 -z-10"></div>
        </div>
      ))}
    </div>
  </div>

  <!-- 淡雅分隔线 -->
  <div class="divider-line absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 hidden md:block">
    <div class="w-px h-16 bg-gradient-to-b from-transparent via-border/30 to-transparent"></div>
  </div>

  <!-- 极淡的漂浮粒子 -->
  <div class="particles absolute inset-0 pointer-events-none overflow-hidden">
    {Array.from({ length: 5 }).map((_, i) => (
      <div
        class="particle"
        style={`--x: ${20 + Math.random() * 60}%; --y: ${Math.random() * 100}%; --duration: ${10 + Math.random() * 8}s; --delay: ${Math.random() * 6}s;`}
      ></div>
    ))}
  </div>
</div>

<style>
  /* 诗词项 */
  .poem-item {
    position: relative;
    opacity: 0;
    animation: poem-fade-in 1s ease-out forwards;
    animation-delay: var(--delay);
    max-width: 280px;
  }

  @keyframes poem-fade-in {
    from {
      opacity: 0;
      transform: translateY(15px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* 诗句悬浮 */
  .poem-item {
    transition: transform 0.5s ease;
  }

  .poem-item:hover {
    transform: translateY(-3px);
  }

  /* 粒子效果 - 更淡更慢 */
  .particle {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: 2px;
    height: 2px;
    background: var(--color-accent);
    border-radius: 50%;
    opacity: 0;
    animation: particle-float var(--duration) ease-in-out infinite;
    animation-delay: var(--delay);
  }

  @keyframes particle-float {
    0%, 100% {
      opacity: 0;
      transform: translate(0, 0);
    }
    30% {
      opacity: 0.3;
    }
    50% {
      opacity: 0.4;
      transform: translate(-10px, -20px);
    }
    70% {
      opacity: 0.2;
    }
  }

  /* 深色模式 */
  :global(.dark) .particle {
    opacity: 0.3;
  }

  :global(.dark) .poem-text {
    color: var(--zen-foreground);
    opacity: 0.9;
  }
</style>
