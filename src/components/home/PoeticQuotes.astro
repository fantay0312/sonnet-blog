---
/**
 * PoeticQuotes - 诗意诗词展示组件
 * 引言体：横排居中，「」引号，句末缀落款
 */

interface Props {
  quotes?: Array<{
    text: string;
    author?: string;
  }>;
}

const defaultQuotes = [
  { text: "北海虽赊，扶摇可接；东隅已逝，桑榆非晚。", author: "滕王阁序" },
  { text: "取次花丛懒回顾，半缘修道半缘君。", author: "离思" }
];

const { quotes = defaultQuotes } = Astro.props;
---

<div class="poetic-realm relative py-3 md:py-4">
  <!-- 背景装饰 - 淡雅水墨感 -->
  <div class="absolute inset-0 pointer-events-none overflow-hidden">
    <div class="ink-wash"></div>
  </div>

  <!-- 诗词引言 -->
  <div class="relative z-10 max-w-3xl mx-auto px-6">
    {quotes.map((quote, index) => (
      <figure class="quote-item" style={`--delay: ${0.15 + index * 0.25}s`}>
        <p class="quote-line">
          <span class="quote-mark" aria-hidden="true">「</span>
          <span class="quote-text">{quote.text.replace(/[。]$/, "")}</span>
          <span class="quote-mark" aria-hidden="true">」</span>
        </p>
        {quote.author && (
          <figcaption class="quote-author">
            <span class="author-dash" aria-hidden="true"></span>
            <span>《{quote.author}》</span>
          </figcaption>
        )}
      </figure>
    ))}
  </div>

  <!-- 漂浮的墨点 -->
  <div class="ink-dots absolute inset-0 pointer-events-none overflow-hidden">
    {Array.from({ length: 5 }).map(() => (
      <div
        class="ink-dot"
        style={`--x: ${15 + Math.random() * 70}%; --y: ${10 + Math.random() * 80}%; --size: ${2 + Math.random() * 3}px; --duration: ${12 + Math.random() * 10}s; --delay: ${Math.random() * 8}s;`}
      ></div>
    ))}
  </div>
</div>

<style>
  /* 水墨背景 */
  .ink-wash {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 80% 50% at 20% 40%, color-mix(in srgb, var(--color-accent) 2%, transparent), transparent 50%),
      radial-gradient(ellipse 60% 40% at 80% 60%, color-mix(in srgb, var(--color-accent) 1.5%, transparent), transparent 50%);
  }

  /* 引言块：收缩至内容宽度并居中，落款对齐句尾右下 */
  .quote-item {
    display: table;
    margin: 0 auto 1.05rem;
    opacity: 0;
    animation: quote-rise 1.1s cubic-bezier(0.23, 1, 0.32, 1) forwards;
    animation-delay: var(--delay);
  }

  .quote-item:last-child {
    margin-bottom: 0;
  }

  @keyframes quote-rise {
    from { opacity: 0; transform: translateY(12px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .quote-line {
    margin: 0;
    text-align: center;
    line-height: 1.9;
  }

  .quote-text {
    font-family: "LXGW WenKai", "霞鹜文楷", "Kaiti SC", "STKaiti", "楷体", serif;
    font-size: 1.1875rem;
    letter-spacing: 0.08em;
    color: color-mix(in srgb, var(--color-foreground) 88%, transparent);
  }

  @media (min-width: 768px) {
    .quote-text {
      font-size: 1.3125rem;
    }
  }

  /* 引号：竹绿点睛 */
  .quote-mark {
    font-family: "LXGW WenKai", "霞鹜文楷", "楷体", serif;
    font-size: 1.25em;
    color: var(--color-accent);
    opacity: 0.55;
    vertical-align: -0.05em;
  }

  /* 落款：缩进句尾右下角 */
  .quote-author {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.5em;
    margin-top: 0.2rem;
    padding-right: 1.5em;
    font-family: "LXGW WenKai", "霞鹜文楷", "楷体", serif;
    font-size: 0.78rem;
    letter-spacing: 0.15em;
    color: var(--color-muted-foreground);
    opacity: 0.6;
    white-space: nowrap;
  }

  .author-dash {
    display: block;
    width: 1.5em;
    height: 1px;
    background: linear-gradient(90deg, transparent, color-mix(in srgb, var(--zen-gold) 60%, transparent));
  }

  /* 墨点 */
  .ink-dot {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: var(--size);
    height: var(--size);
    background: var(--color-foreground);
    border-radius: 50%;
    opacity: 0;
    animation: dot-drift var(--duration) ease-in-out infinite;
    animation-delay: var(--delay);
  }

  @keyframes dot-drift {
    0%, 100% {
      opacity: 0;
      transform: translate(0, 0) scale(1);
    }
    20% {
      opacity: 0.06;
    }
    50% {
      opacity: 0.08;
      transform: translate(-15px, -25px) scale(0.8);
    }
    80% {
      opacity: 0.04;
    }
  }

  /* 移动端 */
  @media (max-width: 640px) {
    .quote-item {
      margin-bottom: 1.125rem;
    }

    .quote-line {
      line-height: 1.85;
    }

    .quote-author {
      padding-right: 0.75em;
    }
  }

  /* 深色模式调整 */
  :global(.dark) .ink-dot {
    background: var(--color-accent);
  }

  :global(.dark) .ink-wash {
    background:
      radial-gradient(ellipse 80% 50% at 20% 40%, color-mix(in srgb, var(--color-accent) 3%, transparent), transparent 50%),
      radial-gradient(ellipse 60% 40% at 80% 60%, color-mix(in srgb, var(--color-accent) 2.5%, transparent), transparent 50%);
  }

  @media (prefers-reduced-motion: reduce) {
    .quote-item {
      animation: none;
      opacity: 1;
    }

    .ink-dot {
      animation: none;
    }
  }
</style>
