---
/**
 * PoeticQuotes - 诗意诗词展示组件
 * 侘寂禅意、飘渺仙气的东方美学设计
 * 错落有致，自然呼吸
 */

interface Props {
  quotes?: Array<{
    text: string;
    author?: string;
  }>;
}

const defaultQuotes = [
  { text: "北海虽赊，扶摇可接；东隅已逝，桑榆非晚。", author: "滕王阁序" },
  { text: "取次花丛懒回顾，半缘修道半缘君。", author: "离思" }
];

const { quotes = defaultQuotes } = Astro.props;
---

<div class="poetic-realm relative py-8 md:py-12">
  <!-- 飘渺云雾背景 -->
  <div class="mist-layer absolute inset-0 pointer-events-none overflow-hidden">
    <div class="mist mist-1"></div>
    <div class="mist mist-2"></div>
  </div>

  <!-- 诗词展示区 - 错落布局 -->
  <div class="relative z-10 max-w-3xl mx-auto px-4">
    <div class="poems-container flex flex-col md:flex-row items-center justify-center gap-6 md:gap-0">

      {quotes.map((quote, index) => (
        <div
          class:list={[
            "poem-card group relative",
            index === 0 ? "md:-translate-y-4 md:mr-8" : "md:translate-y-4 md:ml-8"
          ]}
          style={`--delay: ${index * 0.2}s`}
        >
          <!-- 印章 -->
          <div class="seal absolute -top-2 -right-2 z-20">
            <svg viewBox="0 0 40 40" class="w-8 h-8 text-accent/80">
              <circle cx="20" cy="20" r="18" fill="none" stroke="currentColor" stroke-width="1.5" />
              <text x="20" y="24" text-anchor="middle" fill="currentColor" class="text-[11px] font-serif">诗</text>
            </svg>
          </div>

          <!-- 卡片主体 -->
          <div class="card-body relative bg-block/60 backdrop-blur-sm rounded-lg p-6 md:p-8 border border-border/40 shadow-sm">
            <!-- 诗句 - 竖排意境 -->
            <div class="poem-text font-calligraphy text-lg md:text-xl text-foreground/90 leading-relaxed">
              {quote.text.split(/[，。；]/).filter(Boolean).map((segment, i, arr) => (
                <span class="inline-block whitespace-nowrap">
                  {segment}
                  {i < arr.length - 1 && <span class="text-accent/50 mx-0.5">·</span>}
                </span>
              ))}
            </div>

            <!-- 作者/出处 -->
            {quote.author && (
              <div class="mt-4 text-right">
                <span class="text-xs text-muted-foreground/60 font-serif">—— {quote.author}</span>
              </div>
            )}

            <!-- 悬浮光晕 -->
            <div class="absolute -inset-2 bg-accent/5 rounded-xl blur-xl opacity-0 group-hover:opacity-100 transition-opacity duration-700 -z-10"></div>
          </div>

          <!-- 连接丝线装饰 (仅第一个卡片显示) -->
          {index === 0 && (
            <div class="silk-thread hidden md:block absolute top-1/2 -right-8 w-16 h-px">
              <svg viewBox="0 0 64 8" class="w-full h-2 text-accent/20">
                <path d="M0,4 Q16,0 32,4 T64,4" stroke="currentColor" fill="none" stroke-width="1" />
              </svg>
            </div>
          )}
        </div>
      ))}
    </div>
  </div>

  <!-- 飘落粒子 -->
  <div class="particles absolute inset-0 pointer-events-none overflow-hidden">
    {Array.from({ length: 8 }).map((_, i) => (
      <div
        class="particle"
        style={`--x: ${15 + Math.random() * 70}%; --y: ${Math.random() * 100}%; --duration: ${8 + Math.random() * 6}s; --delay: ${Math.random() * 5}s;`}
      ></div>
    ))}
  </div>
</div>

<style>
  .poetic-realm {
    --mist-color: var(--color-muted);
  }

  /* 云雾效果 - 更轻更淡 */
  .mist {
    position: absolute;
    background: radial-gradient(ellipse at center, var(--mist-color) 0%, transparent 70%);
    opacity: 0.15;
    filter: blur(50px);
  }

  .mist-1 {
    width: 50%;
    height: 60%;
    top: -20%;
    left: 10%;
    animation: mist-float 25s ease-in-out infinite;
  }

  .mist-2 {
    width: 40%;
    height: 50%;
    bottom: -10%;
    right: 15%;
    animation: mist-float 20s ease-in-out infinite reverse;
    animation-delay: -8s;
  }

  @keyframes mist-float {
    0%, 100% {
      transform: translate(0, 0) scale(1);
      opacity: 0.15;
    }
    50% {
      transform: translate(20px, -10px) scale(1.1);
      opacity: 0.1;
    }
  }

  /* 诗词卡片 */
  .poem-card {
    opacity: 0;
    animation: card-emerge 0.8s ease-out forwards;
    animation-delay: var(--delay);
    max-width: 320px;
  }

  @keyframes card-emerge {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* 保持错落布局 */
  .poem-card:first-child {
    animation-name: card-emerge-left;
  }

  .poem-card:last-child {
    animation-name: card-emerge-right;
  }

  @keyframes card-emerge-left {
    from {
      opacity: 0;
      transform: translateY(20px) translateX(-10px);
    }
    to {
      opacity: 1;
      transform: translateY(-16px) translateX(0);
    }
  }

  @keyframes card-emerge-right {
    from {
      opacity: 0;
      transform: translateY(20px) translateX(10px);
    }
    to {
      opacity: 1;
      transform: translateY(16px) translateX(0);
    }
  }

  @media (max-width: 768px) {
    @keyframes card-emerge-left, @keyframes card-emerge-right {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
  }

  /* 悬浮效果 */
  .poem-card:hover {
    transform: translateY(-4px);
    transition: transform 0.4s ease;
  }

  .poem-card:first-child:hover {
    transform: translateY(calc(-16px - 4px));
  }

  .poem-card:last-child:hover {
    transform: translateY(calc(16px - 4px));
  }

  @media (max-width: 768px) {
    .poem-card:hover,
    .poem-card:first-child:hover,
    .poem-card:last-child:hover {
      transform: translateY(-4px);
    }
  }

  /* 粒子效果 */
  .particle {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: 3px;
    height: 3px;
    background: var(--color-accent);
    border-radius: 50%;
    opacity: 0;
    animation: particle-drift var(--duration) ease-in-out infinite;
    animation-delay: var(--delay);
  }

  @keyframes particle-drift {
    0%, 100% {
      opacity: 0;
      transform: translate(0, 0) scale(0.5);
    }
    20% {
      opacity: 0.4;
    }
    50% {
      opacity: 0.6;
      transform: translate(-15px, -25px) scale(1);
    }
    80% {
      opacity: 0.3;
    }
  }

  /* 深色模式 */
  :global(.dark) .mist {
    opacity: 0.08;
  }

  :global(.dark) .particle {
    opacity: 0.5;
  }
</style>
