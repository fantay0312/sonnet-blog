---
/**
 * SkillsShowcase - 技能栈展示组件
 * 水墨古韵风格，与整体主题统一
 */
import { cn } from "~/lib/utils";
import type { SkillGroup, Skill } from "$config";

interface Props {
  skills: SkillGroup[];
}

const { skills } = Astro.props;

const duplicateSkills = (items: Skill[]) => [...items, ...items, ...items, ...items];
---

<div class="skills-scroll relative py-2">
  <!-- 淡雅水墨背景 -->
  <div class="ink-bg absolute inset-0 pointer-events-none"></div>

  <!-- 技能行 -->
  <div class="relative z-10 space-y-1">
    {skills.map((row, rowIndex) => {
      const duplicatedSkills = duplicateSkills(row.skills);
      return (
        <div class="skill-stream relative w-full overflow-hidden group">
          <!-- 水墨分隔线 -->
          {rowIndex > 0 && <div class="ink-divider"></div>}

          <div
            class={cn(
              "flex w-max will-change-transform py-3",
              row.direction === "right" ? "animate-drift-right" : "animate-drift-left",
              "group-hover:[animation-play-state:paused]"
            )}
          >
            {duplicatedSkills.map((skill) => {
              const Tag = skill.url ? "a" : "span";
              const props = skill.url
                ? { href: skill.url, target: "_blank", rel: "noopener noreferrer" }
                : {};
              return (
                <Tag
                  class="skill-item inline-flex items-center gap-2 px-5 mx-3 cursor-default group/item"
                  {...props}
                >
                  <!-- 图标 -->
                  <span class={cn(
                    "text-base text-muted-foreground/70 group-hover/item:text-accent transition-colors duration-500",
                    skill.icon
                  )} />

                  <!-- 名称 -->
                  <span class="skill-name text-sm tracking-widest text-foreground/75 group-hover/item:text-foreground transition-colors duration-500">
                    {skill.name}
                  </span>

                  <!-- 悬浮下划线 -->
                  <span class="skill-underline"></span>
                </Tag>
              );
            })}
          </div>

          <!-- 边缘渐隐 -->
          <div class="fade-edge fade-left"></div>
          <div class="fade-edge fade-right"></div>
        </div>
      );
    })}
  </div>

  <!-- 漂浮墨点 -->
  <div class="ink-dots absolute inset-0 pointer-events-none">
    {Array.from({ length: 4 }).map((_, i) => (
      <div
        class="ink-dot"
        style={`--x: ${20 + Math.random() * 60}%; --y: ${20 + Math.random() * 60}%; --size: ${2 + Math.random() * 2}px; --duration: ${15 + Math.random() * 10}s; --delay: ${Math.random() * 8}s;`}
      ></div>
    ))}
  </div>
</div>

<style>
  /* 水墨背景 */
  .ink-bg {
    background:
      radial-gradient(ellipse 60% 40% at 30% 50%, var(--color-accent)/0.015, transparent 50%),
      radial-gradient(ellipse 50% 35% at 70% 50%, var(--color-accent)/0.01, transparent 50%);
  }

  :global(.dark) .ink-bg {
    background:
      radial-gradient(ellipse 60% 40% at 30% 50%, var(--color-accent)/0.025, transparent 50%),
      radial-gradient(ellipse 50% 35% at 70% 50%, var(--color-accent)/0.02, transparent 50%);
  }

  /* 水墨分隔线 */
  .ink-divider {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 60%;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      var(--color-border)/0.5,
      var(--color-accent)/0.2,
      var(--color-border)/0.5,
      transparent
    );
  }

  /* 漂流动画 */
  .animate-drift-left {
    animation: drift-left 55s linear infinite;
  }

  .animate-drift-right {
    animation: drift-right 55s linear infinite;
  }

  @keyframes drift-left {
    from { transform: translateX(0); }
    to { transform: translateX(-25%); }
  }

  @keyframes drift-right {
    from { transform: translateX(-25%); }
    to { transform: translateX(0); }
  }

  /* 技能项 */
  .skill-item {
    position: relative;
    transition: transform 0.4s ease;
  }

  .skill-item:hover {
    transform: translateY(-1px);
  }

  .skill-name {
    font-family: "LXGW WenKai", "霞鹜文楷", system-ui, sans-serif;
  }

  /* 悬浮下划线 */
  .skill-underline {
    position: absolute;
    bottom: -2px;
    left: 50%;
    transform: translateX(-50%) scaleX(0);
    width: 80%;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--color-accent)/0.4, transparent);
    transition: transform 0.5s cubic-bezier(0.23, 1, 0.32, 1);
  }

  .skill-item:hover .skill-underline {
    transform: translateX(-50%) scaleX(1);
  }

  /* 边缘渐隐 */
  .fade-edge {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 100px;
    z-index: 10;
    pointer-events: none;
  }

  .fade-left {
    left: 0;
    background: linear-gradient(to right, var(--color-background), transparent);
  }

  .fade-right {
    right: 0;
    background: linear-gradient(to left, var(--color-background), transparent);
  }

  /* 墨点 */
  .ink-dot {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: var(--size);
    height: var(--size);
    background: var(--color-foreground);
    border-radius: 50%;
    opacity: 0;
    animation: dot-float var(--duration) ease-in-out infinite;
    animation-delay: var(--delay);
  }

  @keyframes dot-float {
    0%, 100% {
      opacity: 0;
      transform: translate(0, 0);
    }
    30% {
      opacity: 0.05;
    }
    50% {
      opacity: 0.08;
      transform: translate(-10px, -15px);
    }
    70% {
      opacity: 0.04;
    }
  }

  :global(.dark) .ink-dot {
    background: var(--color-accent);
  }

  /* 响应式 */
  @media (max-width: 640px) {
    .fade-edge {
      width: 50px;
    }
    .ink-dot {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .animate-drift-left,
    .animate-drift-right {
      animation: none;
    }
    .ink-dot {
      animation: none;
    }
  }
</style>
