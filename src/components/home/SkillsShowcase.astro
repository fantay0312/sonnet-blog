---
/**
 * SkillsShowcase - 技能栈展示组件
 * 水墨古韵风格，与整体主题统一
 */
import { cn } from "~/lib/utils";
import type { SkillGroup, Skill } from "$config";

interface Props {
  skills: SkillGroup[];
}

const { skills } = Astro.props;

const duplicateSkills = (items: Skill[]) => [...items, ...items, ...items, ...items];
---

<div class="skills-scroll relative py-2">
  <!-- 淡雅水墨背景 -->
  <div class="ink-bg absolute inset-0 pointer-events-none"></div>

  <!-- 技能行 -->
  <div class="relative z-10 space-y-1">
    {skills.map((row, rowIndex) => {
      const duplicatedSkills = duplicateSkills(row.skills);
      return (
        <div class="skill-stream relative w-full overflow-hidden group">
          <!-- 水墨分隔线 -->
          {rowIndex > 0 && <div class="ink-divider"></div>}

          <div
            class={cn(
              "flex w-max will-change-transform py-3",
              row.direction === "right" ? "animate-drift-right" : "animate-drift-left",
              "group-hover:[animation-play-state:paused]"
            )}
          >
            {duplicatedSkills.map((skill) => {
              const Tag = skill.url ? "a" : "span";
              const props = skill.url
                ? { href: skill.url, target: "_blank", rel: "noopener noreferrer" }
                : {};
              return (
                <Tag
                  class="skill-item inline-flex items-center gap-2 px-5 mx-3 cursor-default group/item"
                  {...props}
                >
                  <!-- 图标 -->
                  <span class={cn(
                    "text-base text-muted-foreground/70 group-hover/item:text-accent transition-colors duration-300",
                    skill.icon
                  )} />

                  <!-- 名称 -->
                  <span class="skill-name text-sm tracking-widest text-foreground/75 group-hover/item:text-foreground transition-colors duration-300">
                    {skill.name}
                  </span>

                  <!-- 悬浮下划线 -->
                  <span class="skill-underline"></span>
                </Tag>
              );
            })}
          </div>
        </div>
      );
    })}
  </div>
</div>

<style>
  /* 水墨背景（此前写成 var()/0.015 这种非法语法，整条声明被浏览器丢弃，等于没画） */
  .ink-bg {
    background:
      radial-gradient(ellipse 60% 40% at 30% 50%, color-mix(in srgb, var(--color-accent) 2%, transparent), transparent 50%),
      radial-gradient(ellipse 50% 35% at 70% 50%, color-mix(in srgb, var(--color-accent) 1.5%, transparent), transparent 50%);
  }

  :global(.dark) .ink-bg {
    background:
      radial-gradient(ellipse 60% 40% at 30% 50%, color-mix(in srgb, var(--color-accent) 3%, transparent), transparent 50%),
      radial-gradient(ellipse 50% 35% at 70% 50%, color-mix(in srgb, var(--color-accent) 2.5%, transparent), transparent 50%);
  }

  /* 两侧渐隐：用 mask 而不是盖一层底色——底色盖层会把身后的粒子画布也遮掉，
     mask 与任何背景都能合成 */
  .skill-stream {
    -webkit-mask-image: linear-gradient(
      to right,
      transparent,
      black 100px,
      black calc(100% - 100px),
      transparent
    );
    mask-image: linear-gradient(
      to right,
      transparent,
      black 100px,
      black calc(100% - 100px),
      transparent
    );
  }

  /* 水墨分隔线 */
  .ink-divider {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 60%;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      color-mix(in srgb, var(--color-border) 50%, transparent),
      color-mix(in srgb, var(--color-accent) 25%, transparent),
      color-mix(in srgb, var(--color-border) 50%, transparent),
      transparent
    );
  }

  /* 漂流动画：匀速循环用 linear 才对 */
  .animate-drift-left {
    animation: drift-left 55s linear infinite;
  }

  .animate-drift-right {
    animation: drift-right 55s linear infinite;
  }

  @keyframes drift-left {
    from { transform: translateX(0); }
    to { transform: translateX(-25%); }
  }

  @keyframes drift-right {
    from { transform: translateX(-25%); }
    to { transform: translateX(0); }
  }

  /* 技能项：悬浮反馈交给颜色 + 下划线，不再上抬——抬起的元素会从光标下滑走引发抖动 */
  .skill-item {
    position: relative;
  }

  .skill-name {
    font-family: "LXGW WenKai", "霞鹜文楷", system-ui, sans-serif;
  }

  /* 悬浮下划线（同样修复了 var()/0.4 非法写法——此前从未显示过） */
  .skill-underline {
    position: absolute;
    bottom: -2px;
    left: 50%;
    transform: translateX(-50%) scaleX(0);
    width: 80%;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      color-mix(in srgb, var(--color-accent) 55%, transparent),
      transparent
    );
    transition: transform var(--dur-slow) var(--ease-out-expo);
  }

  @media (hover: hover) and (pointer: fine) {
    .skill-item:hover .skill-underline {
      transform: translateX(-50%) scaleX(1);
    }
  }

  .skill-item:focus-visible .skill-underline {
    transform: translateX(-50%) scaleX(1);
  }

  /* 响应式 */
  @media (max-width: 640px) {
    .skill-stream {
      -webkit-mask-image: linear-gradient(
        to right,
        transparent,
        black 40px,
        black calc(100% - 40px),
        transparent
      );
      mask-image: linear-gradient(
        to right,
        transparent,
        black 40px,
        black calc(100% - 40px),
        transparent
      );
    }
  }

  @media (prefers-reduced-motion: reduce) {
    /* 循环漂流停在起始帧；下划线改为直接出现 */
    .animate-drift-left,
    .animate-drift-right {
      animation: none;
    }
    .skill-underline {
      transition: none;
    }
  }
</style>
