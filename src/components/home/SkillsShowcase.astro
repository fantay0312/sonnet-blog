---
/**
 * SkillsShowcase - 技能栈展示组件 v2
 * 流光溢彩、星河璀璨的现代设计
 */
import { cn } from "~/lib/utils";
import type { SkillGroup, Skill } from "$config";

interface Props {
  skills: SkillGroup[];
}

const { skills } = Astro.props;

const duplicateSkills = (items: Skill[]) => [...items, ...items, ...items, ...items];
---

<div class="skills-cosmos relative py-16 overflow-hidden">
  <!-- 星河背景 -->
  <div class="starfield absolute inset-0 pointer-events-none">
    <div class="stars-layer stars-small"></div>
    <div class="stars-layer stars-medium"></div>
    <div class="nebula nebula-1"></div>
    <div class="nebula nebula-2"></div>
  </div>

  <!-- 流光线条 -->
  <div class="flow-lines absolute inset-0 pointer-events-none overflow-hidden">
    {Array.from({ length: 5 }).map((_, i) => (
      <div
        class="flow-line"
        style={`
          --y: ${15 + i * 18}%;
          --duration: ${8 + i * 2}s;
          --delay: ${i * 1.5}s;
          --width: ${60 + Math.random() * 30}%;
        `}
      ></div>
    ))}
  </div>

  <!-- 悬浮光点 -->
  <div class="orbs absolute inset-0 pointer-events-none">
    {Array.from({ length: 12 }).map((_, i) => (
      <div
        class="orb"
        style={`
          --x: ${5 + Math.random() * 90}%;
          --y: ${10 + Math.random() * 80}%;
          --size: ${3 + Math.random() * 4}px;
          --duration: ${4 + Math.random() * 4}s;
          --delay: ${Math.random() * 5}s;
          --hue: ${180 + Math.random() * 60};
        `}
      ></div>
    ))}
  </div>

  <!-- 技能行容器 -->
  <div class="relative z-10">
    {skills.map((row, rowIndex) => {
      const duplicatedSkills = duplicateSkills(row.skills);
      return (
        <div class="skill-river relative w-full overflow-hidden my-5 group">
          <!-- 顶部光带 -->
          <div class="river-glow absolute top-0 left-0 right-0 h-px"></div>

          <div
            class={cn(
              "flex w-max will-change-transform py-5",
              row.direction === "right"
                ? "animate-flow-right"
                : "animate-flow-left",
              "group-hover:[animation-play-state:paused]"
            )}
          >
            {duplicatedSkills.map((skill, index) => {
              const Tag = skill.url ? "a" : "div";
              const props = skill.url
                ? { href: skill.url, target: "_blank", rel: "noopener noreferrer" }
                : {};
              return (
                <Tag
                  class="skill-gem relative flex items-center gap-3 px-5 py-2.5 mx-3 whitespace-nowrap cursor-default group/gem"
                  {...props}
                >
                  <!-- 玻璃卡片背景 -->
                  <div class="gem-glass absolute inset-0 rounded-xl"></div>

                  <!-- 边框光效 -->
                  <div class="gem-border absolute inset-0 rounded-xl"></div>

                  <!-- 悬浮光晕 -->
                  <div class="gem-glow absolute inset-0 rounded-xl opacity-0 group-hover/gem:opacity-100 transition-opacity duration-500"></div>

                  <!-- 图标 -->
                  <span class={cn(
                    "relative z-10 flex items-center justify-center w-5 h-5 text-base transition-all duration-400 group-hover/gem:scale-110",
                    "text-secondary group-hover/gem:text-accent",
                    skill.icon
                  )} />

                  <!-- 名称 -->
                  <span class="relative z-10 text-sm font-medium text-foreground/85 tracking-wide group-hover/gem:text-foreground transition-colors duration-300">
                    {skill.name}
                  </span>

                  <!-- 闪烁星点 -->
                  <div class="sparkles absolute inset-0 rounded-xl overflow-hidden opacity-0 group-hover/gem:opacity-100">
                    <span class="sparkle" style="--x: 20%; --y: 30%; --delay: 0s;"></span>
                    <span class="sparkle" style="--x: 80%; --y: 20%; --delay: 0.3s;"></span>
                    <span class="sparkle" style="--x: 60%; --y: 70%; --delay: 0.6s;"></span>
                  </div>
                </Tag>
              );
            })}
          </div>

          <!-- 底部光带 -->
          <div class="river-glow absolute bottom-0 left-0 right-0 h-px"></div>
        </div>
      );
    })}
  </div>

  <!-- 底部渐变遮罩 -->
  <div class="absolute bottom-0 left-0 right-0 h-20 bg-gradient-to-t from-background to-transparent pointer-events-none z-20"></div>
</div>

<style>
  .skills-cosmos {
    background: linear-gradient(
      180deg,
      transparent 0%,
      color-mix(in srgb, var(--color-accent) 3%, transparent) 50%,
      transparent 100%
    );
  }

  /* ===== 星河背景 ===== */
  .stars-layer {
    position: absolute;
    inset: 0;
    background-repeat: repeat;
  }

  .stars-small {
    background-image: radial-gradient(1px 1px at 20px 30px, var(--color-foreground), transparent),
                      radial-gradient(1px 1px at 40px 70px, var(--color-foreground), transparent),
                      radial-gradient(1px 1px at 50px 160px, var(--color-foreground), transparent),
                      radial-gradient(1px 1px at 90px 40px, var(--color-foreground), transparent),
                      radial-gradient(1px 1px at 130px 80px, var(--color-foreground), transparent),
                      radial-gradient(1px 1px at 160px 120px, var(--color-foreground), transparent);
    background-size: 200px 200px;
    opacity: 0.15;
    animation: twinkle 4s ease-in-out infinite;
  }

  .stars-medium {
    background-image: radial-gradient(1.5px 1.5px at 150px 150px, var(--color-foreground), transparent),
                      radial-gradient(1.5px 1.5px at 200px 220px, var(--color-foreground), transparent),
                      radial-gradient(1.5px 1.5px at 100px 280px, var(--color-foreground), transparent),
                      radial-gradient(1.5px 1.5px at 300px 100px, var(--color-foreground), transparent);
    background-size: 400px 400px;
    opacity: 0.12;
    animation: twinkle 6s ease-in-out infinite reverse;
    animation-delay: -2s;
  }

  @keyframes twinkle {
    0%, 100% { opacity: 0.12; }
    50% { opacity: 0.2; }
  }

  /* 星云效果 */
  .nebula {
    position: absolute;
    border-radius: 50%;
    filter: blur(60px);
    opacity: 0.06;
    animation: nebula-pulse 20s ease-in-out infinite;
  }

  .nebula-1 {
    width: 400px;
    height: 300px;
    background: radial-gradient(ellipse, var(--color-accent) 0%, transparent 70%);
    top: 10%;
    left: -5%;
  }

  .nebula-2 {
    width: 350px;
    height: 250px;
    background: radial-gradient(ellipse, var(--color-secondary) 0%, transparent 70%);
    bottom: 15%;
    right: -5%;
    animation-delay: -10s;
  }

  @keyframes nebula-pulse {
    0%, 100% {
      transform: scale(1) translate(0, 0);
      opacity: 0.06;
    }
    50% {
      transform: scale(1.1) translate(20px, -10px);
      opacity: 0.1;
    }
  }

  /* ===== 流光线条 ===== */
  .flow-line {
    position: absolute;
    top: var(--y);
    left: -10%;
    width: var(--width);
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent 0%,
      var(--color-accent)/40 20%,
      var(--color-accent)/60 50%,
      var(--color-accent)/40 80%,
      transparent 100%
    );
    opacity: 0;
    animation: flow-sweep var(--duration) ease-in-out infinite;
    animation-delay: var(--delay);
  }

  @keyframes flow-sweep {
    0% {
      left: -60%;
      opacity: 0;
    }
    10% {
      opacity: 0.6;
    }
    90% {
      opacity: 0.6;
    }
    100% {
      left: 110%;
      opacity: 0;
    }
  }

  /* ===== 悬浮光点 ===== */
  .orb {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: var(--size);
    height: var(--size);
    border-radius: 50%;
    background: hsl(var(--hue), 70%, 70%);
    box-shadow: 0 0 calc(var(--size) * 2) calc(var(--size) * 0.5) hsl(var(--hue), 70%, 60%);
    opacity: 0;
    animation: orb-float var(--duration) ease-in-out infinite;
    animation-delay: var(--delay);
  }

  @keyframes orb-float {
    0%, 100% {
      opacity: 0;
      transform: translateY(0) scale(0.5);
    }
    20% {
      opacity: 0.7;
      transform: translateY(-10px) scale(1);
    }
    80% {
      opacity: 0.7;
      transform: translateY(-20px) scale(1);
    }
  }

  /* ===== 河流光带 ===== */
  .river-glow {
    background: linear-gradient(
      90deg,
      transparent 0%,
      var(--color-border)/50 15%,
      var(--color-accent)/30 50%,
      var(--color-border)/50 85%,
      transparent 100%
    );
  }

  /* ===== 技能流动动画 ===== */
  .animate-flow-left {
    animation: flow-left 50s linear infinite;
  }

  .animate-flow-right {
    animation: flow-right 50s linear infinite;
  }

  @keyframes flow-left {
    0% { transform: translate3d(0, 0, 0); }
    100% { transform: translate3d(-25%, 0, 0); }
  }

  @keyframes flow-right {
    0% { transform: translate3d(-25%, 0, 0); }
    100% { transform: translate3d(0, 0, 0); }
  }

  /* ===== 玻璃宝石卡片 ===== */
  .skill-gem {
    transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .skill-gem:hover {
    transform: translateY(-4px) scale(1.02);
  }

  .gem-glass {
    background: color-mix(in srgb, var(--color-block) 60%, transparent);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .gem-border {
    background: linear-gradient(
      135deg,
      var(--color-border)/60 0%,
      transparent 50%,
      var(--color-border)/30 100%
    );
    mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    mask-composite: exclude;
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    padding: 1px;
  }

  .skill-gem:hover .gem-border {
    background: linear-gradient(
      135deg,
      var(--color-accent)/70 0%,
      var(--color-accent)/20 50%,
      var(--color-accent)/50 100%
    );
  }

  .gem-glow {
    background: radial-gradient(
      ellipse at center,
      var(--color-accent)/15 0%,
      transparent 70%
    );
    filter: blur(10px);
  }

  /* ===== 闪烁星点 ===== */
  .sparkle {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: 3px;
    height: 3px;
    background: var(--color-accent);
    border-radius: 50%;
    animation: sparkle-pop 1.2s ease-in-out infinite;
    animation-delay: var(--delay);
  }

  @keyframes sparkle-pop {
    0%, 100% {
      opacity: 0;
      transform: scale(0);
    }
    50% {
      opacity: 1;
      transform: scale(1);
    }
  }

  /* ===== 边缘渐隐 ===== */
  .skill-river::before,
  .skill-river::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    width: 100px;
    z-index: 20;
    pointer-events: none;
  }

  .skill-river::before {
    left: 0;
    background: linear-gradient(to right, var(--color-background), transparent);
  }

  .skill-river::after {
    right: 0;
    background: linear-gradient(to left, var(--color-background), transparent);
  }

  /* ===== 深色模式增强 ===== */
  :global(.dark) .stars-small {
    opacity: 0.25;
  }

  :global(.dark) .stars-medium {
    opacity: 0.2;
  }

  :global(.dark) .nebula {
    opacity: 0.1;
  }

  :global(.dark) .orb {
    box-shadow: 0 0 calc(var(--size) * 3) calc(var(--size) * 0.8) hsl(var(--hue), 80%, 60%);
  }

  :global(.dark) .flow-line {
    background: linear-gradient(
      90deg,
      transparent 0%,
      var(--color-accent)/50 20%,
      var(--color-accent)/80 50%,
      var(--color-accent)/50 80%,
      transparent 100%
    );
  }

  :global(.dark) .gem-glass {
    background: color-mix(in srgb, var(--color-block) 70%, transparent);
  }

  :global(.dark) .gem-glow {
    background: radial-gradient(
      ellipse at center,
      var(--color-accent)/25 0%,
      transparent 70%
    );
  }

  /* 响应式 */
  @media (max-width: 768px) {
    .nebula { display: none; }
    .flow-line { display: none; }
    .orb { display: none; }
    .skill-river::before,
    .skill-river::after {
      width: 60px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .stars-layer,
    .nebula,
    .flow-line,
    .orb,
    .sparkle {
      animation: none;
      opacity: 0.1;
    }
    .animate-flow-left,
    .animate-flow-right {
      animation: none;
    }
  }
</style>
