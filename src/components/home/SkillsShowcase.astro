---
/**
 * SkillsShowcase - 技能栈展示组件 v3
 * 简洁流畅的设计
 */
import { cn } from "~/lib/utils";
import type { SkillGroup, Skill } from "$config";

interface Props {
  skills: SkillGroup[];
}

const { skills } = Astro.props;

const duplicateSkills = (items: Skill[]) => [...items, ...items, ...items, ...items];
---

<div class="skills-container relative py-4 overflow-hidden">
  <!-- 背景光效 -->
  <div class="bg-glow absolute inset-0 pointer-events-none">
    <div class="glow-orb glow-1"></div>
    <div class="glow-orb glow-2"></div>
  </div>

  <!-- 技能行 -->
  <div class="relative z-10 space-y-3">
    {skills.map((row, rowIndex) => {
      const duplicatedSkills = duplicateSkills(row.skills);
      return (
        <div class="skill-track relative w-full overflow-hidden group">
          <div
            class={cn(
              "flex w-max will-change-transform py-2",
              row.direction === "right" ? "animate-scroll-right" : "animate-scroll-left",
              "group-hover:[animation-play-state:paused]"
            )}
          >
            {duplicatedSkills.map((skill) => {
              const Tag = skill.url ? "a" : "div";
              const props = skill.url
                ? { href: skill.url, target: "_blank", rel: "noopener noreferrer" }
                : {};
              return (
                <Tag
                  class="skill-chip relative flex items-center gap-2 px-4 py-1.5 mx-2 rounded-full cursor-default group/chip"
                  {...props}
                >
                  <!-- 背景 -->
                  <div class="chip-bg absolute inset-0 rounded-full"></div>

                  <!-- 悬浮边框 -->
                  <div class="chip-border absolute inset-0 rounded-full opacity-0 group-hover/chip:opacity-100 transition-opacity duration-300"></div>

                  <!-- 图标 -->
                  <span class={cn(
                    "relative z-10 text-sm text-secondary group-hover/chip:text-accent transition-colors duration-300",
                    skill.icon
                  )} />

                  <!-- 名称 -->
                  <span class="relative z-10 text-sm text-foreground/80 group-hover/chip:text-foreground transition-colors duration-300 whitespace-nowrap">
                    {skill.name}
                  </span>
                </Tag>
              );
            })}
          </div>

          <!-- 边缘遮罩 -->
          <div class="edge-mask edge-left"></div>
          <div class="edge-mask edge-right"></div>
        </div>
      );
    })}
  </div>
</div>

<style>
  .skills-container {
    background: linear-gradient(
      180deg,
      transparent 0%,
      color-mix(in srgb, var(--color-muted) 5%, transparent) 50%,
      transparent 100%
    );
  }

  /* 背景光效 */
  .glow-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.08;
  }

  .glow-1 {
    width: 300px;
    height: 200px;
    background: var(--color-accent);
    top: -50%;
    left: 10%;
  }

  .glow-2 {
    width: 250px;
    height: 180px;
    background: var(--color-secondary);
    bottom: -50%;
    right: 15%;
  }

  :global(.dark) .glow-orb {
    opacity: 0.12;
  }

  /* 滚动动画 */
  .animate-scroll-left {
    animation: scroll-left 40s linear infinite;
  }

  .animate-scroll-right {
    animation: scroll-right 40s linear infinite;
  }

  @keyframes scroll-left {
    0% { transform: translateX(0); }
    100% { transform: translateX(-25%); }
  }

  @keyframes scroll-right {
    0% { transform: translateX(-25%); }
    100% { transform: translateX(0); }
  }

  /* 技能芯片 */
  .skill-chip {
    transition: transform 0.3s ease;
  }

  .skill-chip:hover {
    transform: translateY(-2px);
  }

  .chip-bg {
    background: var(--color-block);
    border: 1px solid var(--color-border);
  }

  .chip-border {
    border: 1px solid var(--color-accent);
    box-shadow: 0 0 12px -2px var(--color-accent);
  }

  /* 边缘遮罩 */
  .edge-mask {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 80px;
    z-index: 10;
    pointer-events: none;
  }

  .edge-left {
    left: 0;
    background: linear-gradient(to right, var(--color-background), transparent);
  }

  .edge-right {
    right: 0;
    background: linear-gradient(to left, var(--color-background), transparent);
  }

  /* 响应式 */
  @media (max-width: 640px) {
    .edge-mask {
      width: 40px;
    }
    .glow-orb {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .animate-scroll-left,
    .animate-scroll-right {
      animation: none;
    }
  }
</style>
