---
import config from "$config";
import i18nit from "$i18n/index";

interface Props {
  items: any[];
  locale: string;
}

const { items, locale } = Astro.props;
const t = i18nit(locale);

const basePath = locale === config.i18n.defaultLocale ? "" : `/${locale}`;

function getItemPath(item: any): string {
  const collection = item.collection;
  const id = item.id.split("/").slice(1).join("/").replace(/\.mdx?$/, "");
  return `${basePath}/${collection}/${id}`;
}

function formatDate(date: Date): string {
  return date.toLocaleDateString(locale === "zh-cn" ? "zh-CN" : "en-US", {
    year: "numeric",
    month: "short",
    day: "numeric",
  });
}
---

<div class="latest-flow">
  {items.map((item, index) => (
    <a
      href={getItemPath(item)}
      class="latest-item group"
      style={`--delay: ${index * 0.08}s`}
    >
      <span
        class:list={[
          "item-marker",
          item.collection === "note" ? "marker-note" : "marker-jotting",
        ]}
        aria-hidden="true"
      ></span>

      <div class="item-main">
        <h3 class="item-title">{item.data.title}</h3>
        {item.data.description && (
          <p class="item-desc">{item.data.description}</p>
        )}
      </div>

      <div class="item-meta">
        <time>{formatDate(item.data.timestamp)}</time>
        <span
          class:list={[
            "item-cat",
            item.collection === "note" ? "cat-note" : "cat-jotting",
          ]}
        >
          {item.collection === "note" ? t("navigation.note") : t("navigation.jotting")}
        </span>
      </div>
    </a>
  ))}

  {items.length === 0 && (
    <p class="text-center text-muted-foreground py-8">
      {t("home.heatmap.empty")}
    </p>
  )}
</div>

<style>
  .latest-flow {
    display: flex;
    flex-direction: column;
  }

  .latest-item {
    position: relative;
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding: 1.05rem 0.875rem;
    border-radius: 10px;
    opacity: 0;
    animation: item-rise 0.9s cubic-bezier(0.23, 1, 0.32, 1) forwards;
    animation-delay: var(--delay);
    transition: background-color 0.35s ease;
  }

  @keyframes item-rise {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* 条目间的水墨细线 */
  .latest-item + .latest-item::before {
    content: '';
    position: absolute;
    top: 0;
    left: 4%;
    right: 4%;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      color-mix(in srgb, var(--zen-border) 80%, transparent),
      transparent
    );
  }

  .latest-item:hover {
    background: linear-gradient(
      135deg,
      color-mix(in srgb, var(--zen-accent) 5%, transparent),
      transparent 70%
    );
  }

  /* 墨点引导（对齐标题首行） */
  .item-marker {
    flex-shrink: 0;
    align-self: flex-start;
    margin-top: 0.75rem;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    opacity: 0.55;
    transition: transform 0.4s ease, opacity 0.4s ease, box-shadow 0.4s ease;
  }

  .marker-note { background: var(--zen-accent); }
  .marker-jotting { background: var(--zen-gold); }

  .latest-item:hover .item-marker {
    transform: scale(1.4);
    opacity: 1;
  }

  .latest-item:hover .marker-note {
    box-shadow: 0 0 10px color-mix(in srgb, var(--zen-accent) 55%, transparent);
  }

  .latest-item:hover .marker-jotting {
    box-shadow: 0 0 10px color-mix(in srgb, var(--zen-gold) 55%, transparent);
  }

  .item-main {
    flex: 1;
    min-width: 0;
  }

  /* 楷体标题 + 悬浮时金竹渐变下划线晕开 */
  .item-title {
    display: inline;
    font-family: "LXGW WenKai", "霞鹜文楷", "Kaiti SC", "STKaiti", "楷体", var(--font-serif);
    font-size: 1.0625rem;
    font-weight: 400;
    letter-spacing: 0.03em;
    line-height: 1.8;
    color: color-mix(in srgb, var(--zen-foreground) 92%, transparent);
    background-image: linear-gradient(90deg, var(--zen-accent), var(--zen-gold));
    background-size: 0% 1px;
    background-repeat: no-repeat;
    background-position: 0 100%;
    padding-bottom: 2px;
    transition: background-size 0.5s cubic-bezier(0.23, 1, 0.32, 1), color 0.3s ease;
  }

  .latest-item:hover .item-title {
    color: var(--zen-foreground);
    background-size: 100% 1px;
  }

  .item-desc {
    font-size: 0.8125rem;
    color: var(--zen-muted-foreground);
    margin-top: 0.25rem;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
  }

  /* 右侧落款：日期 + 「分类」 */
  .item-meta {
    flex-shrink: 0;
    display: flex;
    align-items: baseline;
    gap: 0.875rem;
    font-size: 0.75rem;
    color: var(--zen-muted-foreground);
  }

  .item-meta time {
    font-variant-numeric: tabular-nums;
    opacity: 0.75;
  }

  .item-cat::before { content: '「'; opacity: 0.55; }
  .item-cat::after { content: '」'; opacity: 0.55; }

  .cat-note { color: var(--zen-accent); }
  .cat-jotting { color: var(--zen-gold); }

  /* 移动端：日期分类换行到标题下 */
  @media (max-width: 640px) {
    .latest-item {
      flex-wrap: wrap;
      gap: 0.375rem 0.875rem;
      padding: 0.95rem 0.5rem;
    }

    .item-main {
      flex-basis: calc(100% - 1.6rem);
    }

    .item-meta {
      margin-left: 1.6rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .latest-item {
      animation: none;
      opacity: 1;
    }
  }
</style>
