---
/**
 * 禅意特效组件 - 量子纠缠版 v8
 * 电子无规则运动 + 粒子连线 + 仙气氛围
 */
---

<!-- 仙境氛围层 -->
<div class="zen-realm" aria-hidden="true">
  <div class="zen-glow zen-glow-1"></div>
  <div class="zen-glow zen-glow-2"></div>
</div>

<!-- 鼠标跟随光标 -->
<div id="cursor-glow" class="cursor-glow" aria-hidden="true"></div>
<div id="cursor-dot" class="cursor-dot" aria-hidden="true"></div>

<!-- 主画布 -->
<canvas id="zen-canvas" class="zen-canvas" aria-hidden="true"></canvas>

<style>
  .zen-realm {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    overflow: hidden;
  }

  .zen-glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(100px);
    opacity: 0.4;
    animation: float-glow 25s ease-in-out infinite;
  }

  /* 浅色模式：暖橙 + 粉金色背景光晕 */
  .zen-glow-1 {
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, hsla(35, 85%, 70%, 0.25) 0%, transparent 70%);
    top: -15%;
    left: -10%;
  }

  .zen-glow-2 {
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, hsla(350, 70%, 75%, 0.2) 0%, transparent 70%);
    bottom: -10%;
    right: -10%;
    animation-delay: -12s;
  }

  /* 深色模式：青蓝 + 紫色背景光晕 */
  :global(.dark) .zen-glow-1 {
    background: radial-gradient(circle, hsla(200, 90%, 55%, 0.4) 0%, transparent 70%);
    opacity: 0.5;
  }

  :global(.dark) .zen-glow-2 {
    background: radial-gradient(circle, hsla(260, 80%, 60%, 0.35) 0%, transparent 70%);
    opacity: 0.5;
  }

  @keyframes float-glow {
    0%, 100% { transform: translate(0, 0) scale(1); }
    33% { transform: translate(80px, 40px) scale(1.1); }
    66% { transform: translate(-40px, 80px) scale(0.9); }
  }

  /* 浅色模式：暖橙金色光标 */
  .cursor-glow {
    position: fixed;
    width: 200px;
    height: 200px;
    border-radius: 50%;
    pointer-events: none;
    z-index: 9998;
    transform: translate(-50%, -50%);
    background: radial-gradient(circle, hsla(35, 80%, 65%, 0.18) 0%, transparent 70%);
    filter: blur(15px);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  /* 深色模式：青蓝色光标 */
  :global(.dark) .cursor-glow {
    background: radial-gradient(circle, hsla(200, 80%, 65%, 0.25) 0%, transparent 70%);
  }

  .cursor-dot {
    position: fixed;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    pointer-events: none;
    z-index: 9999;
    transform: translate(-50%, -50%);
    background: hsla(35, 85%, 70%, 0.9);
    box-shadow: 0 0 15px 5px hsla(35, 90%, 60%, 0.4);
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  :global(.dark) .cursor-dot {
    background: hsla(200, 80%, 90%, 1);
    box-shadow: 0 0 20px 8px hsla(200, 90%, 70%, 0.5);
  }

  .zen-canvas {
    position: fixed;
    inset: 0;
    pointer-events: none;
    width: 100%;
    height: 100%;
    z-index: 2;
  }

  @media (prefers-reduced-motion: reduce) {
    .zen-canvas, .zen-realm, .cursor-glow, .cursor-dot { display: none; }
  }
</style>

<script>
  (function() {
    let canvas: HTMLCanvasElement | null = null;
    let ctx: CanvasRenderingContext2D | null = null;
    let cursorGlow: HTMLElement | null = null;
    let cursorDot: HTMLElement | null = null;
    let animationId: number | null = null;
    let width = 0;
    let height = 0;

    // 鼠标
    let mouseX = -1000;
    let mouseY = -1000;
    let targetX = -1000;
    let targetY = -1000;
    let glowX = -1000;
    let glowY = -1000;
    let isMouseInside = false;

    // 量子粒子
    interface Quantum {
      x: number;
      y: number;
      vx: number;
      vy: number;
      ax: number;
      ay: number;
      size: number;
      hue: number;
      energy: number;
      phase: number;
    }
    let particles: Quantum[] = [];

    // 鼠标拖尾
    interface Trail { x: number; y: number; age: number; }
    let trails: Trail[] = [];

    const PARTICLE_COUNT = 85;
    const CONNECTION_DIST = 150;
    const MOUSE_INFLUENCE = 200;

    // 高斯随机分布（中心偏向）
    function gaussianRandom(): number {
      // Box-Muller 变换，生成标准正态分布
      const u1 = Math.random();
      const u2 = Math.random();
      return Math.sqrt(-2 * Math.log(u1)) * Math.cos(2 * Math.PI * u2);
    }

    // 生成中心偏向的位置
    function centerBiasedPosition(size: number, center: number): number {
      // 标准差为屏幕尺寸的 1/3，使大部分粒子集中在中心区域
      const std = size / 3;
      let pos = center + gaussianRandom() * std;
      // 边界限制，超出边界的粒子随机放置
      if (pos < 0 || pos > size) {
        pos = Math.random() * size;
      }
      return pos;
    }

    function init() {
      canvas = document.getElementById('zen-canvas') as HTMLCanvasElement;
      cursorGlow = document.getElementById('cursor-glow');
      cursorDot = document.getElementById('cursor-dot');

      if (!canvas) return;
      ctx = canvas.getContext('2d');
      if (!ctx) return;

      resize();
      initParticles();

      window.addEventListener('resize', resize);
      document.addEventListener('mousemove', onMouseMove);
      document.addEventListener('mouseenter', () => { isMouseInside = true; showCursor(); });
      document.addEventListener('mouseleave', () => { isMouseInside = false; hideCursor(); });

      animate();
    }

    function resize() {
      if (!canvas) return;
      width = window.innerWidth;
      height = window.innerHeight;
      canvas.width = width;
      canvas.height = height;
      initParticles();
    }

    function initParticles() {
      particles = [];
      const isDark = document.documentElement.classList.contains('dark');
      const centerX = width / 2;
      const centerY = height / 2;

      for (let i = 0; i < PARTICLE_COUNT; i++) {
        // 深色模式：青蓝紫色调 (180-260)
        // 浅色模式：暖橙粉金色调 (20-60) 混合少量青色 (180-200)
        let hue: number;
        if (isDark) {
          hue = 180 + Math.random() * 80; // 青蓝紫
        } else {
          // 70% 暖色调，30% 清新青色
          hue = Math.random() > 0.3
            ? 20 + Math.random() * 40   // 暖橙粉金
            : 180 + Math.random() * 20; // 清新青色点缀
        }

        particles.push({
          x: centerBiasedPosition(width, centerX),
          y: centerBiasedPosition(height, centerY),
          vx: (Math.random() - 0.5) * 2,
          vy: (Math.random() - 0.5) * 2,
          ax: 0,
          ay: 0,
          size: 2 + Math.random() * 3,
          hue,
          energy: 0.5 + Math.random() * 0.5,
          phase: Math.random() * Math.PI * 2
        });
      }
    }

    function showCursor() {
      if (cursorGlow) cursorGlow.style.opacity = '1';
      if (cursorDot) cursorDot.style.opacity = '1';
    }

    function hideCursor() {
      if (cursorGlow) cursorGlow.style.opacity = '0';
      if (cursorDot) cursorDot.style.opacity = '0';
    }

    function onMouseMove(e: MouseEvent) {
      targetX = e.clientX;
      targetY = e.clientY;
      isMouseInside = true;
      showCursor();

      trails.unshift({ x: targetX, y: targetY, age: 0 });
      if (trails.length > 20) trails.pop();
    }

    function update() {
      // 鼠标平滑跟随
      mouseX += (targetX - mouseX) * 0.12;
      mouseY += (targetY - mouseY) * 0.12;
      glowX += (targetX - glowX) * 0.06;
      glowY += (targetY - glowY) * 0.06;

      if (cursorDot) {
        cursorDot.style.left = mouseX + 'px';
        cursorDot.style.top = mouseY + 'px';
      }
      if (cursorGlow) {
        cursorGlow.style.left = glowX + 'px';
        cursorGlow.style.top = glowY + 'px';
      }

      // 更新量子粒子 - 布朗运动
      particles.forEach(p => {
        // 随机加速度（量子不确定性）
        p.ax = (Math.random() - 0.5) * 0.3;
        p.ay = (Math.random() - 0.5) * 0.3;

        // 鼠标影响 - 斥力场
        if (isMouseInside) {
          const dx = p.x - mouseX;
          const dy = p.y - mouseY;
          const dist = Math.sqrt(dx * dx + dy * dy);
          if (dist < MOUSE_INFLUENCE && dist > 0) {
            const force = (MOUSE_INFLUENCE - dist) / MOUSE_INFLUENCE;
            const repel = force * force * 2;
            p.ax += (dx / dist) * repel;
            p.ay += (dy / dist) * repel;
          }
        }

        // 速度更新
        p.vx += p.ax;
        p.vy += p.ay;

        // 阻尼
        p.vx *= 0.98;
        p.vy *= 0.98;

        // 速度限制
        const speed = Math.sqrt(p.vx * p.vx + p.vy * p.vy);
        if (speed > 4) {
          p.vx = (p.vx / speed) * 4;
          p.vy = (p.vy / speed) * 4;
        }

        // 位置更新
        p.x += p.vx;
        p.y += p.vy;

        // 边界反弹
        if (p.x < 0) { p.x = 0; p.vx *= -0.8; }
        if (p.x > width) { p.x = width; p.vx *= -0.8; }
        if (p.y < 0) { p.y = 0; p.vy *= -0.8; }
        if (p.y > height) { p.y = height; p.vy *= -0.8; }

        // 能量脉冲
        p.phase += 0.05;
        p.energy = 0.5 + 0.3 * Math.sin(p.phase);
      });

      // 更新拖尾
      trails.forEach(t => t.age++);
      trails = trails.filter(t => t.age < 25);
    }

    function draw() {
      if (!ctx) return;
      ctx.clearRect(0, 0, width, height);

      const isDark = document.documentElement.classList.contains('dark');

      // 绘制量子纠缠连线
      for (let i = 0; i < particles.length; i++) {
        for (let j = i + 1; j < particles.length; j++) {
          const p1 = particles[i];
          const p2 = particles[j];
          const dx = p2.x - p1.x;
          const dy = p2.y - p1.y;
          const dist = Math.sqrt(dx * dx + dy * dy);

          if (dist < CONNECTION_DIST) {
            const alpha = (1 - dist / CONNECTION_DIST) * 0.5;
            const avgHue = (p1.hue + p2.hue) / 2;

            // 纠缠连线
            ctx.strokeStyle = isDark
              ? `hsla(${avgHue}, 70%, 70%, ${alpha})`
              : `hsla(${avgHue}, 50%, 60%, ${alpha * 0.7})`;
            ctx.lineWidth = 1;
            ctx.beginPath();
            ctx.moveTo(p1.x, p1.y);
            ctx.lineTo(p2.x, p2.y);
            ctx.stroke();

            // 纠缠能量脉冲（中点光点）
            if (dist < CONNECTION_DIST * 0.5 && Math.random() > 0.95) {
              const midX = (p1.x + p2.x) / 2;
              const midY = (p1.y + p2.y) / 2;
              const pulseGrad = ctx.createRadialGradient(midX, midY, 0, midX, midY, 8);
              pulseGrad.addColorStop(0, isDark
                ? `hsla(${avgHue}, 80%, 80%, 0.8)`
                : `hsla(${avgHue}, 60%, 75%, 0.6)`);
              pulseGrad.addColorStop(1, `hsla(${avgHue}, 70%, 70%, 0)`);
              ctx.fillStyle = pulseGrad;
              ctx.beginPath();
              ctx.arc(midX, midY, 8, 0, Math.PI * 2);
              ctx.fill();
            }
          }
        }
      }

      // 绘制量子粒子
      particles.forEach(p => {
        const currentSize = p.size * (0.8 + p.energy * 0.4);

        // 外层光晕
        const glowRadius = currentSize * 6;
        const glow = ctx!.createRadialGradient(p.x, p.y, 0, p.x, p.y, glowRadius);
        if (isDark) {
          glow.addColorStop(0, `hsla(${p.hue}, 80%, 80%, ${p.energy * 0.6})`);
          glow.addColorStop(0.4, `hsla(${p.hue}, 70%, 70%, ${p.energy * 0.25})`);
          glow.addColorStop(1, `hsla(${p.hue}, 60%, 60%, 0)`);
        } else {
          glow.addColorStop(0, `hsla(${p.hue}, 60%, 75%, ${p.energy * 0.4})`);
          glow.addColorStop(0.4, `hsla(${p.hue}, 50%, 70%, ${p.energy * 0.15})`);
          glow.addColorStop(1, `hsla(${p.hue}, 40%, 65%, 0)`);
        }
        ctx!.fillStyle = glow;
        ctx!.beginPath();
        ctx!.arc(p.x, p.y, glowRadius, 0, Math.PI * 2);
        ctx!.fill();

        // 核心粒子
        const coreGrad = ctx!.createRadialGradient(p.x, p.y, 0, p.x, p.y, currentSize);
        coreGrad.addColorStop(0, `hsla(0, 0%, 100%, ${p.energy})`);
        coreGrad.addColorStop(0.5, `hsla(${p.hue}, 70%, 85%, ${p.energy * 0.8})`);
        coreGrad.addColorStop(1, `hsla(${p.hue}, 60%, 70%, 0)`);
        ctx!.fillStyle = coreGrad;
        ctx!.beginPath();
        ctx!.arc(p.x, p.y, currentSize, 0, Math.PI * 2);
        ctx!.fill();
      });

      // 鼠标与粒子的连线
      if (isMouseInside) {
        particles.forEach(p => {
          const dx = p.x - mouseX;
          const dy = p.y - mouseY;
          const dist = Math.sqrt(dx * dx + dy * dy);

          if (dist < MOUSE_INFLUENCE) {
            const alpha = (1 - dist / MOUSE_INFLUENCE) * 0.4;
            // 使用粒子自身颜色
            ctx!.strokeStyle = isDark
              ? `hsla(${p.hue}, 80%, 80%, ${alpha})`
              : `hsla(${p.hue}, 65%, 60%, ${alpha * 0.7})`;
            ctx!.lineWidth = 0.8;
            ctx!.beginPath();
            ctx!.moveTo(mouseX, mouseY);
            ctx!.lineTo(p.x, p.y);
            ctx!.stroke();
          }
        });
      }

      // 鼠标拖尾
      if (trails.length > 1) {
        for (let i = 1; i < trails.length; i++) {
          const t = trails[i];
          const prev = trails[i - 1];
          const progress = 1 - t.age / 25;
          if (progress <= 0) continue;

          const alpha = progress * 0.4;
          const size = progress * 4;

          const grad = ctx!.createRadialGradient(t.x, t.y, 0, t.x, t.y, size * 2);
          // 深色：青蓝色拖尾，浅色：暖橙色拖尾
          const trailHue = isDark ? 200 : 35;
          grad.addColorStop(0, isDark
            ? `hsla(${trailHue}, 80%, 85%, ${alpha})`
            : `hsla(${trailHue}, 70%, 70%, ${alpha * 0.8})`);
          grad.addColorStop(1, `hsla(${trailHue}, 70%, 75%, 0)`);
          ctx!.fillStyle = grad;
          ctx!.beginPath();
          ctx!.arc(t.x, t.y, size * 2, 0, Math.PI * 2);
          ctx!.fill();
        }
      }
    }

    function animate() {
      update();
      draw();
      animationId = requestAnimationFrame(animate);
    }

    // 监听主题切换，重新初始化粒子颜色
    let themeObserver: MutationObserver | null = null;

    function setupThemeObserver() {
      themeObserver = new MutationObserver((mutations) => {
        for (const mutation of mutations) {
          if (mutation.attributeName === 'class') {
            // 主题变化时重新生成粒子（获取新配色）
            initParticles();
            break;
          }
        }
      });
      themeObserver.observe(document.documentElement, { attributes: true });
    }

    function cleanup() {
      if (animationId) cancelAnimationFrame(animationId);
      if (themeObserver) themeObserver.disconnect();
      window.removeEventListener('resize', resize);
      document.removeEventListener('mousemove', onMouseMove);
    }

    function fullInit() {
      init();
      setupThemeObserver();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', fullInit);
    } else {
      fullInit();
    }

    document.addEventListener('astro:before-swap', cleanup);
    document.addEventListener('astro:after-swap', fullInit);
  })();
</script>
