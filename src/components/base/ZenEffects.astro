---
/**
 * 禅意特效组件 v9
 * 浅色模式：量子粒子 + 连线（仅桌面端）
 * 深色模式：夜禅 —— 月色 + 疏星 + 萤火，无连线，安静克制
 * 移动端 / 触屏：关闭 canvas，仅保留 CSS 氛围层
 */

// 构建期生成静态星点位置（CSS 星，移动端也可见）
const cssStars = Array.from({ length: 10 }).map(() => ({
  top: `${5 + Math.random() * 55}%`,
  left: `${Math.random() * 96}%`,
  size: 1.5 + Math.random() * 1.5,
  duration: 3 + Math.random() * 5,
  delay: Math.random() * 6,
}));
---

<!-- 仙境氛围层（persist：跨导航保留，避免动画重启） -->
<div class="zen-realm" aria-hidden="true" transition:persist="zen-realm">
  <div class="zen-glow zen-glow-1"></div>
  <div class="zen-glow zen-glow-2"></div>
  <!-- 月亮（仅深色模式） -->
  <div class="zen-moon"></div>
  <!-- CSS 静态星（仅深色模式） -->
  {cssStars.map((s) => (
    <span
      class="zen-star"
      style={`top: ${s.top}; left: ${s.left}; width: ${s.size}px; height: ${s.size}px; --tw-dur: ${s.duration}s; --tw-delay: ${s.delay}s;`}
    ></span>
  ))}
</div>

<!-- 鼠标跟随光标 -->
<div id="cursor-glow" class="cursor-glow" aria-hidden="true" transition:persist="zen-cursor-glow"></div>
<div id="cursor-dot" class="cursor-dot" aria-hidden="true" transition:persist="zen-cursor-dot"></div>

<!-- 主画布 -->
<canvas id="zen-canvas" class="zen-canvas" aria-hidden="true" transition:persist="zen-canvas"></canvas>

<style>
  .zen-realm {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: var(--z-realm);
    overflow: hidden;
  }

  .zen-glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(100px);
    opacity: 0.4;
    animation: float-glow 25s ease-in-out infinite;
  }

  /* 浅色模式：暖橙 + 粉金色背景光晕 */
  .zen-glow-1 {
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, hsla(35, 85%, 70%, 0.25) 0%, transparent 70%);
    top: -15%;
    left: -10%;
  }

  .zen-glow-2 {
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, hsla(350, 70%, 75%, 0.2) 0%, transparent 70%);
    bottom: -10%;
    right: -10%;
    animation-delay: -12s;
  }

  /* 深色模式：暖金 + 竹青背景光晕，安静低调 */
  :global(.dark) .zen-glow-1 {
    background: radial-gradient(circle, hsla(45, 50%, 48%, 0.16) 0%, transparent 70%);
    opacity: 0.4;
  }

  :global(.dark) .zen-glow-2 {
    background: radial-gradient(circle, hsla(150, 25%, 40%, 0.14) 0%, transparent 70%);
    opacity: 0.4;
  }

  @keyframes float-glow {
    0%, 100% { transform: translate(0, 0) scale(1); }
    33% { transform: translate(80px, 40px) scale(1.1); }
    66% { transform: translate(-40px, 80px) scale(0.9); }
  }

  /* ===== 月亮（仅深色模式） ===== */
  .zen-moon {
    display: none;
  }

  :global(.dark) .zen-moon {
    display: block;
    position: absolute;
    top: 9%;
    right: 9%;
    width: 110px;
    height: 110px;
    border-radius: 50%;
    background: radial-gradient(
      circle at 40% 38%,
      hsla(47, 55%, 92%, 0.8),
      hsla(45, 45%, 80%, 0.28) 58%,
      transparent 74%
    );
    box-shadow: 0 0 70px 28px hsla(45, 60%, 72%, 0.1);
    filter: blur(1.5px);
    opacity: 0.5;
    animation: moon-breathe 16s ease-in-out infinite;
  }

  @keyframes moon-breathe {
    0%, 100% { opacity: 0.45; }
    50% { opacity: 0.6; }
  }

  /* 移动端没有留白边距，桌面端尺寸的月亮会压在正文上方，缩小调暗 */
  @media (max-width: 767px) {
    :global(.dark) .zen-moon {
      width: 64px;
      height: 64px;
      top: 6%;
      right: 6%;
      box-shadow: 0 0 36px 12px hsla(45, 60%, 72%, 0.06);
      opacity: 0.3;
      animation: none;
    }
  }

  /* ===== CSS 静态星（仅深色模式，移动端同样可见） ===== */
  .zen-star {
    display: none;
  }

  :global(.dark) .zen-star {
    display: block;
    position: absolute;
    border-radius: 50%;
    background: hsla(45, 45%, 88%, 0.9);
    animation: star-twinkle var(--tw-dur, 4s) ease-in-out var(--tw-delay, 0s) infinite;
  }

  @keyframes star-twinkle {
    0%, 100% { opacity: 0.12; transform: scale(0.85); }
    50% { opacity: 0.75; transform: scale(1); }
  }

  /* 浅色模式：暖橙金色光标。
     位置全部由 JS 写 transform（合成层），不再逐帧改 left/top：
     一个 200px 且带 blur 的固定元素每帧触发布局 + 重绘，是此前最贵的一笔开销。
     will-change 只给这两个持续运动的元素，且图层很小（200px / 8px） */
  .cursor-glow {
    position: fixed;
    top: 0;
    left: 0;
    width: 200px;
    height: 200px;
    border-radius: 50%;
    pointer-events: none;
    z-index: var(--z-cursor);
    transform: translate(-50%, -50%);
    will-change: transform;
    background: radial-gradient(circle, hsla(35, 80%, 65%, 0.18) 0%, transparent 70%);
    filter: blur(15px);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  /* 深色模式：暖金色光标 */
  :global(.dark) .cursor-glow {
    background: radial-gradient(circle, hsla(45, 65%, 60%, 0.14) 0%, transparent 70%);
  }

  .cursor-dot {
    position: fixed;
    top: 0;
    left: 0;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    pointer-events: none;
    z-index: calc(var(--z-cursor) + 1);
    transform: translate(-50%, -50%);
    will-change: transform;
    background: hsla(35, 85%, 70%, 0.9);
    box-shadow: 0 0 15px 5px hsla(35, 90%, 60%, 0.4);
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  :global(.dark) .cursor-dot {
    background: hsla(45, 75%, 86%, 0.95);
    box-shadow: 0 0 14px 5px hsla(45, 80%, 60%, 0.3);
  }

  .zen-canvas {
    position: fixed;
    inset: 0;
    pointer-events: none;
    width: 100%;
    height: 100%;
    z-index: var(--z-canvas);
  }

  /* 触屏设备隐藏光标特效 */
  @media (hover: none), (pointer: coarse) {
    .cursor-glow,
    .cursor-dot {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .zen-canvas, .cursor-glow, .cursor-dot { display: none; }
    .zen-glow, .zen-moon, .zen-star { animation: none; }
  }
</style>

<script>
  (function() {
    let canvas: HTMLCanvasElement | null = null;
    let ctx: CanvasRenderingContext2D | null = null;
    let cursorGlow: HTMLElement | null = null;
    let cursorDot: HTMLElement | null = null;
    let animationId: number | null = null;
    let width = 0;
    let height = 0;

    // 鼠标
    let mouseX = -1000;
    let mouseY = -1000;
    let targetX = -1000;
    let targetY = -1000;
    let glowX = -1000;
    let glowY = -1000;
    let isMouseInside = false;

    // ===== 浅色模式：量子粒子 =====
    interface Quantum {
      x: number; y: number;
      vx: number; vy: number;
      ax: number; ay: number;
      size: number; hue: number;
      energy: number; phase: number;
    }
    let particles: Quantum[] = [];

    // ===== 深色模式：夜禅（星 + 萤火） =====
    interface Star { x: number; y: number; size: number; phase: number; speed: number; }
    interface Firefly { x: number; y: number; vx: number; vy: number; size: number; phase: number; pulseSpeed: number; }
    let stars: Star[] = [];
    let fireflies: Firefly[] = [];

    // 鼠标拖尾（仅浅色）
    interface Trail { x: number; y: number; age: number; }
    let trails: Trail[] = [];

    const PARTICLE_COUNT = 85;
    const CONNECTION_DIST = 150;
    const MOUSE_INFLUENCE = 200;

    function isDarkMode(): boolean {
      return document.documentElement.classList.contains('dark');
    }

    // 移动端 / 触屏 / 减少动态偏好时不启用 canvas
    function canvasEnabled(): boolean {
      const coarse = window.matchMedia('(hover: none), (pointer: coarse)').matches;
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      return !coarse && !reduced && window.innerWidth >= 768;
    }

    // ===== 贴图缓存：径向渐变预渲染为离屏 canvas =====
    // 每帧 drawImage 远比每帧 createRadialGradient 便宜
    const spriteCache = new Map<string, HTMLCanvasElement>();

    function makeSprite(key: string, render: (c: CanvasRenderingContext2D, size: number) => void, size = 64): HTMLCanvasElement {
      let sprite = spriteCache.get(key);
      if (sprite) return sprite;
      sprite = document.createElement('canvas');
      sprite.width = size;
      sprite.height = size;
      const sctx = sprite.getContext('2d')!;
      render(sctx, size);
      spriteCache.set(key, sprite);
      return sprite;
    }

    // hue 取整到 4°，控制缓存数量
    function bucketHue(hue: number): number {
      return Math.round(hue / 4) * 4;
    }

    function glowSprite(hue: number): HTMLCanvasElement {
      const h = bucketHue(hue);
      return makeSprite(`glow-${h}`, (c, s) => {
        const r = s / 2;
        const g = c.createRadialGradient(r, r, 0, r, r, r);
        g.addColorStop(0, `hsla(${h}, 60%, 75%, 0.4)`);
        g.addColorStop(0.4, `hsla(${h}, 50%, 70%, 0.15)`);
        g.addColorStop(1, `hsla(${h}, 40%, 65%, 0)`);
        c.fillStyle = g;
        c.fillRect(0, 0, s, s);
      });
    }

    function coreSprite(hue: number): HTMLCanvasElement {
      const h = bucketHue(hue);
      return makeSprite(`core-${h}`, (c, s) => {
        const r = s / 2;
        const g = c.createRadialGradient(r, r, 0, r, r, r);
        g.addColorStop(0, 'hsla(0, 0%, 100%, 1)');
        g.addColorStop(0.5, `hsla(${h}, 70%, 85%, 0.8)`);
        g.addColorStop(1, `hsla(${h}, 60%, 70%, 0)`);
        c.fillStyle = g;
        c.fillRect(0, 0, s, s);
      }, 32);
    }

    function fireflySprite(): HTMLCanvasElement {
      return makeSprite('firefly', (c, s) => {
        const r = s / 2;
        const g = c.createRadialGradient(r, r, 0, r, r, r);
        g.addColorStop(0, 'hsla(46, 75%, 65%, 1)');
        g.addColorStop(0.5, 'hsla(46, 65%, 58%, 0.35)');
        g.addColorStop(1, 'hsla(46, 60%, 55%, 0)');
        c.fillStyle = g;
        c.fillRect(0, 0, s, s);
      });
    }

    function trailSprite(hue: number): HTMLCanvasElement {
      const h = bucketHue(hue);
      return makeSprite(`trail-${h}`, (c, s) => {
        const r = s / 2;
        const g = c.createRadialGradient(r, r, 0, r, r, r);
        g.addColorStop(0, `hsla(${h}, 70%, 70%, 0.8)`);
        g.addColorStop(1, `hsla(${h}, 70%, 75%, 0)`);
        c.fillStyle = g;
        c.fillRect(0, 0, s, s);
      }, 32);
    }

    // 高斯随机分布（中心偏向）
    function gaussianRandom(): number {
      // Math.random() 可能返回 0 → Math.log(0) = -Infinity → 坐标变 NaN 把粒子永久卡死，
      // 用 EPSILON 兜底确保 u1 > 0
      const u1 = Math.random() || Number.EPSILON;
      const u2 = Math.random();
      return Math.sqrt(-2 * Math.log(u1)) * Math.cos(2 * Math.PI * u2);
    }

    function centerBiasedPosition(size: number, center: number): number {
      const std = size / 3;
      let pos = center + gaussianRandom() * std;
      if (pos < 0 || pos > size) {
        pos = Math.random() * size;
      }
      return pos;
    }

    function init() {
      if (!canvasEnabled()) return;

      canvas = document.getElementById('zen-canvas') as HTMLCanvasElement;
      cursorGlow = document.getElementById('cursor-glow');
      cursorDot = document.getElementById('cursor-dot');

      if (!canvas) return;
      ctx = canvas.getContext('2d');
      if (!ctx) return;

      resize();
      initScene();

      window.addEventListener('resize', onResize);
      document.addEventListener('mousemove', onMouseMove);
      document.addEventListener('mouseenter', () => { isMouseInside = true; showCursor(); });
      document.addEventListener('mouseleave', () => { isMouseInside = false; hideCursor(); });

      animate();
    }

    function resize() {
      if (!canvas) return;
      width = window.innerWidth;
      height = window.innerHeight;
      canvas.width = width;
      canvas.height = height;
      initScene();
    }

    // resize 防抖，避免拖动窗口时频繁重建场景
    let resizeTimer: ReturnType<typeof setTimeout> | null = null;
    function onResize() {
      if (resizeTimer) clearTimeout(resizeTimer);
      resizeTimer = setTimeout(resize, 150);
    }

    function initScene() {
      if (isDarkMode()) {
        initNight();
      } else {
        initParticles();
      }
    }

    // ===== 浅色：量子粒子初始化 =====
    function initParticles() {
      particles = [];
      const centerX = width / 2;
      const centerY = height / 2;

      for (let i = 0; i < PARTICLE_COUNT; i++) {
        // 70% 暖色调，30% 清新青色
        const hue = Math.random() > 0.3
          ? 20 + Math.random() * 40   // 暖橙粉金
          : 180 + Math.random() * 20; // 清新青色点缀

        particles.push({
          x: centerBiasedPosition(width, centerX),
          y: centerBiasedPosition(height, centerY),
          vx: (Math.random() - 0.5) * 2,
          vy: (Math.random() - 0.5) * 2,
          ax: 0,
          ay: 0,
          size: 2 + Math.random() * 3,
          hue,
          energy: 0.5 + Math.random() * 0.5,
          phase: Math.random() * Math.PI * 2
        });
      }
    }

    // ===== 深色：夜禅初始化 =====
    function initNight() {
      stars = [];
      const starCount = Math.min(80, Math.floor((width * height) / 22000));
      for (let i = 0; i < starCount; i++) {
        stars.push({
          x: Math.random() * width,
          y: Math.random() * height * 0.85,
          size: 0.5 + Math.random() * 1.3,
          phase: Math.random() * Math.PI * 2,
          speed: 0.004 + Math.random() * 0.012,
        });
      }

      fireflies = [];
      for (let i = 0; i < 9; i++) {
        fireflies.push({
          x: Math.random() * width,
          y: height * (0.25 + Math.random() * 0.65),
          vx: (Math.random() - 0.5) * 0.3,
          vy: (Math.random() - 0.5) * 0.2,
          size: 1.8 + Math.random() * 1.8,
          phase: Math.random() * Math.PI * 2,
          pulseSpeed: 0.008 + Math.random() * 0.014,
        });
      }
    }

    function showCursor() {
      if (cursorGlow) cursorGlow.style.opacity = '1';
      if (cursorDot) cursorDot.style.opacity = '1';
    }

    function hideCursor() {
      if (cursorGlow) cursorGlow.style.opacity = '0';
      if (cursorDot) cursorDot.style.opacity = '0';
    }

    function onMouseMove(e: MouseEvent) {
      targetX = e.clientX;
      targetY = e.clientY;
      isMouseInside = true;
      showCursor();

      if (!isDarkMode()) {
        trails.unshift({ x: targetX, y: targetY, age: 0 });
        if (trails.length > 20) trails.pop();
      }
    }

    function updateCursor() {
      // 光标已静止时跳过写入，避免每帧无意义的样式失效
      if (Math.abs(targetX - glowX) < 0.1 && Math.abs(targetY - glowY) < 0.1 &&
          Math.abs(targetX - mouseX) < 0.1 && Math.abs(targetY - mouseY) < 0.1) {
        return;
      }

      mouseX += (targetX - mouseX) * 0.12;
      mouseY += (targetY - mouseY) * 0.12;
      glowX += (targetX - glowX) * 0.06;
      glowY += (targetY - glowY) * 0.06;

      // 只写 transform：合成器直接搬图层，不触发布局 / 重绘
      if (cursorDot) {
        cursorDot.style.transform = `translate3d(${mouseX}px, ${mouseY}px, 0) translate(-50%, -50%)`;
      }
      if (cursorGlow) {
        cursorGlow.style.transform = `translate3d(${glowX}px, ${glowY}px, 0) translate(-50%, -50%)`;
      }
    }

    // ===== 浅色：量子粒子更新 =====
    function updateParticles() {
      particles.forEach(p => {
        p.ax = (Math.random() - 0.5) * 0.3;
        p.ay = (Math.random() - 0.5) * 0.3;

        if (isMouseInside) {
          const dx = p.x - mouseX;
          const dy = p.y - mouseY;
          const dist = Math.sqrt(dx * dx + dy * dy);
          if (dist < MOUSE_INFLUENCE && dist > 0) {
            const force = (MOUSE_INFLUENCE - dist) / MOUSE_INFLUENCE;
            const repel = force * force * 2;
            p.ax += (dx / dist) * repel;
            p.ay += (dy / dist) * repel;
          }
        }

        p.vx += p.ax;
        p.vy += p.ay;
        p.vx *= 0.98;
        p.vy *= 0.98;

        const speed = Math.sqrt(p.vx * p.vx + p.vy * p.vy);
        if (speed > 4) {
          p.vx = (p.vx / speed) * 4;
          p.vy = (p.vy / speed) * 4;
        }

        p.x += p.vx;
        p.y += p.vy;

        if (p.x < 0) { p.x = 0; p.vx *= -0.8; }
        if (p.x > width) { p.x = width; p.vx *= -0.8; }
        if (p.y < 0) { p.y = 0; p.vy *= -0.8; }
        if (p.y > height) { p.y = height; p.vy *= -0.8; }

        p.phase += 0.05;
        p.energy = 0.5 + 0.3 * Math.sin(p.phase);
      });

      trails.forEach(t => t.age++);
      trails = trails.filter(t => t.age < 25);
    }

    // ===== 深色：夜禅更新 =====
    function updateNight() {
      stars.forEach(s => {
        s.phase += s.speed;
      });

      fireflies.forEach(f => {
        f.phase += f.pulseSpeed;

        // 缓慢漫游
        f.vx += (Math.random() - 0.5) * 0.02;
        f.vy += (Math.random() - 0.5) * 0.018;

        const speed = Math.sqrt(f.vx * f.vx + f.vy * f.vy);
        const maxSpeed = 0.35;
        if (speed > maxSpeed) {
          f.vx = (f.vx / speed) * maxSpeed;
          f.vy = (f.vy / speed) * maxSpeed;
        }

        f.x += f.vx;
        f.y += f.vy;

        // 越界环绕
        const m = 30;
        if (f.x < -m) f.x = width + m;
        if (f.x > width + m) f.x = -m;
        if (f.y < height * 0.1) { f.y = height * 0.1; f.vy *= -1; }
        if (f.y > height + m) f.y = height * 0.3;
      });
    }

    // ===== 浅色：量子粒子绘制 =====
    function drawParticles() {
      if (!ctx) return;

      for (let i = 0; i < particles.length; i++) {
        for (let j = i + 1; j < particles.length; j++) {
          const p1 = particles[i];
          const p2 = particles[j];
          const dx = p2.x - p1.x;
          const dy = p2.y - p1.y;
          const dist = Math.sqrt(dx * dx + dy * dy);

          if (dist < CONNECTION_DIST) {
            const alpha = (1 - dist / CONNECTION_DIST) * 0.5;
            const avgHue = (p1.hue + p2.hue) / 2;

            ctx.strokeStyle = `hsla(${avgHue}, 50%, 60%, ${alpha * 0.7})`;
            ctx.lineWidth = 1;
            ctx.beginPath();
            ctx.moveTo(p1.x, p1.y);
            ctx.lineTo(p2.x, p2.y);
            ctx.stroke();

            if (dist < CONNECTION_DIST * 0.5 && Math.random() > 0.95) {
              const midX = (p1.x + p2.x) / 2;
              const midY = (p1.y + p2.y) / 2;
              ctx.globalAlpha = 0.6;
              ctx.drawImage(glowSprite(avgHue), midX - 8, midY - 8, 16, 16);
              ctx.globalAlpha = 1;
            }
          }
        }
      }

      // 贴图绘制：避免每帧创建径向渐变
      particles.forEach(p => {
        const currentSize = p.size * (0.8 + p.energy * 0.4);
        const glowRadius = currentSize * 6;

        ctx!.globalAlpha = p.energy;
        ctx!.drawImage(glowSprite(p.hue), p.x - glowRadius, p.y - glowRadius, glowRadius * 2, glowRadius * 2);
        ctx!.drawImage(coreSprite(p.hue), p.x - currentSize, p.y - currentSize, currentSize * 2, currentSize * 2);
      });
      ctx!.globalAlpha = 1;

      if (isMouseInside) {
        particles.forEach(p => {
          const dx = p.x - mouseX;
          const dy = p.y - mouseY;
          const dist = Math.sqrt(dx * dx + dy * dy);

          if (dist < MOUSE_INFLUENCE) {
            const alpha = (1 - dist / MOUSE_INFLUENCE) * 0.4;
            ctx!.strokeStyle = `hsla(${p.hue}, 65%, 60%, ${alpha * 0.7})`;
            ctx!.lineWidth = 0.8;
            ctx!.beginPath();
            ctx!.moveTo(mouseX, mouseY);
            ctx!.lineTo(p.x, p.y);
            ctx!.stroke();
          }
        });
      }

      if (trails.length > 1) {
        for (let i = 1; i < trails.length; i++) {
          const t = trails[i];
          const progress = 1 - t.age / 25;
          if (progress <= 0) continue;

          const alpha = progress * 0.4;
          const size = progress * 4;

          ctx!.globalAlpha = alpha;
          ctx!.drawImage(trailSprite(35), t.x - size * 2, t.y - size * 2, size * 4, size * 4);
        }
        ctx!.globalAlpha = 1;
      }
    }

    // ===== 深色：夜禅绘制（无连线，安静） =====
    function drawNight() {
      if (!ctx) return;

      // 疏星闪烁
      stars.forEach(s => {
        const tw = 0.5 + 0.5 * Math.sin(s.phase);
        const alpha = 0.1 + 0.5 * tw;
        ctx!.fillStyle = `hsla(45, 35%, 88%, ${alpha})`;
        ctx!.beginPath();
        ctx!.arc(s.x, s.y, s.size, 0, Math.PI * 2);
        ctx!.fill();
      });

      // 萤火漫游（贴图绘制）
      fireflies.forEach(f => {
        const pulse = 0.5 + 0.5 * Math.sin(f.phase);
        const glowAlpha = 0.08 + 0.3 * pulse;
        const glowR = f.size * 7;

        ctx!.globalAlpha = glowAlpha;
        ctx!.drawImage(fireflySprite(), f.x - glowR, f.y - glowR, glowR * 2, glowR * 2);
        ctx!.globalAlpha = 1;

        ctx!.fillStyle = `hsla(48, 85%, 80%, ${0.35 + 0.55 * pulse})`;
        ctx!.beginPath();
        ctx!.arc(f.x, f.y, f.size * 0.9, 0, Math.PI * 2);
        ctx!.fill();
      });
    }

    function animate() {
      if (!ctx) return;
      ctx.clearRect(0, 0, width, height);

      updateCursor();

      if (isDarkMode()) {
        updateNight();
        drawNight();
      } else {
        updateParticles();
        drawParticles();
      }

      animationId = requestAnimationFrame(animate);
    }

    // 监听主题切换，重建场景。
    // 只在明暗真的翻转时重建：<html> 的 class 还会因 theme-anim / vt-nav /
    // locale-transition 等标记频繁变动，此前每次都把粒子重新洒一遍（画面跳变）
    let themeObserver: MutationObserver | null = null;
    let lastDark = isDarkMode();

    function setupThemeObserver() {
      themeObserver = new MutationObserver(() => {
        const nowDark = isDarkMode();
        if (nowDark !== lastDark) {
          lastDark = nowDark;
          initScene();
        }
      });
      themeObserver.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
    }

    function fullInit() {
      init();
      setupThemeObserver();
    }

    // 组件带 transition:persist，跨页面导航时 canvas 持续运行，
    // 无需在 astro:before-swap / after-swap 时销毁重建
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', fullInit);
    } else {
      fullInit();
    }
  })();
</script>
