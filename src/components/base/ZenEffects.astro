---
/**
 * 禅意特效组件 - 仙境强化版 v6
 * 明显的粒子 + 鼠标跟随光标 + 强烈视觉效果
 */
---

<!-- 仙境氛围层 -->
<div class="zen-realm" aria-hidden="true">
  <div class="zen-glow zen-glow-1"></div>
  <div class="zen-glow zen-glow-2"></div>
  <div class="zen-glow zen-glow-3"></div>
</div>

<!-- 鼠标跟随光标 -->
<div id="cursor-glow" class="cursor-glow" aria-hidden="true"></div>
<div id="cursor-dot" class="cursor-dot" aria-hidden="true"></div>

<!-- 主画布 -->
<canvas id="zen-canvas" class="zen-canvas" aria-hidden="true"></canvas>

<style>
  .zen-realm {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    overflow: hidden;
  }

  /* 大型漂浮光球 */
  .zen-glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.6;
    animation: float-glow 20s ease-in-out infinite;
  }

  .zen-glow-1 {
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, hsla(200, 80%, 70%, 0.4) 0%, transparent 70%);
    top: -10%;
    left: -5%;
    animation-delay: 0s;
  }

  .zen-glow-2 {
    width: 400px;
    height: 400px;
    background: radial-gradient(circle, hsla(220, 70%, 75%, 0.35) 0%, transparent 70%);
    top: 50%;
    right: -10%;
    animation-delay: -7s;
    animation-duration: 25s;
  }

  .zen-glow-3 {
    width: 350px;
    height: 350px;
    background: radial-gradient(circle, hsla(180, 60%, 70%, 0.3) 0%, transparent 70%);
    bottom: -5%;
    left: 30%;
    animation-delay: -14s;
    animation-duration: 22s;
  }

  :global(.dark) .zen-glow-1 {
    background: radial-gradient(circle, hsla(200, 90%, 60%, 0.5) 0%, transparent 70%);
    opacity: 0.7;
  }

  :global(.dark) .zen-glow-2 {
    background: radial-gradient(circle, hsla(220, 85%, 65%, 0.45) 0%, transparent 70%);
    opacity: 0.7;
  }

  :global(.dark) .zen-glow-3 {
    background: radial-gradient(circle, hsla(180, 75%, 60%, 0.4) 0%, transparent 70%);
    opacity: 0.7;
  }

  @keyframes float-glow {
    0%, 100% {
      transform: translate(0, 0) scale(1);
    }
    25% {
      transform: translate(50px, 30px) scale(1.1);
    }
    50% {
      transform: translate(-30px, 60px) scale(0.95);
    }
    75% {
      transform: translate(40px, -20px) scale(1.05);
    }
  }

  /* 鼠标跟随光标 */
  .cursor-glow {
    position: fixed;
    width: 300px;
    height: 300px;
    border-radius: 50%;
    pointer-events: none;
    z-index: 9998;
    transform: translate(-50%, -50%);
    background: radial-gradient(circle, hsla(200, 70%, 80%, 0.25) 0%, hsla(210, 60%, 70%, 0.1) 40%, transparent 70%);
    filter: blur(30px);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  :global(.dark) .cursor-glow {
    background: radial-gradient(circle, hsla(200, 80%, 70%, 0.35) 0%, hsla(210, 70%, 60%, 0.15) 40%, transparent 70%);
  }

  .cursor-dot {
    position: fixed;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    pointer-events: none;
    z-index: 9999;
    transform: translate(-50%, -50%);
    background: hsla(200, 60%, 85%, 0.9);
    box-shadow:
      0 0 20px 8px hsla(200, 70%, 80%, 0.5),
      0 0 40px 16px hsla(210, 60%, 70%, 0.3),
      0 0 60px 24px hsla(200, 50%, 60%, 0.15);
    opacity: 0;
    transition: opacity 0.2s ease, transform 0.1s ease;
  }

  :global(.dark) .cursor-dot {
    background: hsla(200, 80%, 90%, 1);
    box-shadow:
      0 0 25px 10px hsla(200, 85%, 75%, 0.6),
      0 0 50px 20px hsla(210, 75%, 65%, 0.4),
      0 0 80px 30px hsla(200, 65%, 55%, 0.2);
  }

  .zen-canvas {
    position: fixed;
    inset: 0;
    pointer-events: none;
    width: 100%;
    height: 100%;
    z-index: 2;
  }

  @media (prefers-reduced-motion: reduce) {
    .zen-canvas,
    .zen-realm,
    .cursor-glow,
    .cursor-dot {
      display: none;
    }
  }
</style>

<script>
  (function() {
    let canvas: HTMLCanvasElement | null = null;
    let ctx: CanvasRenderingContext2D | null = null;
    let cursorGlow: HTMLElement | null = null;
    let cursorDot: HTMLElement | null = null;
    let animationId: number | null = null;
    let width = 0;
    let height = 0;

    // 鼠标状态
    let mouseX = -1000;
    let mouseY = -1000;
    let targetX = -1000;
    let targetY = -1000;
    let glowX = -1000;
    let glowY = -1000;
    let isMouseInside = false;
    let lastMoveTime = 0;

    // 时间
    let time = 0;

    // 拖尾点
    interface TrailPoint {
      x: number;
      y: number;
      age: number;
      size: number;
    }
    let trailPoints: TrailPoint[] = [];

    // 漂浮粒子
    interface Particle {
      x: number;
      y: number;
      size: number;
      speedX: number;
      speedY: number;
      opacity: number;
      pulse: number;
      pulseSpeed: number;
      hue: number;
    }
    let particles: Particle[] = [];

    const PARTICLE_COUNT = 25;
    const MAX_TRAIL = 30;

    function init() {
      canvas = document.getElementById('zen-canvas') as HTMLCanvasElement;
      cursorGlow = document.getElementById('cursor-glow');
      cursorDot = document.getElementById('cursor-dot');

      if (!canvas) return;
      ctx = canvas.getContext('2d');
      if (!ctx) return;

      resize();
      initParticles();

      window.addEventListener('resize', resize);
      document.addEventListener('mousemove', onMouseMove);
      document.addEventListener('mouseenter', () => { isMouseInside = true; showCursor(); });
      document.addEventListener('mouseleave', () => { isMouseInside = false; hideCursor(); });

      animate();
    }

    function resize() {
      if (!canvas) return;
      width = window.innerWidth;
      height = window.innerHeight;
      canvas.width = width;
      canvas.height = height;
    }

    function initParticles() {
      particles = [];
      for (let i = 0; i < PARTICLE_COUNT; i++) {
        particles.push({
          x: Math.random() * width,
          y: Math.random() * height,
          size: 20 + Math.random() * 40,
          speedX: (Math.random() - 0.5) * 0.5,
          speedY: (Math.random() - 0.5) * 0.3 - 0.2,
          opacity: 0.3 + Math.random() * 0.4,
          pulse: Math.random() * Math.PI * 2,
          pulseSpeed: 0.02 + Math.random() * 0.03,
          hue: 190 + Math.random() * 40
        });
      }
    }

    function showCursor() {
      if (cursorGlow) cursorGlow.style.opacity = '1';
      if (cursorDot) cursorDot.style.opacity = '1';
    }

    function hideCursor() {
      if (cursorGlow) cursorGlow.style.opacity = '0';
      if (cursorDot) cursorDot.style.opacity = '0';
    }

    function onMouseMove(e: MouseEvent) {
      targetX = e.clientX;
      targetY = e.clientY;
      isMouseInside = true;
      lastMoveTime = Date.now();
      showCursor();

      // 添加拖尾点
      trailPoints.unshift({
        x: targetX,
        y: targetY,
        age: 0,
        size: 8 + Math.random() * 4
      });

      if (trailPoints.length > MAX_TRAIL) {
        trailPoints.pop();
      }
    }

    function update() {
      time += 0.016;

      // 平滑跟随鼠标
      mouseX += (targetX - mouseX) * 0.15;
      mouseY += (targetY - mouseY) * 0.15;

      // 光晕更慢跟随
      glowX += (targetX - glowX) * 0.08;
      glowY += (targetY - glowY) * 0.08;

      // 更新光标位置
      if (cursorDot) {
        cursorDot.style.left = mouseX + 'px';
        cursorDot.style.top = mouseY + 'px';
      }
      if (cursorGlow) {
        cursorGlow.style.left = glowX + 'px';
        cursorGlow.style.top = glowY + 'px';
      }

      // 更新拖尾
      trailPoints.forEach(p => {
        p.age += 1;
      });
      trailPoints = trailPoints.filter(p => p.age < 40);

      // 更新粒子
      particles.forEach(p => {
        p.pulse += p.pulseSpeed;
        p.x += p.speedX;
        p.y += p.speedY;

        // 鼠标影响
        if (isMouseInside) {
          const dx = mouseX - p.x;
          const dy = mouseY - p.y;
          const dist = Math.sqrt(dx * dx + dy * dy);
          if (dist < 300 && dist > 0) {
            const force = (300 - dist) / 300 * 0.8;
            p.x += dx / dist * force;
            p.y += dy / dist * force;
          }
        }

        // 边界循环
        if (p.x < -p.size) p.x = width + p.size;
        if (p.x > width + p.size) p.x = -p.size;
        if (p.y < -p.size) p.y = height + p.size;
        if (p.y > height + p.size) p.y = -p.size;
      });

      // 自动隐藏光标（如果鼠标长时间不动）
      if (Date.now() - lastMoveTime > 3000 && isMouseInside) {
        // 保持显示但不做任何事
      }
    }

    function draw() {
      if (!ctx) return;
      ctx.clearRect(0, 0, width, height);

      const isDark = document.documentElement.classList.contains('dark');

      // 绘制粒子
      particles.forEach(p => {
        const pulseScale = 0.8 + 0.2 * Math.sin(p.pulse);
        const currentSize = p.size * pulseScale;
        const currentOpacity = p.opacity * (0.7 + 0.3 * Math.sin(p.pulse * 0.5));

        // 外层大光晕
        const gradient = ctx!.createRadialGradient(
          p.x, p.y, 0,
          p.x, p.y, currentSize * 3
        );

        if (isDark) {
          gradient.addColorStop(0, `hsla(${p.hue}, 85%, 80%, ${currentOpacity * 0.8})`);
          gradient.addColorStop(0.3, `hsla(${p.hue}, 75%, 70%, ${currentOpacity * 0.4})`);
          gradient.addColorStop(0.6, `hsla(${p.hue}, 65%, 60%, ${currentOpacity * 0.15})`);
          gradient.addColorStop(1, `hsla(${p.hue}, 55%, 50%, 0)`);
        } else {
          gradient.addColorStop(0, `hsla(${p.hue}, 70%, 75%, ${currentOpacity * 0.6})`);
          gradient.addColorStop(0.3, `hsla(${p.hue}, 60%, 70%, ${currentOpacity * 0.3})`);
          gradient.addColorStop(0.6, `hsla(${p.hue}, 50%, 65%, ${currentOpacity * 0.1})`);
          gradient.addColorStop(1, `hsla(${p.hue}, 40%, 60%, 0)`);
        }

        ctx!.fillStyle = gradient;
        ctx!.beginPath();
        ctx!.arc(p.x, p.y, currentSize * 3, 0, Math.PI * 2);
        ctx!.fill();

        // 核心亮点
        const coreGradient = ctx!.createRadialGradient(
          p.x, p.y, 0,
          p.x, p.y, currentSize * 0.8
        );

        if (isDark) {
          coreGradient.addColorStop(0, `hsla(0, 0%, 100%, ${currentOpacity})`);
          coreGradient.addColorStop(0.5, `hsla(${p.hue}, 60%, 90%, ${currentOpacity * 0.7})`);
          coreGradient.addColorStop(1, `hsla(${p.hue}, 70%, 80%, 0)`);
        } else {
          coreGradient.addColorStop(0, `hsla(0, 0%, 100%, ${currentOpacity * 0.8})`);
          coreGradient.addColorStop(0.5, `hsla(${p.hue}, 50%, 85%, ${currentOpacity * 0.5})`);
          coreGradient.addColorStop(1, `hsla(${p.hue}, 60%, 75%, 0)`);
        }

        ctx!.fillStyle = coreGradient;
        ctx!.beginPath();
        ctx!.arc(p.x, p.y, currentSize * 0.8, 0, Math.PI * 2);
        ctx!.fill();
      });

      // 绘制鼠标拖尾
      if (isMouseInside && trailPoints.length > 1) {
        for (let i = 1; i < trailPoints.length; i++) {
          const p = trailPoints[i];
          const prev = trailPoints[i - 1];
          const progress = 1 - p.age / 40;

          if (progress <= 0) continue;

          const alpha = progress * 0.6;
          const size = p.size * progress;

          // 拖尾光点
          const trailGradient = ctx!.createRadialGradient(
            p.x, p.y, 0,
            p.x, p.y, size * 4
          );

          if (isDark) {
            trailGradient.addColorStop(0, `hsla(200, 80%, 85%, ${alpha})`);
            trailGradient.addColorStop(0.4, `hsla(210, 70%, 75%, ${alpha * 0.5})`);
            trailGradient.addColorStop(1, `hsla(200, 60%, 65%, 0)`);
          } else {
            trailGradient.addColorStop(0, `hsla(200, 60%, 80%, ${alpha * 0.8})`);
            trailGradient.addColorStop(0.4, `hsla(210, 50%, 75%, ${alpha * 0.4})`);
            trailGradient.addColorStop(1, `hsla(200, 40%, 70%, 0)`);
          }

          ctx!.fillStyle = trailGradient;
          ctx!.beginPath();
          ctx!.arc(p.x, p.y, size * 4, 0, Math.PI * 2);
          ctx!.fill();

          // 连线
          if (i < trailPoints.length - 1) {
            ctx!.strokeStyle = isDark
              ? `hsla(200, 70%, 80%, ${alpha * 0.3})`
              : `hsla(200, 50%, 75%, ${alpha * 0.2})`;
            ctx!.lineWidth = size * 0.5;
            ctx!.lineCap = 'round';
            ctx!.beginPath();
            ctx!.moveTo(prev.x, prev.y);
            ctx!.lineTo(p.x, p.y);
            ctx!.stroke();
          }
        }
      }
    }

    function animate() {
      update();
      draw();
      animationId = requestAnimationFrame(animate);
    }

    function cleanup() {
      if (animationId) {
        cancelAnimationFrame(animationId);
        animationId = null;
      }
      window.removeEventListener('resize', resize);
      document.removeEventListener('mousemove', onMouseMove);
    }

    // 启动
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }

    // Astro 页面切换
    document.addEventListener('astro:before-swap', cleanup);
    document.addEventListener('astro:after-swap', init);
  })();
</script>
