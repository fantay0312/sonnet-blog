---
/**
 * 禅意特效组件 - 云雾缥缈版
 * 简洁、柔和、如山水画般的意境
 */
---

<!-- 云雾背景层 -->
<div class="zen-atmosphere" aria-hidden="true">
  <div class="fog fog-1"></div>
  <div class="fog fog-2"></div>
</div>

<!-- 鼠标柔光 -->
<div class="cursor-light" id="cursor-light" aria-hidden="true"></div>

<style>
  /* ===== 云雾氛围 ===== */
  .zen-atmosphere {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    overflow: hidden;
  }

  /* 云雾 - 柔和渐变 */
  .fog {
    position: absolute;
    border-radius: 50%;
    filter: blur(100px);
    will-change: transform, opacity;
  }

  .fog-1 {
    width: 80vw;
    height: 50vh;
    background: radial-gradient(
      ellipse at center,
      var(--zen-accent) 0%,
      transparent 70%
    );
    top: -10%;
    left: -20%;
    opacity: 0.08;
    animation: fog-drift-1 40s ease-in-out infinite;
  }

  .fog-2 {
    width: 70vw;
    height: 45vh;
    background: radial-gradient(
      ellipse at center,
      var(--zen-gold) 0%,
      transparent 70%
    );
    bottom: -5%;
    right: -15%;
    opacity: 0.06;
    animation: fog-drift-2 50s ease-in-out infinite;
  }

  @keyframes fog-drift-1 {
    0%, 100% {
      transform: translate(0, 0);
      opacity: 0.08;
    }
    50% {
      transform: translate(5vw, 3vh);
      opacity: 0.12;
    }
  }

  @keyframes fog-drift-2 {
    0%, 100% {
      transform: translate(0, 0);
      opacity: 0.06;
    }
    50% {
      transform: translate(-4vw, -2vh);
      opacity: 0.09;
    }
  }

  /* ===== 鼠标柔光 ===== */
  .cursor-light {
    position: fixed;
    width: 400px;
    height: 400px;
    border-radius: 50%;
    pointer-events: none;
    z-index: 1;
    background: radial-gradient(
      circle at center,
      var(--zen-accent) 0%,
      transparent 60%
    );
    opacity: 0;
    transform: translate(-50%, -50%);
    filter: blur(80px);
    transition: opacity 0.5s ease;
    will-change: left, top;
  }

  .cursor-light.active {
    opacity: 0.12;
  }

  /* ===== 深色模式 ===== */
  :global(.dark) .fog-1 {
    opacity: 0.06;
  }

  :global(.dark) .fog-2 {
    opacity: 0.04;
  }

  :global(.dark) .cursor-light.active {
    opacity: 0.08;
  }

  /* ===== 减少动画偏好 ===== */
  @media (prefers-reduced-motion: reduce) {
    .fog {
      animation: none;
    }
    .cursor-light {
      display: none;
    }
  }
</style>

<script>
  (function() {
    let cursorLight: HTMLElement | null = null;
    let mouseX = 0;
    let mouseY = 0;
    let currentX = 0;
    let currentY = 0;
    let rafId: number | null = null;

    function init() {
      cursorLight = document.getElementById('cursor-light');
      if (!cursorLight) return;

      // 平滑跟随动画
      function animate() {
        // 缓动跟随
        currentX += (mouseX - currentX) * 0.08;
        currentY += (mouseY - currentY) * 0.08;

        if (cursorLight) {
          cursorLight.style.left = `${currentX}px`;
          cursorLight.style.top = `${currentY}px`;
        }

        rafId = requestAnimationFrame(animate);
      }
      animate();

      // 鼠标移动
      document.addEventListener('mousemove', (e) => {
        mouseX = e.clientX;
        mouseY = e.clientY;
        cursorLight?.classList.add('active');
      });

      // 鼠标离开
      document.addEventListener('mouseleave', () => {
        cursorLight?.classList.remove('active');
      });
    }

    // 初始化
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }

    // View Transitions
    document.addEventListener('astro:after-swap', () => {
      if (rafId) cancelAnimationFrame(rafId);
      init();
    });
  })();
</script>
