---
/**
 * 禅意特效组件 - 流星仙境版 v7
 * 流星划过 + 鼠标跟随 + 仙气氛围
 */
---

<!-- 仙境氛围层 -->
<div class="zen-realm" aria-hidden="true">
  <div class="zen-glow zen-glow-1"></div>
  <div class="zen-glow zen-glow-2"></div>
  <div class="zen-glow zen-glow-3"></div>
</div>

<!-- 鼠标跟随光标 -->
<div id="cursor-glow" class="cursor-glow" aria-hidden="true"></div>
<div id="cursor-dot" class="cursor-dot" aria-hidden="true"></div>

<!-- 主画布 -->
<canvas id="zen-canvas" class="zen-canvas" aria-hidden="true"></canvas>

<style>
  .zen-realm {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    overflow: hidden;
  }

  /* 大型漂浮光球 */
  .zen-glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.5;
    animation: float-glow 20s ease-in-out infinite;
  }

  .zen-glow-1 {
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, hsla(200, 80%, 70%, 0.35) 0%, transparent 70%);
    top: -10%;
    left: -5%;
  }

  .zen-glow-2 {
    width: 400px;
    height: 400px;
    background: radial-gradient(circle, hsla(220, 70%, 75%, 0.3) 0%, transparent 70%);
    top: 50%;
    right: -10%;
    animation-delay: -7s;
    animation-duration: 25s;
  }

  .zen-glow-3 {
    width: 350px;
    height: 350px;
    background: radial-gradient(circle, hsla(180, 60%, 70%, 0.25) 0%, transparent 70%);
    bottom: -5%;
    left: 30%;
    animation-delay: -14s;
    animation-duration: 22s;
  }

  :global(.dark) .zen-glow-1 {
    background: radial-gradient(circle, hsla(200, 90%, 60%, 0.45) 0%, transparent 70%);
    opacity: 0.6;
  }

  :global(.dark) .zen-glow-2 {
    background: radial-gradient(circle, hsla(220, 85%, 65%, 0.4) 0%, transparent 70%);
    opacity: 0.6;
  }

  :global(.dark) .zen-glow-3 {
    background: radial-gradient(circle, hsla(180, 75%, 60%, 0.35) 0%, transparent 70%);
    opacity: 0.6;
  }

  @keyframes float-glow {
    0%, 100% { transform: translate(0, 0) scale(1); }
    25% { transform: translate(50px, 30px) scale(1.1); }
    50% { transform: translate(-30px, 60px) scale(0.95); }
    75% { transform: translate(40px, -20px) scale(1.05); }
  }

  /* 鼠标跟随光标 */
  .cursor-glow {
    position: fixed;
    width: 250px;
    height: 250px;
    border-radius: 50%;
    pointer-events: none;
    z-index: 9998;
    transform: translate(-50%, -50%);
    background: radial-gradient(circle, hsla(200, 70%, 80%, 0.2) 0%, hsla(210, 60%, 70%, 0.08) 40%, transparent 70%);
    filter: blur(20px);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  :global(.dark) .cursor-glow {
    background: radial-gradient(circle, hsla(200, 80%, 70%, 0.3) 0%, hsla(210, 70%, 60%, 0.12) 40%, transparent 70%);
  }

  .cursor-dot {
    position: fixed;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    pointer-events: none;
    z-index: 9999;
    transform: translate(-50%, -50%);
    background: hsla(200, 60%, 90%, 0.9);
    box-shadow:
      0 0 15px 6px hsla(200, 70%, 80%, 0.5),
      0 0 30px 12px hsla(210, 60%, 70%, 0.3);
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  :global(.dark) .cursor-dot {
    background: hsla(200, 80%, 95%, 1);
    box-shadow:
      0 0 20px 8px hsla(200, 85%, 75%, 0.6),
      0 0 40px 16px hsla(210, 75%, 65%, 0.4);
  }

  .zen-canvas {
    position: fixed;
    inset: 0;
    pointer-events: none;
    width: 100%;
    height: 100%;
    z-index: 2;
  }

  @media (prefers-reduced-motion: reduce) {
    .zen-canvas, .zen-realm, .cursor-glow, .cursor-dot { display: none; }
  }
</style>

<script>
  (function() {
    let canvas: HTMLCanvasElement | null = null;
    let ctx: CanvasRenderingContext2D | null = null;
    let cursorGlow: HTMLElement | null = null;
    let cursorDot: HTMLElement | null = null;
    let animationId: number | null = null;
    let width = 0;
    let height = 0;

    // 鼠标状态
    let mouseX = -1000;
    let mouseY = -1000;
    let targetX = -1000;
    let targetY = -1000;
    let glowX = -1000;
    let glowY = -1000;
    let isMouseInside = false;

    // 流星
    interface Meteor {
      x: number;
      y: number;
      length: number;
      speed: number;
      angle: number;
      opacity: number;
      thickness: number;
      hue: number;
      life: number;
      maxLife: number;
    }
    let meteors: Meteor[] = [];

    // 鼠标拖尾
    interface TrailPoint {
      x: number;
      y: number;
      age: number;
    }
    let trailPoints: TrailPoint[] = [];

    const MAX_METEORS = 12;
    const METEOR_SPAWN_RATE = 0.06; // 每帧生成概率
    const MAX_TRAIL = 25;

    function init() {
      canvas = document.getElementById('zen-canvas') as HTMLCanvasElement;
      cursorGlow = document.getElementById('cursor-glow');
      cursorDot = document.getElementById('cursor-dot');

      if (!canvas) return;
      ctx = canvas.getContext('2d');
      if (!ctx) return;

      resize();

      window.addEventListener('resize', resize);
      document.addEventListener('mousemove', onMouseMove);
      document.addEventListener('mouseenter', () => { isMouseInside = true; showCursor(); });
      document.addEventListener('mouseleave', () => { isMouseInside = false; hideCursor(); });

      animate();
    }

    function resize() {
      if (!canvas) return;
      width = window.innerWidth;
      height = window.innerHeight;
      canvas.width = width;
      canvas.height = height;
    }

    function showCursor() {
      if (cursorGlow) cursorGlow.style.opacity = '1';
      if (cursorDot) cursorDot.style.opacity = '1';
    }

    function hideCursor() {
      if (cursorGlow) cursorGlow.style.opacity = '0';
      if (cursorDot) cursorDot.style.opacity = '0';
    }

    function onMouseMove(e: MouseEvent) {
      targetX = e.clientX;
      targetY = e.clientY;
      isMouseInside = true;
      showCursor();

      // 添加拖尾点
      trailPoints.unshift({ x: targetX, y: targetY, age: 0 });
      if (trailPoints.length > MAX_TRAIL) trailPoints.pop();
    }

    function createMeteor() {
      // 随机从不同方向生成流星
      const side = Math.random();
      let x: number, y: number, angle: number;

      if (side < 0.7) {
        // 从右上方向左下划过（主要方向）
        x = width * (0.3 + Math.random() * 0.8);
        y = -50;
        angle = Math.PI * (0.55 + Math.random() * 0.2); // 向左下
      } else if (side < 0.85) {
        // 从左上向右下
        x = -50;
        y = Math.random() * height * 0.5;
        angle = Math.PI * (0.25 + Math.random() * 0.15);
      } else {
        // 从右侧向左
        x = width + 50;
        y = Math.random() * height * 0.6;
        angle = Math.PI * (0.8 + Math.random() * 0.2);
      }

      meteors.push({
        x,
        y,
        length: 80 + Math.random() * 150,
        speed: 8 + Math.random() * 12,
        angle,
        opacity: 0.6 + Math.random() * 0.4,
        thickness: 1.5 + Math.random() * 2,
        hue: 190 + Math.random() * 30,
        life: 0,
        maxLife: 60 + Math.random() * 40
      });
    }

    function update() {
      // 平滑跟随鼠标
      mouseX += (targetX - mouseX) * 0.15;
      mouseY += (targetY - mouseY) * 0.15;
      glowX += (targetX - glowX) * 0.08;
      glowY += (targetY - glowY) * 0.08;

      // 更新光标位置
      if (cursorDot) {
        cursorDot.style.left = mouseX + 'px';
        cursorDot.style.top = mouseY + 'px';
      }
      if (cursorGlow) {
        cursorGlow.style.left = glowX + 'px';
        cursorGlow.style.top = glowY + 'px';
      }

      // 生成新流星
      if (meteors.length < MAX_METEORS && Math.random() < METEOR_SPAWN_RATE) {
        createMeteor();
      }

      // 更新流星
      meteors = meteors.filter(m => {
        m.x += Math.cos(m.angle) * m.speed;
        m.y += Math.sin(m.angle) * m.speed;
        m.life++;

        // 淡入淡出
        if (m.life < 10) {
          m.opacity = (m.life / 10) * (0.6 + Math.random() * 0.4);
        } else if (m.life > m.maxLife - 15) {
          m.opacity *= 0.9;
        }

        // 移除超出屏幕或生命结束的流星
        return m.x > -200 && m.x < width + 200 &&
               m.y > -200 && m.y < height + 200 &&
               m.life < m.maxLife && m.opacity > 0.01;
      });

      // 更新拖尾
      trailPoints.forEach(p => p.age++);
      trailPoints = trailPoints.filter(p => p.age < 30);
    }

    function draw() {
      if (!ctx) return;
      ctx.clearRect(0, 0, width, height);

      const isDark = document.documentElement.classList.contains('dark');

      // 绘制流星
      meteors.forEach(m => {
        const tailX = m.x - Math.cos(m.angle) * m.length;
        const tailY = m.y - Math.sin(m.angle) * m.speed * 0.5;

        // 流星拖尾渐变
        const gradient = ctx!.createLinearGradient(tailX, tailY, m.x, m.y);

        if (isDark) {
          gradient.addColorStop(0, `hsla(${m.hue}, 70%, 80%, 0)`);
          gradient.addColorStop(0.3, `hsla(${m.hue}, 80%, 85%, ${m.opacity * 0.3})`);
          gradient.addColorStop(0.7, `hsla(${m.hue}, 85%, 90%, ${m.opacity * 0.7})`);
          gradient.addColorStop(1, `hsla(0, 0%, 100%, ${m.opacity})`);
        } else {
          gradient.addColorStop(0, `hsla(${m.hue}, 50%, 70%, 0)`);
          gradient.addColorStop(0.3, `hsla(${m.hue}, 60%, 75%, ${m.opacity * 0.2})`);
          gradient.addColorStop(0.7, `hsla(${m.hue}, 70%, 80%, ${m.opacity * 0.5})`);
          gradient.addColorStop(1, `hsla(0, 0%, 100%, ${m.opacity * 0.8})`);
        }

        // 绘制流星主体
        ctx!.strokeStyle = gradient;
        ctx!.lineWidth = m.thickness;
        ctx!.lineCap = 'round';
        ctx!.beginPath();
        ctx!.moveTo(tailX, tailY);
        ctx!.lineTo(m.x, m.y);
        ctx!.stroke();

        // 流星头部光晕
        const headGlow = ctx!.createRadialGradient(m.x, m.y, 0, m.x, m.y, m.thickness * 8);
        if (isDark) {
          headGlow.addColorStop(0, `hsla(0, 0%, 100%, ${m.opacity})`);
          headGlow.addColorStop(0.3, `hsla(${m.hue}, 80%, 85%, ${m.opacity * 0.6})`);
          headGlow.addColorStop(1, `hsla(${m.hue}, 70%, 70%, 0)`);
        } else {
          headGlow.addColorStop(0, `hsla(0, 0%, 100%, ${m.opacity * 0.8})`);
          headGlow.addColorStop(0.3, `hsla(${m.hue}, 60%, 80%, ${m.opacity * 0.4})`);
          headGlow.addColorStop(1, `hsla(${m.hue}, 50%, 70%, 0)`);
        }

        ctx!.fillStyle = headGlow;
        ctx!.beginPath();
        ctx!.arc(m.x, m.y, m.thickness * 8, 0, Math.PI * 2);
        ctx!.fill();

        // 流星核心亮点
        ctx!.fillStyle = `hsla(0, 0%, 100%, ${m.opacity})`;
        ctx!.beginPath();
        ctx!.arc(m.x, m.y, m.thickness * 0.8, 0, Math.PI * 2);
        ctx!.fill();
      });

      // 绘制鼠标拖尾
      if (isMouseInside && trailPoints.length > 1) {
        ctx!.lineCap = 'round';
        ctx!.lineJoin = 'round';

        for (let i = 1; i < trailPoints.length; i++) {
          const p = trailPoints[i];
          const prev = trailPoints[i - 1];
          const progress = 1 - p.age / 30;

          if (progress <= 0) continue;

          const alpha = progress * 0.5;
          const lineWidth = progress * 6;

          // 拖尾光点
          const trailGradient = ctx!.createRadialGradient(p.x, p.y, 0, p.x, p.y, lineWidth * 3);
          if (isDark) {
            trailGradient.addColorStop(0, `hsla(200, 80%, 90%, ${alpha})`);
            trailGradient.addColorStop(0.5, `hsla(210, 70%, 80%, ${alpha * 0.4})`);
            trailGradient.addColorStop(1, `hsla(200, 60%, 70%, 0)`);
          } else {
            trailGradient.addColorStop(0, `hsla(200, 60%, 85%, ${alpha * 0.7})`);
            trailGradient.addColorStop(0.5, `hsla(210, 50%, 80%, ${alpha * 0.3})`);
            trailGradient.addColorStop(1, `hsla(200, 40%, 75%, 0)`);
          }

          ctx!.fillStyle = trailGradient;
          ctx!.beginPath();
          ctx!.arc(p.x, p.y, lineWidth * 3, 0, Math.PI * 2);
          ctx!.fill();

          // 连线
          ctx!.strokeStyle = isDark
            ? `hsla(200, 70%, 85%, ${alpha * 0.4})`
            : `hsla(200, 50%, 80%, ${alpha * 0.3})`;
          ctx!.lineWidth = lineWidth * 0.5;
          ctx!.beginPath();
          ctx!.moveTo(prev.x, prev.y);
          ctx!.lineTo(p.x, p.y);
          ctx!.stroke();
        }
      }
    }

    function animate() {
      update();
      draw();
      animationId = requestAnimationFrame(animate);
    }

    function cleanup() {
      if (animationId) {
        cancelAnimationFrame(animationId);
        animationId = null;
      }
      window.removeEventListener('resize', resize);
      document.removeEventListener('mousemove', onMouseMove);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }

    document.addEventListener('astro:before-swap', cleanup);
    document.addEventListener('astro:after-swap', init);
  })();
</script>
