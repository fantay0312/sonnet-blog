---
import config from "$config";

const currentLocale = Astro.currentLocale || config.i18n.defaultLocale;
const currentPath = Astro.url.pathname;

// Get available locales
const locales = config.i18n.locales;
const defaultLocale = config.i18n.defaultLocale;

// Build alternate URLs for each locale
function getLocalePath(locale: string): string {
  let path = currentPath;

  // Remove current locale prefix if present
  for (const loc of locales) {
    if (path.startsWith(`/${loc}/`) || path === `/${loc}`) {
      path = path.slice(loc.length + 1) || "/";
      break;
    }
  }

  // Add new locale prefix (skip for default locale)
  if (locale === defaultLocale) {
    return path;
  }
  return `/${locale}${path === "/" ? "" : path}`;
}

const localeNames: Record<string, string> = {
  "zh-cn": "中文",
  en: "EN",
};
---

<div class="lang-switch relative">
  <button
    class="zen-icon-btn lang-trigger p-2 hover:bg-muted rounded-lg flex items-center gap-1"
    aria-label="Switch language"
    aria-expanded="false"
    aria-haspopup="true"
  >
    <span class="icon-[lucide--globe] w-5 h-5"></span>
    <span class="text-sm">{localeNames[currentLocale] || currentLocale}</span>
    <span class="icon-[lucide--chevron-down] w-3 h-3 opacity-50 transition-transform duration-200"></span>
  </button>

  <!-- 透明桥接区域，防止鼠标移动时hover丢失 -->
  <div class="lang-dropdown absolute right-0 top-full pt-1">
    <div class="zen-popover-surface lang-surface py-1 min-w-[100px] overflow-hidden">
      {locales.map((locale) => (
        <a
          href={getLocalePath(locale)}
          aria-current={locale === currentLocale ? "true" : undefined}
          class={`locale-link flex items-center gap-2 px-4 py-2.5 text-sm hover:bg-muted transition-colors duration-150 ${
            locale === currentLocale
              ? "text-accent bg-muted/30"
              : "text-secondary hover:text-foreground"
          }`}
          data-locale={locale}
        >
          <span class={`locale-dot w-1.5 h-1.5 rounded-full transition-[background-color,scale] duration-200 ${
            locale === currentLocale ? "bg-accent scale-100" : "bg-transparent scale-0"
          }`}></span>
          <span>{localeNames[locale] || locale}</span>
          {locale !== currentLocale && (
            <span class="locale-arrow icon-[lucide--arrow-right] w-3 h-3 opacity-0 -translate-x-1 transition-[opacity,translate] duration-200 ml-auto"></span>
          )}
        </a>
      ))}
    </div>
  </div>
</div>

<style>
  .lang-switch {
    position: relative;
  }

  /* 内层圆角 = 外层 12px − 桥接区不算内边距，这里直接取 10px 贴近 */
  .lang-surface {
    border-radius: 10px;
  }

  /* 下拉：从触发器右上角缩放展开；进场稍长（陡曲线），退场更短更简 */
  .lang-dropdown {
    opacity: 0;
    visibility: hidden;
    transform: translateY(-4px) scale(0.96);
    transform-origin: top right;
    pointer-events: none;
    transition:
      opacity var(--dur-fast) var(--ease-out-quad),
      transform var(--dur-fast) var(--ease-out-quad),
      visibility 0s linear var(--dur-fast);
  }

  /* 显示下拉菜单 - hover 或 active 状态 */
  .lang-switch:hover .lang-dropdown,
  .lang-switch.active .lang-dropdown,
  .lang-switch:focus-within .lang-dropdown {
    opacity: 1;
    visibility: visible;
    transform: translateY(0) scale(1);
    pointer-events: auto;
    transition:
      opacity var(--dur-base) var(--ease-out-expo),
      transform var(--dur-base) var(--ease-out-expo),
      visibility 0s;
  }

  /* 箭头旋转 */
  .lang-switch:hover .lang-trigger [class*="chevron"],
  .lang-switch.active .lang-trigger [class*="chevron"],
  .lang-switch:focus-within .lang-trigger [class*="chevron"] {
    transform: rotate(180deg);
  }

  /* 延迟隐藏，给用户足够时间移动鼠标 */
  .lang-switch:not(:hover):not(.active):not(:focus-within) .lang-dropdown {
    transition-delay: 0.15s;
  }

  /* 语言链接悬浮效果 */
  .locale-link {
    position: relative;
    transition-property: color, background-color, transform;
  }

  /* Tailwind v4 的位移 / 缩放工具类走独立的 translate、scale 属性，覆盖时用同名属性 */
  .locale-link:hover .locale-arrow,
  .locale-link:focus-visible .locale-arrow {
    opacity: 0.6;
    translate: 0;
  }

  .locale-link:not([aria-current]):hover .locale-dot,
  .locale-link:not([aria-current]):focus-visible .locale-dot {
    background-color: var(--zen-secondary);
    scale: 1;
  }

  /* 点击反馈 */
  .locale-link:active {
    transform: scale(0.97);
  }

  @media (prefers-reduced-motion: reduce) {
    .lang-dropdown,
    .lang-switch:hover .lang-dropdown,
    .lang-switch.active .lang-dropdown,
    .lang-switch:focus-within .lang-dropdown {
      transform: none;
      transition-property: opacity, visibility;
    }
    .locale-link:active {
      transform: none;
    }
    .locale-arrow {
      transition-property: opacity;
      translate: 0;
    }
    .locale-dot {
      transition-property: background-color;
    }
    .lang-trigger [class*="chevron"] {
      transition: none;
    }
  }
</style>

<script>
  function initLanguageSwitch() {
    document.querySelectorAll('.lang-switch').forEach(switcher => {
      // 防止重复绑定：此前每次 after-swap 都给 document 再挂一个 click 监听 +
      // 给 switcher 再建一个 MutationObserver，导航多次后全部泄漏
      if ((switcher as any).__bound) return;
      (switcher as any).__bound = true;

      const trigger = switcher.querySelector('.lang-trigger');
      const links = switcher.querySelectorAll('.locale-link');
      let hideTimeout: ReturnType<typeof setTimeout> | null = null;

      // 点击触发
      trigger?.addEventListener('click', (e) => {
        e.stopPropagation();
        switcher.classList.toggle('active');
      });

      // 语言链接点击 - 添加过渡效果
      links.forEach(link => {
        link.addEventListener('click', (e) => {
          const href = link.getAttribute('href');
          const currentPath = window.location.pathname;

          // 如果是当前语言，不做任何操作
          if (href === currentPath) {
            e.preventDefault();
            switcher.classList.remove('active');
            return;
          }

          // 添加语言切换过渡类
          document.documentElement.classList.add('locale-transition');

          // 关闭下拉菜单
          switcher.classList.remove('active');
        });
      });

      // 鼠标进入时清除隐藏计时器
      switcher.addEventListener('mouseenter', () => {
        if (hideTimeout) {
          clearTimeout(hideTimeout);
          hideTimeout = null;
        }
      });

      // 鼠标离开时延迟隐藏
      switcher.addEventListener('mouseleave', () => {
        hideTimeout = setTimeout(() => {
          switcher.classList.remove('active');
        }, 300);
      });

      // 更新 aria 属性
      const updateAria = () => {
        const isActive = switcher.classList.contains('active');
        trigger?.setAttribute('aria-expanded', String(isActive));
      };

      const observer = new MutationObserver(updateAria);
      observer.observe(switcher, { attributes: true, attributeFilter: ['class'] });
    });
  }

  // 点击页面其他地方关闭：全局只注册一次，触发时即时查询当前所有 switcher
  let langGlobalWired = false;
  function wireLangGlobalOnce() {
    if (langGlobalWired) return;
    langGlobalWired = true;
    document.addEventListener('click', (e) => {
      document.querySelectorAll('.lang-switch').forEach(switcher => {
        if (!switcher.contains(e.target as Node)) {
          switcher.classList.remove('active');
        }
      });
    });
  }

  // 初始化
  initLanguageSwitch();
  wireLangGlobalOnce();

  // 页面切换后移除过渡类并重新初始化（全局监听不重注册）
  document.addEventListener('astro:after-swap', () => {
    document.documentElement.classList.remove('locale-transition');
    initLanguageSwitch();
  });
</script>
