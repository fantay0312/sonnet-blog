---
/**
 * 主题切换按钮 (Astro 版本)
 * 支持 light / dark / system 三种模式
 */
---

<div class="theme-toggle relative">
  <button
    id="theme-toggle-btn"
    class="zen-icon-btn theme-btn p-2 hover:bg-muted rounded-xl group"
    aria-label="Toggle theme"
    aria-haspopup="true"
    aria-expanded="false"
    aria-controls="theme-panel"
    title="切换主题"
  >
    <span class="theme-icon w-5 h-5 block transition-transform duration-300 group-hover:rotate-12"></span>
  </button>

  <!-- 主题选择面板：从触发器右上角缩放展开 -->
  <div id="theme-panel" class="zen-popover theme-panel absolute right-0 top-full mt-2 z-50">
    <div class="zen-popover-surface p-1.5 min-w-[120px]">
      <button class="theme-option w-full" data-theme="light">
        <span class="icon-[lucide--sun] w-4 h-4"></span>
        <span>浅色</span>
      </button>
      <button class="theme-option w-full" data-theme="dark">
        <span class="icon-[lucide--moon] w-4 h-4"></span>
        <span>深色</span>
      </button>
      <button class="theme-option w-full" data-theme="system">
        <span class="icon-[lucide--monitor] w-4 h-4"></span>
        <span>系统</span>
      </button>
    </div>
  </div>
</div>

<style>
  .theme-icon {
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
  }

  /* 面板内层圆角 = 外层 12px − 内边距 6px：嵌套圆角相减，角缝才均匀 */
  .theme-option {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.75rem;
    border-radius: 6px;
    font-size: 0.875rem;
    color: var(--zen-secondary);
    transition:
      background-color var(--dur-fast) ease,
      color var(--dur-fast) ease;
    cursor: pointer;
    background: none;
    border: none;
    text-align: left;
  }

  .theme-option:hover,
  .theme-option:focus-visible {
    background: var(--zen-muted);
    color: var(--zen-foreground);
  }

  /* 选中项：颜色示意，不改字重 */
  .theme-option.active {
    background: var(--zen-muted);
    color: var(--color-accent);
  }

  .theme-option.active span:first-child {
    color: var(--color-accent);
  }

  @media (prefers-reduced-motion: reduce) {
    .theme-icon {
      transition: none;
    }
    .theme-btn:hover .theme-icon {
      rotate: 0deg;
    }
  }
</style>

<script>
  // 使用 IIFE 确保封装
  (function() {
    type Theme = 'light' | 'dark' | 'system';

    const STORAGE_KEY = 'theme';
    const themes: Theme[] = ['light', 'dark', 'system'];
    const iconClasses: Record<Theme, string> = {
      light: 'icon-[lucide--sun]',
      dark: 'icon-[lucide--moon]',
      system: 'icon-[lucide--monitor]'
    };

    function getStoredTheme(): Theme {
      try {
        const stored = localStorage.getItem(STORAGE_KEY);
        if (stored && themes.includes(stored as Theme)) {
          return stored as Theme;
        }
      } catch {}
      return 'system';
    }

    function applyTheme(theme: Theme) {
      const systemDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      const isDark = theme === 'dark' || (theme === 'system' && systemDark);
      document.documentElement.classList.toggle('dark', isDark);
    }

    function updateIcon(theme: Theme) {
      const iconEl = document.querySelector('.theme-toggle .theme-icon');
      if (iconEl) {
        // 移除所有图标类
        Object.values(iconClasses).forEach(cls => {
          iconEl.classList.remove(cls);
        });
        // 添加当前图标类
        iconEl.classList.add(iconClasses[theme]);
      }

      // 更新选项激活状态
      document.querySelectorAll('.theme-option').forEach(opt => {
        const optTheme = opt.getAttribute('data-theme');
        opt.classList.toggle('active', optTheme === theme);
      });

      // 更新按钮标题
      const titles: Record<Theme, string> = {
        light: '当前：浅色模式',
        dark: '当前：深色模式',
        system: '当前：跟随系统'
      };
      const btn = document.getElementById('theme-toggle-btn');
      if (btn) {
        btn.title = titles[theme];
      }
    }

    function setTheme(theme: Theme) {
      try {
        localStorage.setItem(STORAGE_KEY, theme);
      } catch {}
      applyTheme(theme);
      updateIcon(theme);
    }

    function initThemeToggle() {
      const btn = document.getElementById('theme-toggle-btn');
      const panel = document.getElementById('theme-panel');
      const options = document.querySelectorAll('.theme-option');

      if (!btn || !panel) return;

      // 防止重复绑定
      if ((btn as any).__bound) return;
      (btn as any).__bound = true;

      // 应用当前主题
      const theme = getStoredTheme();
      applyTheme(theme);
      updateIcon(theme);

      // 点击按钮显示/隐藏面板
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const open = panel.classList.toggle('active');
        btn.setAttribute('aria-expanded', String(open));
        // 关闭配色面板
        document.getElementById('color-panel')?.classList.remove('active');
        document.getElementById('color-switch-btn')?.setAttribute('aria-expanded', 'false');
      });

      // 点击选项切换主题
      options.forEach(opt => {
        opt.addEventListener('click', (e) => {
          e.stopPropagation();
          const theme = opt.getAttribute('data-theme') as Theme;
          if (theme && themes.includes(theme)) {
            setTheme(theme);
            panel.classList.remove('active');
            btn.setAttribute('aria-expanded', 'false');
          }
        });
      });
    }

    function closePanel() {
      const btn = document.getElementById('theme-toggle-btn');
      const panel = document.getElementById('theme-panel');
      if (panel?.classList.contains('active')) {
        panel.classList.remove('active');
        btn?.setAttribute('aria-expanded', 'false');
        return true;
      }
      return false;
    }

    // 全局监听只注册一次：document click 关闭面板 + 系统主题变化监听。
    // 此前放在 initThemeToggle 里，每次 after-swap 重绑都会再加一对监听器（泄漏）。
    let globalWired = false;
    function wireGlobalOnce() {
      if (globalWired) return;
      globalWired = true;

      document.addEventListener('click', (e) => {
        const btn = document.getElementById('theme-toggle-btn');
        const panel = document.getElementById('theme-panel');
        if (!btn || !panel) return;
        if (!btn.contains(e.target as Node) && !panel.contains(e.target as Node)) {
          closePanel();
        }
      });

      // Escape 关闭并把焦点还给触发按钮
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && closePanel()) {
          document.getElementById('theme-toggle-btn')?.focus();
        }
      });

      window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
        if (getStoredTheme() === 'system') {
          applyTheme('system');
        }
      });
    }

    // 页面加载时初始化
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => { initThemeToggle(); wireGlobalOnce(); });
    } else {
      initThemeToggle();
      wireGlobalOnce();
    }

    // Astro View Transitions 支持：DOM 换掉后重绑按钮级监听（全局监听不重注册）
    document.addEventListener('astro:after-swap', () => {
      const theme = getStoredTheme();
      applyTheme(theme);
      updateIcon(theme);
      const btn = document.getElementById('theme-toggle-btn');
      if (btn) (btn as any).__bound = false;
      initThemeToggle();
    });
  })();
</script>
