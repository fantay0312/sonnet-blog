---
/**
 * 配色切换按钮 (Astro 版本)
 * 支持多种配色主题：竹青/金箔/樱粉/碧海/藤紫
 */
---

<div class="color-switch relative">
  <button
    id="color-switch-btn"
    class="color-btn p-2 hover:bg-muted rounded-xl transition-all duration-300 group"
    aria-label="切换配色"
    title="切换配色"
  >
    <span
      id="color-indicator"
      class="w-6 h-6 rounded-full block transition-all duration-300 group-hover:scale-110"
    ></span>
  </button>

  <!-- 配色选择面板 -->
  <div id="color-panel" class="color-panel absolute right-0 top-full mt-2 opacity-0 invisible translate-y-2 transition-all duration-300 z-50">
    <div class="p-2 bg-block border border-border rounded-xl shadow-lg backdrop-blur-sm">
      <div class="flex gap-2">
        <button class="color-option" data-theme="bamboo" title="竹青">
          <span class="w-7 h-7 rounded-full block" style="background: linear-gradient(135deg, #8FB89A, #5A7A63);"></span>
        </button>
        <button class="color-option" data-theme="gold" title="金箔">
          <span class="w-7 h-7 rounded-full block" style="background: linear-gradient(135deg, #E8C872, #C4A962);"></span>
        </button>
        <button class="color-option" data-theme="sakura" title="樱粉">
          <span class="w-7 h-7 rounded-full block" style="background: linear-gradient(135deg, #F0B0B0, #E8A0A0);"></span>
        </button>
        <button class="color-option" data-theme="ocean" title="碧海">
          <span class="w-7 h-7 rounded-full block" style="background: linear-gradient(135deg, #7BAFBF, #6B9DAD);"></span>
        </button>
        <button class="color-option" data-theme="lavender" title="藤紫">
          <span class="w-7 h-7 rounded-full block" style="background: linear-gradient(135deg, #AB9AB6, #9B8AA6);"></span>
        </button>
      </div>
    </div>
  </div>
</div>

<style>
  .color-btn {
    position: relative;
  }

  #color-indicator {
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15), inset 0 1px 2px rgba(255, 255, 255, 0.3);
  }

  .color-panel.active {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .color-option {
    padding: 3px;
    border-radius: 50%;
    border: 2px solid transparent;
    transition: all 0.2s ease;
    cursor: pointer;
    background: none;
  }

  .color-option:hover {
    transform: scale(1.15);
  }

  .color-option.active {
    border-color: var(--zen-foreground);
    transform: scale(1.1);
  }

  .color-option span {
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.2), inset 0 1px 2px rgba(255, 255, 255, 0.3);
  }
</style>

<script>
  // 使用 IIFE 确保只初始化一次
  (function() {
    type ColorTheme = 'bamboo' | 'gold' | 'sakura' | 'ocean' | 'lavender';

    const colorThemes: Record<ColorTheme, { name: string; light: string; dark: string }> = {
      bamboo: { name: "竹青", light: "#7B9E87", dark: "#5A7A63" },
      gold: { name: "金箔", light: "#C4A962", dark: "#D4B972" },
      sakura: { name: "樱粉", light: "#E8A0A0", dark: "#D48A8A" },
      ocean: { name: "碧海", light: "#6B9DAD", dark: "#5A8A9A" },
      lavender: { name: "藤紫", light: "#9B8AA6", dark: "#8A7A96" },
    };

    const themeKeys = Object.keys(colorThemes) as ColorTheme[];
    const STORAGE_KEY = 'colorTheme';

    // 标记是否已初始化
    const INIT_FLAG = '__colorSwitch_initialized__';

    function getStoredColorTheme(): ColorTheme {
      try {
        const stored = localStorage.getItem(STORAGE_KEY);
        return (stored && stored in colorThemes ? stored : 'bamboo') as ColorTheme;
      } catch {
        return 'bamboo';
      }
    }

    function applyColorTheme(theme: ColorTheme) {
      const colors = colorThemes[theme];
      const isDark = document.documentElement.classList.contains('dark');
      const accentColor = isDark ? colors.dark : colors.light;

      const root = document.documentElement;

      // 设置 CSS 变量
      root.style.setProperty('--zen-accent', accentColor);
      root.style.setProperty('--zen-bamboo', accentColor);
      root.style.setProperty('--color-accent', accentColor);
      root.style.setProperty('--color-bamboo', accentColor);

      // 更新选中颜色
      const r = parseInt(accentColor.slice(1, 3), 16);
      const g = parseInt(accentColor.slice(3, 5), 16);
      const b = parseInt(accentColor.slice(5, 7), 16);
      root.style.setProperty('--zen-selection', `rgba(${r}, ${g}, ${b}, 0.3)`);

      // 更新指示器颜色
      const indicator = document.getElementById('color-indicator');
      if (indicator) {
        indicator.style.background = `linear-gradient(135deg, ${colors.light}, ${colors.dark})`;
      }

      // 更新按钮 title
      const switchBtn = document.getElementById('color-switch-btn');
      if (switchBtn) {
        switchBtn.title = colors.name;
        switchBtn.setAttribute('aria-label', `当前配色：${colors.name}，点击选择`);
      }

      // 更新选项激活状态
      document.querySelectorAll('.color-option').forEach(opt => {
        const optTheme = opt.getAttribute('data-theme');
        opt.classList.toggle('active', optTheme === theme);
      });
    }

    function setColorTheme(theme: ColorTheme) {
      try {
        localStorage.setItem(STORAGE_KEY, theme);
      } catch {}
      applyColorTheme(theme);
    }

    function initColorSwitch() {
      const btn = document.getElementById('color-switch-btn');
      const panel = document.getElementById('color-panel');
      const options = document.querySelectorAll('.color-option');

      if (!btn || !panel) return;

      // 防止重复绑定事件
      if ((btn as any).__bound) return;
      (btn as any).__bound = true;

      // 应用当前主题
      const theme = getStoredColorTheme();
      applyColorTheme(theme);

      // 点击按钮显示/隐藏面板
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        panel.classList.toggle('active');
      });

      // 点击选项切换配色
      options.forEach(opt => {
        opt.addEventListener('click', (e) => {
          e.stopPropagation();
          const theme = opt.getAttribute('data-theme') as ColorTheme;
          if (theme && theme in colorThemes) {
            setColorTheme(theme);
            panel.classList.remove('active');
          }
        });
      });

      // 点击外部关闭面板
      document.addEventListener('click', (e) => {
        if (!btn.contains(e.target as Node) && !panel.contains(e.target as Node)) {
          panel.classList.remove('active');
        }
      });

      // 监听 dark 模式变化
      const observer = new MutationObserver(() => {
        applyColorTheme(getStoredColorTheme());
      });
      observer.observe(document.documentElement, {
        attributes: true,
        attributeFilter: ['class']
      });
    }

    // 页面加载时初始化
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initColorSwitch);
    } else {
      initColorSwitch();
    }

    // Astro View Transitions 支持
    document.addEventListener('astro:after-swap', () => {
      // 重新应用主题（DOM 已更新）
      setTimeout(() => {
        const theme = getStoredColorTheme();
        applyColorTheme(theme);
        // 重新绑定事件
        const btn = document.getElementById('color-switch-btn');
        if (btn) (btn as any).__bound = false;
        initColorSwitch();
      }, 0);
    });
  })();
</script>
