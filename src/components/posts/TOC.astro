---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;

// Filter to only show h2 and h3
const filteredHeadings = headings.filter((h) => h.depth >= 2 && h.depth <= 3);

// 按 h2 分组：h3 归属于前面的 h2，分栏时整组不拆开
interface Group {
  head: Heading | null;
  children: Heading[];
}

const groups: Group[] = [];
for (const h of filteredHeadings) {
  if (h.depth === 2) {
    groups.push({ head: h, children: [] });
  } else {
    if (groups.length === 0) groups.push({ head: null, children: [] });
    groups[groups.length - 1].children.push(h);
  }
}
---

<nav class="toc">
  <ol class="toc-list">
    {groups.map((group) => (
      <li class="toc-group">
        {group.head && (
          <a href={`#${group.head.slug}`} class="toc-h2">
            <span class="toc-num" aria-hidden="true"></span>
            <span class="toc-label">{group.head.text}</span>
          </a>
        )}
        {group.children.length > 0 && (
          <ul class="toc-sub">
            {group.children.map((child) => (
              <li>
                <a href={`#${child.slug}`} class="toc-h3">{child.text}</a>
              </li>
            ))}
          </ul>
        )}
      </li>
    ))}
  </ol>
</nav>

<style>
  .toc-list {
    list-style: none;
    padding: 0;
    margin: 0;
    counter-reset: toc;
  }

  @media (min-width: 768px) {
    .toc-list {
      columns: 2;
      column-gap: 3rem;
    }
  }

  /* 整组（h2 + 其 h3 子项）不被分栏拆开 */
  .toc-group {
    break-inside: avoid;
    margin-bottom: 0.125rem;
  }

  .toc-h2 {
    display: flex;
    align-items: baseline;
    gap: 0.625rem;
    padding: 0.3rem 0.5rem;
    border-radius: 6px;
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--zen-foreground);
    transition: color 0.2s ease, background-color 0.2s ease;
  }

  .toc-h2:hover {
    color: var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 8%, transparent);
  }

  .toc-h2 .toc-num {
    counter-increment: toc;
    flex-shrink: 0;
  }

  .toc-h2 .toc-num::before {
    content: counter(toc, decimal-leading-zero);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--zen-gold);
    opacity: 0.85;
  }

  .toc-label {
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }

  /* 子级：竖线缩进，跟随父级 */
  .toc-sub {
    list-style: none;
    margin: 0.125rem 0 0.375rem 1rem;
    padding-left: 0.875rem;
    border-left: 1px solid color-mix(in srgb, var(--zen-border) 80%, transparent);
  }

  .toc-h3 {
    display: block;
    padding: 0.2rem 0.5rem;
    border-radius: 6px;
    font-size: 0.8125rem;
    line-height: 1.55;
    color: var(--zen-muted-foreground);
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    transition: color 0.2s ease, background-color 0.2s ease;
  }

  .toc-h3:hover {
    color: var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 8%, transparent);
  }
</style>
