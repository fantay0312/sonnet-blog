---
/**
 * FloatingTOC - 右侧悬浮目录
 * 固定在页面右侧，跟随滚动高亮当前章节
 */
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
  title?: string;
}

const { headings, title = "目录" } = Astro.props;

// 过滤 h2 和 h3
const filteredHeadings = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
---

{filteredHeadings.length > 0 && (
  <aside class="floating-toc hidden xl:block">
    <div class="toc-wrapper">
      <h3 class="toc-title">
        <span>{title}</span>
        <span class="toc-progress" id="tocProgress">0%</span>
      </h3>
      <nav class="toc-nav">
        <ul class="toc-list">
          {filteredHeadings.map((heading) => (
            <li
              class:list={[
                "toc-item",
                heading.depth === 3 && "toc-item-h3"
              ]}
            >
              <a
                href={`#${heading.slug}`}
                class="toc-link"
                data-heading={heading.slug}
              >
                <span class="toc-indicator"></span>
                <span class="toc-text">{heading.text}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </aside>
)}

<style>
  /* 侧边栏列内 sticky 跟随滚动 */
  .floating-toc {
    position: sticky;
    top: 110px;
    align-self: start;
    max-height: calc(100vh - 150px);
    z-index: 40;
  }

  .toc-wrapper {
    padding: 16px;
    background: linear-gradient(
      150deg,
      color-mix(in srgb, var(--color-block) 50%, transparent),
      color-mix(in srgb, var(--color-block) 22%, transparent)
    );
    backdrop-filter: blur(8px);
    border: 1px solid color-mix(in srgb, var(--color-border) 50%, transparent);
    border-radius: 12px;
  }

  .toc-title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-family: "LXGW WenKai", "霞鹜文楷", "Kaiti SC", "STKaiti", "楷体", var(--font-serif);
    font-size: 0.8125rem;
    font-weight: 400;
    color: var(--color-muted-foreground);
    letter-spacing: 0.18em;
    margin-bottom: 12px;
    padding-bottom: 8px;
    border-bottom: 1px solid color-mix(in srgb, var(--color-border) 45%, transparent);
  }

  .toc-progress {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--zen-gold);
    letter-spacing: 0;
    font-variant-numeric: tabular-nums;
  }

  .toc-nav {
    position: relative;
    max-height: calc(100vh - 240px);
    overflow-y: auto;
  }

  .toc-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .toc-item {
    margin: 2px 0;
  }

  .toc-item-h3 {
    padding-left: 12px;
  }

  .toc-link {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    padding: 6px 8px;
    border-radius: 6px;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .toc-link:hover {
    background: var(--color-muted);
  }

  .toc-link.active {
    background: color-mix(in srgb, var(--color-accent) 12%, transparent);
  }

  .toc-link.active .toc-text {
    color: var(--color-accent);
    font-weight: 500;
  }

  .toc-indicator {
    flex-shrink: 0;
    width: 2px;
    height: 100%;
    min-height: 16px;
    border-radius: 2px;
    background: color-mix(in srgb, var(--color-border) 65%, transparent);
    transition: background 0.2s ease;
  }

  .toc-link.active .toc-indicator {
    background: var(--color-accent);
  }

  .toc-text {
    font-family: "LXGW WenKai", "霞鹜文楷", "Kaiti SC", "STKaiti", "楷体", var(--font-serif);
    font-size: 0.84rem;
    line-height: 1.45;
    color: var(--color-muted-foreground);
    transition: color 0.2s ease;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .toc-link:hover .toc-text {
    color: var(--color-foreground);
  }

  /* 滚动条样式 */
  .toc-nav::-webkit-scrollbar {
    width: 4px;
  }

  .toc-nav::-webkit-scrollbar-track {
    background: transparent;
  }

  .toc-nav::-webkit-scrollbar-thumb {
    background: var(--color-border);
    border-radius: 2px;
  }

</style>

<script>
  // 上一次初始化注册的监听器，View Transitions 换页时全部废弃，
  // 避免旧页面的 scroll 监听堆积、操作已脱离文档的节点
  let tocAbort: AbortController | null = null;

  function initFloatingTOC() {
    tocAbort?.abort();

    const links = Array.from(
      document.querySelectorAll('.toc-link[data-heading]')
    ) as HTMLAnchorElement[];
    if (links.length === 0) return;

    tocAbort = new AbortController();
    const { signal } = tocAbort;

    const nav = document.querySelector('.toc-nav') as HTMLElement | null;
    const progressEl = document.getElementById('tocProgress');

    const pairs = links
      .map((link) => {
        const el = document.getElementById(link.getAttribute('data-heading') || '');
        return el ? { link, el } : null;
      })
      .filter(Boolean) as { link: HTMLAnchorElement; el: HTMLElement }[];
    if (pairs.length === 0) return;

    let activeLink: HTMLElement | null = null;
    let ticking = false;
    // 点击目录后短暂锁定高亮：smooth scroll 途经的章节不再逐个闪烁
    let locked = false;
    let lockTimer = 0;

    function setActive(link: HTMLElement | null) {
      if (link === activeLink) return;
      activeLink?.classList.remove('active');
      link?.classList.add('active');
      activeLink = link;

      // 目录内自动跟随当前章节
      if (link && nav) {
        const top = link.offsetTop;
        const bottom = top + link.offsetHeight;
        if (top < nav.scrollTop + 8) {
          nav.scrollTop = top - 8;
        } else if (bottom > nav.scrollTop + nav.clientHeight - 8) {
          nav.scrollTop = bottom - nav.clientHeight + 8;
        }
      }
    }

    function currentLink(): HTMLElement | null {
      const scrollY = window.scrollY;
      const doc = document.documentElement;

      // 触底：末尾章节往往不足一屏、永远滚不到阅读线，直接点亮最后一项
      if (scrollY + window.innerHeight >= doc.scrollHeight - 4) {
        return pairs[pairs.length - 1].link;
      }

      // 阅读线：取视口上方约 1/4 处（保底 120px，覆盖吸顶导航 + scroll-margin），
      // 比"标题贴顶才算"更贴合实际正在阅读的章节
      const line = scrollY + Math.max(120, window.innerHeight * 0.25);
      let current: HTMLElement | null = null;
      for (const { link, el } of pairs) {
        if (el.getBoundingClientRect().top + scrollY <= line) {
          current = link;
        } else {
          break;
        }
      }
      return current;
    }

    function update() {
      ticking = false;

      // 阅读进度百分比
      if (progressEl) {
        const max = document.documentElement.scrollHeight - window.innerHeight;
        const pct = max > 0 ? Math.min(Math.round((window.scrollY / max) * 100), 100) : 0;
        progressEl.textContent = `${pct}%`;
      }

      if (!locked) setActive(currentLink());
    }

    function onScroll() {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    }

    function unlock() {
      locked = false;
      clearTimeout(lockTimer);
    }

    // 点击目录项：立即高亮目标，不等滚动结束
    links.forEach((link) => {
      link.addEventListener(
        'click',
        () => {
          setActive(link);
          locked = true;
          clearTimeout(lockTimer);
          lockTimer = window.setTimeout(() => {
            locked = false;
            update();
          }, 1000);
        },
        { signal }
      );
    });

    // 用户手动滚动则立即解锁，恢复跟随
    window.addEventListener('wheel', unlock, { passive: true, signal });
    window.addEventListener('touchmove', unlock, { passive: true, signal });
    window.addEventListener('scroll', onScroll, { passive: true, signal });
    window.addEventListener('resize', onScroll, { passive: true, signal });
    update();
  }

  // 初始化
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFloatingTOC);
  } else {
    initFloatingTOC();
  }
  document.addEventListener('astro:after-swap', initFloatingTOC);
</script>
