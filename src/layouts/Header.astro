---
import config from "$config";
import i18nit from "$i18n/index";
import ThemeToggle from "$components/base/ThemeToggle.astro";
import ColorSwitch from "$components/base/ColorSwitch.astro";
import LanguageSwitch from "$components/base/LanguageSwitch.astro";

const locale = Astro.currentLocale || config.i18n.defaultLocale;
const t = i18nit(locale);

const basePath = locale === config.i18n.defaultLocale ? "" : `/${locale}`;
const currentPath = Astro.url.pathname;

const navLinks = [
  { name: t("navigation.home"), path: `${basePath}/` },
  { name: t("navigation.note"), path: `${basePath}/note` },
  { name: t("navigation.jotting"), path: `${basePath}/jotting` },
  { name: t("navigation.projects"), path: `${basePath}/projects` },
  { name: t("navigation.photos"), path: `${basePath}/photos` },
  { name: t("navigation.about"), path: `${basePath}/about` },
];

const isActive = (path: string) => {
  if (path === `${basePath}/` || path === '/') {
    return currentPath === path || currentPath === `${basePath}`;
  }
  return currentPath.startsWith(path);
};
---

<header class="sticky top-0 z-50 bg-background/85 backdrop-blur-lg border-b border-border/30">
  <div class="max-w-5xl mx-auto px-6 py-4">
    <nav class="flex items-center justify-between">
      <!-- Logo / Site Title -->
      <a href={`${basePath}/`} class="logo-link font-calligraphy text-2xl relative group">
        <span class="relative z-10 transition-all duration-500 group-hover:text-accent">{config.title}</span>
      </a>

      <!-- Navigation Links - 简约水墨风格 -->
      <div class="hidden md:flex items-center">
        <nav class="nav-bar flex items-center gap-1">
          {navLinks.map((link) => (
            <a
              href={link.path}
              class:list={[
                "nav-item relative px-4 py-2 text-sm tracking-widest transition-all duration-300",
                isActive(link.path)
                  ? "nav-active"
                  : "text-secondary hover:text-foreground"
              ]}
            >
              <span class="relative z-10">{link.name}</span>
              {/* 水墨下划线 */}
              <span class="ink-line"></span>
            </a>
          ))}
        </nav>
      </div>

      <!-- Actions -->
      <div class="flex items-center gap-1">
        <ColorSwitch />
        <ThemeToggle />
        <LanguageSwitch />

        <!-- Mobile Menu Button -->
        <button
          id="mobile-menu-btn"
          class="md:hidden p-2 hover:bg-muted rounded-lg transition-colors ml-1"
          aria-label="Toggle menu"
        >
          <span class="icon-[lucide--menu] w-5 h-5"></span>
        </button>
      </div>
    </nav>

    <!-- Mobile Navigation -->
    <div id="mobile-menu" class="hidden md:hidden mt-4 pb-2 pt-4 border-t border-border/30">
      <div class="flex flex-col gap-1">
        {navLinks.map((link, index) => (
          <a
            href={link.path}
            class:list={[
              "mobile-nav-link relative py-3 px-4 transition-all duration-300 tracking-wider",
              isActive(link.path)
                ? "text-accent font-medium"
                : "text-secondary hover:text-foreground"
            ]}
            style={`animation-delay: ${index * 50}ms`}
          >
            <span class="relative z-10 flex items-center gap-3">
              {isActive(link.path) && (
                <span class="w-1.5 h-1.5 rounded-full bg-accent"></span>
              )}
              <span>{link.name}</span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </div>
</header>

<style>
  /* 导航项 */
  .nav-item {
    position: relative;
    font-weight: 400;
  }

  /* 激活状态 */
  .nav-active {
    color: var(--zen-accent);
    font-weight: 500;
  }

  /* 水墨下划线 */
  .ink-line {
    position: absolute;
    bottom: 6px;
    left: 50%;
    width: 0;
    height: 2px;
    background: var(--zen-accent);
    transform: translateX(-50%);
    transition: width 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    border-radius: 1px;
  }

  /* 激活态下划线 */
  .nav-active .ink-line {
    width: 60%;
    background: linear-gradient(90deg, transparent, var(--zen-accent), transparent);
  }

  /* 悬浮下划线 */
  .nav-item:not(.nav-active):hover .ink-line {
    width: 40%;
    background: linear-gradient(90deg, transparent, var(--zen-secondary), transparent);
  }

  /* 悬浮微动 */
  .nav-item:not(.nav-active):hover {
    transform: translateY(-1px);
  }

  /* 移动端导航项 */
  .mobile-nav-link {
    position: relative;
    border-radius: 8px;
  }

  .mobile-nav-link:not([class*="text-accent"]):hover {
    background: var(--zen-muted);
    padding-left: 1.5rem;
  }

  /* 深色模式 */
  :global(.dark) header {
    background: rgba(14, 14, 12, 0.85);
  }
</style>

<script>
  function initHeader() {
    const btn = document.getElementById("mobile-menu-btn");
    const menu = document.getElementById("mobile-menu");

    if ((btn as any)?.__headerBound) return;
    if (btn) (btn as any).__headerBound = true;

    btn?.addEventListener("click", () => {
      menu?.classList.toggle("hidden");
    });

    menu?.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => {
        menu?.classList.add("hidden");
      });
    });
  }

  initHeader();
  document.addEventListener("astro:after-swap", () => {
    const btn = document.getElementById("mobile-menu-btn");
    if (btn) (btn as any).__headerBound = false;
    initHeader();
  });
</script>
