---
import config from "$config";
import i18nit from "$i18n/index";
import ThemeToggle from "$components/base/ThemeToggle";
import ColorSwitch from "$components/base/ColorSwitch";
import LanguageSwitch from "$components/base/LanguageSwitch.astro";

const locale = Astro.currentLocale || config.i18n.defaultLocale;
const t = i18nit(locale);

const basePath = locale === config.i18n.defaultLocale ? "" : `/${locale}`;
const currentPath = Astro.url.pathname;

const navLinks = [
  { name: t("navigation.home"), path: `${basePath}/` },
  { name: t("navigation.note"), path: `${basePath}/note` },
  { name: t("navigation.jotting"), path: `${basePath}/jotting` },
  { name: t("navigation.projects"), path: `${basePath}/projects` },
  { name: t("navigation.photos"), path: `${basePath}/photos` },
  { name: t("navigation.about"), path: `${basePath}/about` },
];

const isActive = (path: string) => {
  if (path === `${basePath}/` || path === '/') {
    return currentPath === path || currentPath === `${basePath}`;
  }
  return currentPath.startsWith(path);
};
---

<header class="sticky top-0 z-50 bg-background/80 backdrop-blur-sm border-b border-border">
  <div class="max-w-4xl mx-auto px-4 py-4">
    <nav class="flex items-center justify-between">
      <!-- Logo / Site Title -->
      <a href={`${basePath}/`} class="logo-link font-calligraphy text-2xl relative group">
        <span class="relative z-10 transition-colors duration-300 group-hover:text-accent">{config.title}</span>
        <!-- 墨迹光晕 -->
        <span class="absolute -inset-2 bg-accent/10 rounded-full blur-lg opacity-0 group-hover:opacity-100 transition-opacity duration-500"></span>
      </a>

      <!-- Navigation Links -->
      <div class="hidden md:flex items-center gap-1">
        {navLinks.map((link) => (
          <a
            href={link.path}
            class:list={[
              "nav-link relative px-4 py-2 category-name transition-all duration-300",
              isActive(link.path) ? "text-foreground" : "text-secondary hover:text-foreground"
            ]}
          >
            <span class="relative z-10">{link.name}</span>
            <!-- 水墨笔触下划线 -->
            <span class:list={[
              "ink-stroke absolute bottom-1 left-1/2 -translate-x-1/2 h-0.5 bg-accent/70 transition-all duration-500 ease-out",
              isActive(link.path) ? "w-3/4" : "w-0"
            ]}></span>
            <!-- 悬浮时的墨点 -->
            <span class="ink-dot absolute -bottom-0.5 left-1/2 -translate-x-1/2 w-1 h-1 rounded-full bg-accent opacity-0 scale-0 transition-all duration-300"></span>
          </a>
        ))}
      </div>

      <!-- Actions -->
      <div class="flex items-center gap-2">
        <ColorSwitch client:load />
        <ThemeToggle client:load />
        <LanguageSwitch />

        <!-- Mobile Menu Button -->
        <button
          id="mobile-menu-btn"
          class="md:hidden p-2 hover:bg-muted rounded-lg transition-colors"
          aria-label="Toggle menu"
        >
          <span class="icon-[lucide--menu] w-5 h-5"></span>
        </button>
      </div>
    </nav>

    <!-- Mobile Navigation -->
    <div id="mobile-menu" class="hidden md:hidden mt-4 pb-4 border-t border-border pt-4">
      <div class="flex flex-col gap-1">
        {navLinks.map((link) => (
          <a
            href={link.path}
            class:list={[
              "mobile-nav-link relative category-name py-3 px-4 rounded-lg transition-all duration-300",
              isActive(link.path)
                ? "text-foreground bg-muted/50"
                : "text-secondary hover:text-foreground hover:bg-muted/30"
            ]}
          >
            <span class="relative z-10 flex items-center gap-3">
              {isActive(link.path) && (
                <span class="w-1.5 h-1.5 rounded-full bg-accent animate-pulse"></span>
              )}
              {link.name}
            </span>
          </a>
        ))}
      </div>
    </div>
  </div>
</header>

<style>
  /* 导航链接悬浮效果 */
  .nav-link:hover .ink-stroke {
    width: 80%;
  }

  .nav-link:hover .ink-dot {
    opacity: 1;
    transform: translateX(-50%) scale(1);
    animation: ink-ripple 0.6s ease-out;
  }

  @keyframes ink-ripple {
    0% {
      transform: translateX(-50%) scale(0);
      opacity: 0;
    }
    50% {
      transform: translateX(-50%) scale(1.5);
      opacity: 1;
    }
    100% {
      transform: translateX(-50%) scale(1);
      opacity: 1;
    }
  }

  /* 水墨笔触效果 - 不规则边缘 */
  .ink-stroke {
    border-radius: 1px;
    background: linear-gradient(
      90deg,
      transparent 0%,
      var(--color-accent) 15%,
      var(--color-accent) 85%,
      transparent 100%
    );
    mask-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 100 10' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M0,5 Q10,2 20,5 T40,4 T60,6 T80,4 T100,5' stroke='black' fill='none' stroke-width='8'/%3E%3C/svg%3E");
    mask-size: 100% 100%;
  }

  /* Logo 悬浮墨迹扩散 */
  .logo-link::before {
    content: '';
    position: absolute;
    inset: -4px;
    background: radial-gradient(circle at center, var(--color-accent)/20 0%, transparent 70%);
    border-radius: 50%;
    opacity: 0;
    transform: scale(0.8);
    transition: all 0.5s ease;
  }

  .logo-link:hover::before {
    opacity: 1;
    transform: scale(1);
  }

  /* 移动端导航项动画 */
  .mobile-nav-link {
    position: relative;
    overflow: hidden;
  }

  .mobile-nav-link::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    width: 3px;
    height: 0;
    background: var(--color-accent);
    border-radius: 0 2px 2px 0;
    transform: translateY(-50%);
    transition: height 0.3s ease;
  }

  .mobile-nav-link:hover::before,
  .mobile-nav-link[class*="bg-muted"]::before {
    height: 60%;
  }
</style>

<script>
  const btn = document.getElementById("mobile-menu-btn");
  const menu = document.getElementById("mobile-menu");

  btn?.addEventListener("click", () => {
    menu?.classList.toggle("hidden");
  });

  // 点击链接时关闭移动端菜单
  menu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      menu?.classList.add("hidden");
    });
  });
</script>
