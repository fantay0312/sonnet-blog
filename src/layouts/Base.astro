---
// 字体全部自托管：打包进本站 _astro/ 目录，从自己的服务器（国内）下发。
// 之前 Noto 走 loli.net 第三方镜像、霞鹜文楷和 JetBrains Mono 根本没引入
// （全靠访客本机装没装，这就是桌面端和手机端字体不一致的根源）。
// 各 CSS 按 unicode-range 切片，浏览器只下载页面用到的字符分片。
import "@fontsource/noto-sans-sc/400.css";
import "@fontsource/noto-sans-sc/500.css";
import "@fontsource/noto-sans-sc/700.css";
import "@fontsource/noto-serif-sc/400.css";
import "@fontsource/noto-serif-sc/600.css";
import "@fontsource/noto-serif-sc/700.css";
import "@fontsource/ma-shan-zheng/index.css";
import "@fontsource/jetbrains-mono/400.css";
import "@fontsource/jetbrains-mono/500.css";
import "lxgw-wenkai-webfont/lxgwwenkai-regular.css";
// KaTeX 样式同样本地打包，替代国内不稳的 jsdelivr CDN
import "katex/dist/katex.min.css";
import "$styles/global.css";
import { ViewTransitions } from "astro:transitions";
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import ZenEffects from "$components/base/ZenEffects.astro";
import config from "$config";

interface Props {
  title?: string;
  description?: string;
}

const { title, description } = Astro.props;
const pageTitle = title ? `${title} | ${config.title}` : config.title;
const pageDescription = description || config.description;
const locale = Astro.currentLocale || config.i18n.defaultLocale;
---

<!doctype html>
<html lang={locale} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={pageDescription} />
    <title>{pageTitle}</title>

    <!-- View Transitions - 水墨过渡效果 -->
    <ViewTransitions />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- RSS Feed -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title={config.title}
      href={`/${locale === config.i18n.defaultLocale ? "" : locale + "/"}feed.xml`}
    />

    <!-- Theme & Color Script -->
    <script is:inline>
      // Dark/Light mode
      const theme = localStorage.getItem("theme") || "system";
      const systemDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
      const isDark = theme === "dark" || (theme === "system" && systemDark);
      document.documentElement.classList.toggle("dark", isDark);

      // Color theme
      const colorThemes = {
        bamboo: { light: "#7B9E87", dark: "#5A7A63" },
        gold: { light: "#C4A962", dark: "#D4B972" },
        sakura: { light: "#E8A0A0", dark: "#D48A8A" },
        ocean: { light: "#6B9DAD", dark: "#5A8A9A" },
        lavender: { light: "#9B8AA6", dark: "#8A7A96" },
      };
      const colorTheme = localStorage.getItem("colorTheme") || "bamboo";
      const colors = colorThemes[colorTheme] || colorThemes.bamboo;
      const accentColor = isDark ? colors.dark : colors.light;
      const root = document.documentElement;
      root.style.setProperty("--zen-accent", accentColor);
      root.style.setProperty("--zen-bamboo", accentColor);
      root.style.setProperty("--color-accent", accentColor);
      root.style.setProperty("--color-bamboo", accentColor);
      // Selection color
      const r = parseInt(accentColor.slice(1, 3), 16);
      const g = parseInt(accentColor.slice(3, 5), 16);
      const b = parseInt(accentColor.slice(5, 7), 16);
      root.style.setProperty("--zen-selection", `rgba(${r}, ${g}, ${b}, 0.3)`);

      // 主题切换瞬间才启用全局颜色过渡（配合 global.css 的 html.theme-anim 规则）
      let prevDark = isDark;
      let themeAnimTimer;
      new MutationObserver(() => {
        const nowDark = root.classList.contains("dark");
        if (nowDark !== prevDark) {
          prevDark = nowDark;
          root.classList.add("theme-anim");
          clearTimeout(themeAnimTimer);
          themeAnimTimer = setTimeout(() => root.classList.remove("theme-anim"), 400);
        }
      }).observe(root, { attributes: true, attributeFilter: ["class"] });
    </script>
  </head>
  <body class="min-h-screen flex flex-col bg-background text-foreground relative">
    <!-- 禅意背景特效（内部元素 transition:persist，跨页面导航持续运行） -->
    <ZenEffects />

    <Header />
    <main class="flex-1 relative z-10">
      <slot />
    </main>
    <Footer />
  </body>
</html>
